-- ====================================================================
-- 3. MOTOR6D TRANSFORM ENGINE (Zero C0 Distortion)
-- ====================================================================
local JointCache = {
    RootJoint = nil,
    Neck = nil,
    RightShoulder = nil,
    LeftShoulder = nil,
    RightHip = nil,
    LeftHip = nil
}

local procAnimConnection = nil
local rotorAngle = 0
local tailRotorAngle = 0
local rabbitHopTimer = 0

local activeTail = nil

local function cleanupVisualProps()
    if activeTail then
        pcall(function() activeTail:Destroy() end)
        activeTail = nil
    end
end

local function cacheJoints(character)
    for k in pairs(JointCache) do
        JointCache[k] = nil
    end
    if not character then return end

    character:WaitForChild("HumanoidRootPart", 5)
    character:WaitForChild("Humanoid", 5)

    local waited = 0
    while waited < 2 do
        local count = 0
        for _, desc in ipairs(character:GetDescendants()) do
            if desc:IsA("Motor6D") then count = count + 1 end
        end
        if count >= 4 then break end
        task.wait(0.1)
        waited = waited + 0.1
    end

    for _, desc in ipairs(character:GetDescendants()) do
        if desc:IsA("Motor6D") then
            local name = desc.Name:lower():gsub("%s+", "")
            if name:find("root") then
                JointCache.RootJoint = desc
            elseif name:find("neck") then
                JointCache.Neck = desc
            elseif name:find("right") and (name:find("shoulder") or name:find("arm")) then
                JointCache.RightShoulder = desc
            elseif name:find("left") and (name:find("shoulder") or name:find("arm")) then
                JointCache.LeftShoulder = desc
            elseif name:find("right") and (name:find("hip") or name:find("leg")) then
                JointCache.RightHip = desc
            elseif name:find("left") and (name:find("hip") or name:find("leg")) then
                JointCache.LeftHip = desc
            end
        end
    end
end

local function resetTransforms()
    for _, joint in pairs(JointCache) do
        if joint and joint.Parent then
            pcall(function()
                joint.Transform = CFrame.identity
            end)
        end
    end
end

-- ====================================================================
-- 4. PROCEDURAL ANIMATION LOOP (Stepped / Pure Transform)
-- ====================================================================
local function startProceduralEngine(character)
    if procAnimConnection then
        procAnimConnection:Disconnect()
        procAnimConnection = nil
    end

    if not character then return end
    local humanoid = character:WaitForChild("Humanoid", 5)
    local hrp = character:WaitForChild("HumanoidRootPart", 5)
    if not humanoid or not hrp then return end

    cacheJoints(character)

    local animate = character:FindFirstChild("Animate")
    if animate then
        animate.Enabled = (currentAnimMode == "None")
    end

    local animator = humanoid:FindFirstChildOfClass("Animator")
    if animator and currentAnimMode ~= "None" then
        for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
            track:Stop(0)
        end
    end

    procAnimConnection = RunService.Stepped:Connect(function(timeArg, deltaArg)
        if isTerminated or not character or not character.Parent or not humanoid or not humanoid.Parent or humanoid.Health <= 0 then
            return
        end

        local globalTime = (typeof(timeArg) == "number" and timeArg) or os.clock()
        local deltaTime = (typeof(deltaArg) == "number" and deltaArg) or 0.016

        local isMoving = false
        pcall(function() isMoving = humanoid.MoveDirection.Magnitude > 0.05 end)
        local speed = 16
        pcall(function() speed = humanoid.WalkSpeed end)

        local root = JointCache.RootJoint
        local neck = JointCache.Neck
        local rShoulder = JointCache.RightShoulder
        local lShoulder = JointCache.LeftShoulder
        local rHip = JointCache.RightHip
        local lHip = JointCache.LeftHip

        -- -------------------------------------------------------------
        -- 1. HELIKOPTERI (Täysin koossa pysyvä runko ja kaksoislaparoottori)
        -- -------------------------------------------------------------
        if currentAnimMode == "Helicopter" then
            local spinMult = (isFlying and 65) or (isMoving and 50) or 26
            rotorAngle = (rotorAngle + deltaTime * spinMult) % (math.pi * 2)
            tailRotorAngle = (tailRotorAngle + deltaTime * spinMult * 1.6) % (math.pi * 2)

            -- Runko vaakatasoon ilman siirtymävääristymää
            if root then
                root.Transform = CFrame.Angles(math.rad(85), 0, 0)
            end
            -- Pää etuohjaamoksi
            if neck then
                neck.Transform = CFrame.Angles(math.rad(-75), 0, 0)
            end
            -- Molemmat kädet muodostavat suoraan selän päällä pyörivän 2-lapaisen pääpotkurin
            if rShoulder then
                rShoulder.Transform = CFrame.Angles(0, rotorAngle, math.rad(90))
            end
            if lShoulder then
                lShoulder.Transform = CFrame.Angles(0, rotorAngle + math.pi, math.rad(-90))
            end
            -- Oikea jalka taakse puomiksi
            if rHip then
                rHip.Transform = CFrame.Angles(math.rad(-80), 0, 0)
            end
            -- Vasen jalka pyörii pystyakselilla peräroottorina
            if lHip then
                lHip.Transform = CFrame.Angles(math.rad(-80), tailRotorAngle, 0)
            end

        -- -------------------------------------------------------------
        -- 2. KOIRA (Aito nelinkontin ravisykli & heiluva häntä)
        -- -------------------------------------------------------------
        elseif currentAnimMode == "Dog" then
            local trotT = globalTime * (speed * 0.75)
            local diag1 = math.sin(trotT) * 0.6
            local diag2 = -diag1

            if root then
                root.Transform = CFrame.Angles(math.rad(65), 0, 0)
            end
            if neck then
                neck.Transform = CFrame.Angles(math.rad(-60), 0, 0)
            end

            if isMoving then
                -- Vastakkaisparien ravikäynti
                if rShoulder then rShoulder.Transform = CFrame.Angles(math.rad(-70) + diag1, 0, 0) end
                if lShoulder then lShoulder.Transform = CFrame.Angles(math.rad(-70) + diag2, 0, 0) end
                if rHip then rHip.Transform = CFrame.Angles(math.rad(45) + diag2, 0, 0) end
                if lHip then lHip.Transform = CFrame.Angles(math.rad(45) + diag1, 0, 0) end
            else
                local pant = math.sin(globalTime * 6) * 0.04
                if rShoulder then rShoulder.Transform = CFrame.Angles(math.rad(-70) + pant, 0, 0) end
                if lShoulder then lShoulder.Transform = CFrame.Angles(math.rad(-70) + pant, 0, 0) end
                if rHip then rHip.Transform = CFrame.Angles(math.rad(45) + pant, 0, 0) end
                if lHip then lHip.Transform = CFrame.Angles(math.rad(45) + pant, 0, 0) end
            end

            if activeTail and activeTail:FindFirstChild("TailWeld") then
                local wagSpeed = isMoving and 20 or 12
                activeTail.TailWeld.C0 = CFrame.new(0, 0.6, 1) * CFrame.Angles(math.rad(45), math.sin(globalTime * wagSpeed) * math.rad(35), 0)
            end

        -- -------------------------------------------------------------
        -- 3. PUPU (Joustava aito loikkimissykli)
        -- -------------------------------------------------------------
        elseif currentAnimMode == "Rabbit" then
            if isMoving then
                rabbitHopTimer = (rabbitHopTimer + deltaTime * (speed * 0.75)) % (math.pi * 2)
                local hopArc = math.abs(math.sin(rabbitHopTimer))
                local hopPitch = math.sin(rabbitHopTimer) * math.rad(22)
                local hopKick = math.sin(rabbitHopTimer) * 0.8

                if root then
                    root.Transform = CFrame.new(0, hopArc * 0.7, 0) * CFrame.Angles(math.rad(25) + hopPitch, 0, 0)
                end
                if neck then
                    neck.Transform = CFrame.Angles(math.rad(-20) - hopPitch * 0.5, 0, 0)
                end
                if rShoulder then
                    rShoulder.Transform = CFrame.Angles(math.rad(50) - hopPitch, 0, math.rad(-15))
                end
                if lShoulder then
                    lShoulder.Transform = CFrame.Angles(math.rad(50) - hopPitch, 0, math.rad(15))
                end
                if rHip then
                    rHip.Transform = CFrame.Angles(math.rad(-20) + hopKick, 0, 0)
                end
                if lHip then
                    lHip.Transform = CFrame.Angles(math.rad(-20) + hopKick, 0, 0)
                end
            else
                local breath = math.sin(globalTime * 6) * 0.05
                local noseTwitch = math.sin(globalTime * 16) * 0.05
                if root then
                    root.Transform = CFrame.Angles(math.rad(20) + breath, 0, 0)
                end
                if neck then
                    neck.Transform = CFrame.Angles(math.rad(-15), noseTwitch, 0)
                end
                if rShoulder then
                    rShoulder.Transform = CFrame.Angles(math.rad(55), 0, math.rad(-20))
                end
                if lShoulder then
                    lShoulder.Transform = CFrame.Angles(math.rad(55), 0, math.rad(20))
                end
                if rHip then
                    rHip.Transform = CFrame.Angles(math.rad(-30), 0, 0)
                end
                if lHip then
                    lHip.Transform = CFrame.Angles(math.rad(-30), 0, 0)
                end
            end

        -- -------------------------------------------------------------
        -- 4. RAPU (CRAB - Leveä asento & napsuvat sakset)
        -- -------------------------------------------------------------
        elseif currentAnimMode == "Crab" then
            local clawSnap = math.sin(globalTime * 12) * 0.25
            local scuttle = math.sin(globalTime * (speed * 0.8)) * 0.4

            if root then
                root.Transform = CFrame.Angles(math.rad(10), 0, 0)
            end
            if neck then
                neck.Transform = CFrame.Angles(math.rad(-5), math.sin(globalTime * 4) * 0.1, 0)
            end
            -- Molemmat kädet nostettu korkealle napsuviksi saksiksi
            if rShoulder then
                rShoulder.Transform = CFrame.Angles(math.rad(70) + clawSnap, 0, math.rad(-65))
            end
            if lShoulder then
                lShoulder.Transform = CFrame.Angles(math.rad(70) + clawSnap, 0, math.rad(65))
            end
            -- Leveät sivuaskeltavat jalat
            if rHip then
                rHip.Transform = CFrame.Angles(scuttle, 0, math.rad(28))
            end
            if lHip then
                lHip.Transform = CFrame.Angles(-scuttle, 0, math.rad(-28))
            end

        -- -------------------------------------------------------------
        -- 5. PSYCHO MONSTER (Elokuvamainen aito kauhuanimaatio)
        -- -------------------------------------------------------------
        elseif currentAnimMode == "Psycho" then
            if isFlying then
                if neck then neck.Transform = CFrame.Angles(math.rad(30), math.sin(globalTime * 18) * 0.15, 0) end
                if rShoulder then rShoulder.Transform = CFrame.Angles(math.rad(155), 0, math.rad(25)) end
                if lShoulder then lShoulder.Transform = CFrame.Angles(math.rad(145), 0, math.rad(-25)) end
            elseif isMoving then
                if speed > 18 then
                    -- Feral Predator Sprint (45 asteen ryntäys kynnet ojossa)
                    local runT = globalTime * (speed * 0.85)
                    local stride = math.sin(runT) * 1.1

                    if root then root.Transform = CFrame.Angles(math.rad(42), 0, math.sin(runT) * 0.08) end
                    if neck then neck.Transform = CFrame.Angles(math.rad(-32), math.sin(globalTime * 22) * 0.18, 0) end
                    if rShoulder then rShoulder.Transform = CFrame.Angles(math.rad(85) + math.sin(runT) * 0.35, 0, math.rad(-25)) end
                    if lShoulder then lShoulder.Transform = CFrame.Angles(math.rad(80) - math.sin(runT) * 0.35, 0, math.rad(25)) end
                    if rHip then rHip.Transform = CFrame.Angles(stride, 0, 0) end
                    if lHip then lHip.Transform = CFrame.Angles(-stride, 0, 0) end
                else
                    -- Heavy Agonized Stomp & Limp (Tuskainen epäsymmetrinen ontuminen)
                    local walkT = globalTime * 6.5
                    local step = math.sin(walkT)

                    if root then root.Transform = CFrame.Angles(math.rad(14), step * 0.1, step * 0.08) end
                    if neck then neck.Transform = CFrame.Angles(math.rad(22), math.rad(-22) + math.sin(globalTime * 16) * 0.1, math.rad(-15)) end
                    -- Oikea käsi nytkähtelee askeleella, vasen roikkuu velttona
                    if rShoulder then rShoulder.Transform = CFrame.Angles(math.sin(walkT) * 0.5 + math.sin(globalTime * 22) * 0.15, 0, math.rad(18)) end
                    if lShoulder then lShoulder.Transform = CFrame.Angles(-math.sin(walkT) * 0.3, 0, math.rad(-10)) end
                    -- Toinen jalka tekee raskaan tömähdyksen, toinen raahautuu
                    if rHip then rHip.Transform = CFrame.Angles(step * 0.8, 0, 0) end
                    if lHip then lHip.Transform = CFrame.Angles(-step * 0.45, 0, 0) end
                end
            else
                -- Eerie Horror Idle (Luonnoton pään asento & äkilliset nytkähdykset)
                local twitchCycle = math.sin(globalTime * 2.5)
                local suddenSnap = (twitchCycle > 0.92 and math.sin(globalTime * 32) * 0.2 or 0)
                local handTremor = math.sin(globalTime * 24) * 0.06

                if root then root.Transform = CFrame.Angles(math.rad(6), math.sin(globalTime * 2) * 0.04, math.rad(-4)) end
                if neck then neck.Transform = CFrame.Angles(math.rad(24) + suddenSnap, math.rad(28) + suddenSnap, math.rad(-22)) end
                if rShoulder then rShoulder.Transform = CFrame.Angles(math.rad(42) + handTremor, 0, math.rad(24) + suddenSnap) end
                if lShoulder then lShoulder.Transform = CFrame.Angles(math.rad(-6), 0, math.rad(-8)) end
                if rHip then rHip.Transform = CFrame.Angles(math.rad(-2), 0, math.rad(3)) end
                if lHip then lHip.Transform = CFrame.Angles(math.rad(2), 0, math.rad(-3)) end
            end
        end
    end)
end

local function setAnimationMode(newMode)
    currentAnimMode = newMode
    resetTransforms()
    cleanupVisualProps()

    local char = LocalPlayer.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    local torso = char and (char:FindFirstChild("Torso") or char:FindFirstChild("LowerTorso"))

    if hum then
        if newMode == "Dog" then
            hum.HipHeight = 0.8
            if torso then
                activeTail = Instance.new("Part")
                activeTail.Name = "DogTail"
                activeTail.Size = Vector3.new(0.3, 0.3, 1.3)
                activeTail.Color = torso.Color
                activeTail.CanCollide = false
                activeTail.Massless = true
                activeTail.Parent = char

                local weld = Instance.new("Motor6D")
                weld.Name = "TailWeld"
                weld.Part0 = torso
                weld.Part1 = activeTail
                weld.C0 = CFrame.new(0, 0.6, 1) * CFrame.Angles(math.rad(45), 0, 0)
                weld.Parent = activeTail
            end
        elseif newMode == "Rabbit" then
            hum.HipHeight = 1.0
        elseif newMode == "Crab" then
            hum.HipHeight = 1.0
        elseif newMode == "Helicopter" then
            hum.HipHeight = 2.4
        else
            hum.HipHeight = 2.0
        end
    end

    if char then
        local animate = char:FindFirstChild("Animate")
        if animate then
            animate.Enabled = (newMode == "None")
        end
    end
end

-- ====================================================================
-- 5. FLY SUBSYSTEM (Infinite Yield Pure Model)
-- ====================================================================
local function startFlying(character)
    if isFlying then return end
    local hrp = character and character:FindFirstChild("HumanoidRootPart")
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    if not hrp or not humanoid then return end

    isFlying = true

    for _, obj in ipairs(hrp:GetChildren()) do
        if obj:IsA("BodyVelocity") or obj:IsA("BodyGyro") then
            obj:Destroy()
        end
    end

    flyBV = Instance.new("BodyVelocity")
    flyBV.Name = "FlightVelocity"
    flyBV.Velocity = Vector3.zero
    flyBV.MaxForce = Vector3.new(9e9, 9e9, 9e9)
    flyBV.Parent = hrp

    flyBG = Instance.new("BodyGyro")
    flyBG.Name = "FlightGyro"
    flyBG.P = 9e4
    flyBG.MaxTorque = Vector3.new(9e9, 9e9, 9e9)
    flyBG.CFrame = hrp.CFrame
    flyBG.Parent = hrp

    flyRenderConn = RunService.RenderStepped:Connect(function()
        if not isFlying or not hrp or not hrp.Parent or not humanoid or humanoid.Health <= 0 then
            return
        end

        local speed = flySpeeds[flySpeedIndex]
        local cam = getCamera()
        local camCF = cam and cam.CFrame or CFrame.identity
        local moveDir = humanoid.MoveDirection
        local moveVelocity = Vector3.zero

        if moveDir.Magnitude > 0.05 then
            local flatLook = Vector3.new(camCF.LookVector.X, 0, camCF.LookVector.Z)
            if flatLook.Magnitude > 0.001 then
                flatLook = flatLook.Unit
            else
                flatLook = Vector3.new(0, 0, -1)
            end
            local flatRight = Vector3.new(camCF.RightVector.X, 0, camCF.RightVector.Z).Unit
            moveVelocity = (camCF.LookVector * moveDir:Dot(flatLook) + camCF.RightVector * moveDir:Dot(flatRight)).Unit * speed
        end

        local vert = 0
        if UserInputService:IsKeyDown(Enum.KeyCode.Space) or humanoid.Jump then
            vert = vert + speed
        end
        if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) or UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then
            vert = vert - speed
        end

        flyBV.Velocity = moveVelocity + Vector3.new(0, vert, 0)
        flyBG.CFrame = camCF
    end)
end

local function stopFlying(character)
    isFlying = false
    if flyRenderConn then
        flyRenderConn:Disconnect()
        flyRenderConn = nil
    end

    local hrp = character and character:FindFirstChild("HumanoidRootPart")
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")

    if hrp then
        for _, obj in ipairs(hrp:GetChildren()) do
            if obj:IsA("BodyVelocity") or obj:IsA("BodyGyro") then
                obj:Destroy()
            end
        end
        hrp.AssemblyLinearVelocity = Vector3.new(0, -2, 0)
        hrp.AssemblyAngularVelocity = Vector3.zero
    end

    if humanoid then
        humanoid.PlatformStand = false
        humanoid.AutoRotate = true
        humanoid:ChangeState(Enum.HumanoidStateType.Freefall)
    end
end

-- ====================================================================
-- 6. TOUCH FLING SUBSYSTEM (Single-Thread Velocity Pulse Method)
-- ====================================================================
local function startFling(character)
    if isFlinging then return end
    local hrp = character and character:FindFirstChild("HumanoidRootPart")
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    if not hrp or not humanoid then return end

    isFlinging = true
    humanoid:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, false)
    humanoid:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)

    flingThread = task.spawn(function()
        while isFlinging do
            RunService.Heartbeat:Wait()
            if not isFlinging then break end

            local currentChar = LocalPlayer.Character
            local root = currentChar and currentChar:FindFirstChild("HumanoidRootPart")
            local hum = currentChar and currentChar:FindFirstChildOfClass("Humanoid")
            if root and root.Parent and hum and hum.Health > 0 then
                local originalVel = root.AssemblyLinearVelocity
                root.AssemblyLinearVelocity = originalVel * 10000 + Vector3.new(0, 10000, 0)
                RunService.RenderStepped:Wait()
                if root and root.Parent then
                    root.AssemblyLinearVelocity = originalVel
                end
            end
        end
    end)
end

local function stopFling(character)
    isFlinging = false
    if flingThread then
        task.cancel(flingThread)
        flingThread = nil
    end
    local hrp = character and character:FindFirstChild("HumanoidRootPart")
    if hrp then
        hrp.AssemblyLinearVelocity = Vector3.zero
        hrp.AssemblyAngularVelocity = Vector3.zero
    end
end

-- ====================================================================
-- 7. NOCLIP SUBSYSTEM
-- ====================================================================
local function startNoclip(character)
    if isNoclipping then return end
    isNoclipping = true
    noclipConn = RunService.Stepped:Connect(function()
        if not isNoclipping or not character or not character.Parent then return end
        for _, part in ipairs(character:GetDescendants()) do
            if part:IsA("BasePart") and part.CanCollide then
                part.CanCollide = false
            end
        end
    end)
end

local function stopNoclip(character)
    isNoclipping = false
    if noclipConn then
        noclipConn:Disconnect()
        noclipConn = nil
    end
    if character and character.Parent then
        for _, part in ipairs(character:GetDescendants()) do
            if part:IsA("BasePart") and (part.Name == "HumanoidRootPart" or part.Name:find("Torso") or part.Name == "Head") then
                part.CanCollide = true
            end
        end
    end
end

-- ====================================================================
-- 8. INVISIBLE (DESYNC) SUBSYSTEM
-- ====================================================================
local function getRootJointForInvis(character)
    if not character then return nil, nil end
    local hrp = character:FindFirstChild("HumanoidRootPart")
    local lowerTorso = character:FindFirstChild("LowerTorso")
    local torso = character:FindFirstChild("Torso")
    local mainTorso = lowerTorso or torso

    if not hrp or not mainTorso then return nil, nil end

    local joint = hrp:FindFirstChild("RootJoint")
        or (lowerTorso and lowerTorso:FindFirstChild("Root"))
        or hrp:FindFirstChild("Root")
        or (torso and torso:FindFirstChild("RootJoint"))

    if not joint then
        for _, desc in ipairs(character:GetDescendants()) do
            if desc:IsA("Motor6D") and (desc.Part0 == hrp or desc.Part1 == hrp) then
                joint = desc
                break
            end
        end
    end
    return joint, mainTorso
end

local function startInvisible(character)
    if isInvisible then return end
    local joint, mainTorso = getRootJointForInvis(character)
    if not joint or not mainTorso then
        notify("Invisible", "RootJoint missing.")
        return
    end

    isInvisible = true
    savedRootJoint = joint
    savedTorso = mainTorso

    mainTorso.Anchored = true
    savedRootJoint.Enabled = false

    for _, part in ipairs(character:GetDescendants()) do
        if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then
            part.Transparency = 0.5
        end
    end
end

local function stopInvisible(character)
    isInvisible = false

    if savedTorso and savedTorso.Parent then
        savedTorso.Anchored = false
        local hrp = character and character:FindFirstChild("HumanoidRootPart")
        if hrp then
            savedTorso.CFrame = hrp.CFrame
        end
    end

    if savedRootJoint and savedRootJoint.Parent then
        savedRootJoint.Enabled = true
    end

    local targetChar = character or (savedTorso and savedTorso.Parent)
    if targetChar then
        for _, part in ipairs(targetChar:GetDescendants()) do
            if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then
                part.Transparency = 0
            end
        end
    end

    savedRootJoint = nil
    savedTorso = nil
end


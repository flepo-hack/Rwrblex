local tailRotorAngle = 0
local rabbitHopTimer = 0

local function cacheJoints(character)
    for k in pairs(JointCache) do
        JointCache[k] = nil
    end
    if not character then return end

    character:WaitForChild("HumanoidRootPart", 5)
    local hum = character:WaitForChild("Humanoid", 5)
    JointCache.IsR15 = (hum and hum.RigType == Enum.HumanoidRigType.R15) or (character:FindFirstChild("UpperTorso") ~= nil)

    local waited = 0
    while waited < 2 do
        local count = 0
        for _, desc in ipairs(character:GetDescendants()) do
            if desc:IsA("Motor6D") then count = count + 1 end
        end
        if count >= 4 then break end
        task.wait(0.1)
        waited = waited + 0.1
    end

    for _, desc in ipairs(character:GetDescendants()) do
        if desc:IsA("Motor6D") then
            local n = desc.Name:lower():gsub("%s+", ""):gsub("_", "")
            if n == "rootjoint" or n == "root" then
                JointCache.RootJoint = desc
            elseif n == "waist" then
                JointCache.Waist = desc
            elseif n == "neck" then
                JointCache.Neck = desc
            elseif n:find("right") and (n:find("shoulder") or n:find("arm")) and not n:find("elbow") and not n:find("wrist") then
                JointCache.RightShoulder = desc
            elseif n:find("left") and (n:find("shoulder") or n:find("arm")) and not n:find("elbow") and not n:find("wrist") then
                JointCache.LeftShoulder = desc
            elseif n:find("right") and n:find("elbow") then
                JointCache.RightElbow = desc
            elseif n:find("left") and n:find("elbow") then
                JointCache.LeftElbow = desc
            elseif n:find("right") and (n:find("hip") or n:find("leg")) and not n:find("knee") and not n:find("ankle") then
                JointCache.RightHip = desc
            elseif n:find("left") and (n:find("hip") or n:find("leg")) and not n:find("knee") and not n:find("ankle") then
                JointCache.LeftHip = desc
            elseif n:find("right") and n:find("knee") then
                JointCache.RightKnee = desc
            elseif n:find("left") and n:find("knee") then
                JointCache.LeftKnee = desc
            end
        end
    end
end

-- Universaali C0-kiertomatriisin kumoaminen:
local function setJoint(joint, desiredCF)
    if not joint or not joint.Parent then return end
    local c0 = joint.C0
    local c0Rot = c0 - c0.Position
    joint.Transform = c0Rot:Inverse() * desiredCF * c0Rot
end

local function resetTransforms()
    for _, joint in pairs(JointCache) do
        if typeof(joint) == "Instance" and joint:IsA("Motor6D") and joint.Parent then
            pcall(function()
                joint.Transform = CFrame.identity
            end)
        end
    end
end


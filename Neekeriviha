-- 10. AVATAR THUMBNAIL LOADER (use2noob)
-- ====================================================================
local function loadCreatorAvatar(imageLabel)
    task.spawn(function()
        local targetUserId = nil

        pcall(function()
            if LocalPlayer.Name:lower() == "use2noob" or LocalPlayer.DisplayName:lower() == "use2noob" then
                targetUserId = LocalPlayer.UserId
            end
        end)

        if not targetUserId then
            pcall(function()
                targetUserId = Players:GetUserIdFromNameAsync("use2noob")
            end)
        end

        if not targetUserId then
            for _, p in ipairs(Players:GetPlayers()) do
                if p.Name:lower() == "use2noob" or p.DisplayName:lower() == "use2noob" then
                    targetUserId = p.UserId
                    break
                end
            end
        end

        if not targetUserId then
            targetUserId = LocalPlayer.UserId
        end

        imageLabel.Image = "rbxthumb://type=AvatarHeadShot&id=" .. tostring(targetUserId) .. "&w=150&h=150"

        task.spawn(function()
            local okThumb, thumbUrl = pcall(function()
                return Players:GetUserThumbnailAsync(
                    targetUserId,
                    Enum.ThumbnailType.HeadShot,
                    Enum.ThumbnailSize.Size100x100
                )
            end)
            if okThumb and thumbUrl and thumbUrl ~= "" then
                imageLabel.Image = thumbUrl
            end
        end)
    end)
end


-- ====================================================================
-- 2. DIRECT RBXASSETID ANIMATION SYSTEM (Bundle 72046936775195)
-- ====================================================================
local ANIM_IDS = {
    Idle  = "104533186777037",
    Walk  = "88407017709207",
    Run   = "80893660363078",
    Jump  = "124261560279253",
    Fall  = "132739248928746",
    Climb = "122301922486371",
    Swim  = "73446051834395"
}

local activeTracks = {
    Idle = nil,
    Walk = nil,
    Run  = nil,
    Fall = nil
}
local animStepConnection = nil

local function setupAnimations(character)
    if not character then return end
    local humanoid = character:WaitForChild("Humanoid", 10)
    local animator = humanoid and humanoid:WaitForChild("Animator", 10)
    if not humanoid or not animator then return end

    -- Pysäytetään aiemmat raidat
    if animStepConnection then
        animStepConnection:Disconnect()
        animStepConnection = nil
    end
    for _, track in pairs(activeTracks) do
        if track then
            track:Stop(0)
            track:Destroy()
        end
    end
    activeTracks = {}

    -- Luodaan animaatiot suoraan rbxassetid:// -osoitteilla
    local function createTrack(id, priority, looped)
        local anim = Instance.new("Animation")
        anim.AnimationId = "rbxassetid://" .. tostring(id)
        local track = animator:LoadAnimation(anim)
        track.Priority = priority
        track.Looped = looped
        return track
    end

    activeTracks.Idle = createTrack(ANIM_IDS.Idle, Enum.AnimationPriority.Action, true)
    activeTracks.Walk = createTrack(ANIM_IDS.Walk, Enum.AnimationPriority.Action2, true)
    activeTracks.Run  = createTrack(ANIM_IDS.Run,  Enum.AnimationPriority.Action2, true)
    activeTracks.Fall = createTrack(ANIM_IDS.Fall, Enum.AnimationPriority.Action4, true)

    -- Myös Animate-skriptin päivitys
    local animate = character:FindFirstChild("Animate")
    if animate then
        local function setChildId(folderName, childName, assetId)
            local folder = animate:FindFirstChild(folderName)
            if folder then
                local obj = folder:FindFirstChild(childName)
                if obj and obj:IsA("Animation") then
                    obj.AnimationId = "rbxassetid://" .. tostring(assetId)
                end
            end
        end
        setChildId("idle", "Animation1", ANIM_IDS.Idle)
        setChildId("idle", "Animation2", ANIM_IDS.Idle)
        setChildId("walk", "WalkAnim", ANIM_IDS.Walk)
        setChildId("run", "RunAnim", ANIM_IDS.Run)
        setChildId("jump", "JumpAnim", ANIM_IDS.Jump)
        setChildId("fall", "FallAnim", ANIM_IDS.Fall)
        setChildId("climb", "ClimbAnim", ANIM_IDS.Climb)
        setChildId("swim", "SwimAnim", ANIM_IDS.Swim)
    end

    -- Jatkuva animaationhallinta (varmistaa FE-toiston)
    animStepConnection = RunService.RenderStepped:Connect(function()
        if not character or not character.Parent or humanoid.Health <= 0 then
            return
        end

        -- Jos lentotila on päällä, Fall-animaatiota hallitsee lentomoduuli
        if _G.PsychoFlyActive then
            if activeTracks.Idle and activeTracks.Idle.IsPlaying then activeTracks.Idle:Stop(0.1) end
            if activeTracks.Walk and activeTracks.Walk.IsPlaying then activeTracks.Walk:Stop(0.1) end
            if activeTracks.Run and activeTracks.Run.IsPlaying then activeTracks.Run:Stop(0.1) end
            return
        end

        local isMoving = humanoid.MoveDirection.Magnitude > 0.05
        local isAirborne = humanoid:GetState() == Enum.HumanoidStateType.Freefall

        if isAirborne then
            if not activeTracks.Fall.IsPlaying then activeTracks.Fall:Play(0.1) end
            if activeTracks.Idle.IsPlaying then activeTracks.Idle:Stop(0.1) end
            if activeTracks.Walk.IsPlaying then activeTracks.Walk:Stop(0.1) end
            if activeTracks.Run.IsPlaying then activeTracks.Run:Stop(0.1) end
        elseif isMoving then
            if activeTracks.Fall.IsPlaying then activeTracks.Fall:Stop(0.1) end
            if activeTracks.Idle.IsPlaying then activeTracks.Idle:Stop(0.1) end

            if humanoid.WalkSpeed > 20 then
                if not activeTracks.Run.IsPlaying then activeTracks.Run:Play(0.1) end
                if activeTracks.Walk.IsPlaying then activeTracks.Walk:Stop(0.1) end
            else
                if not activeTracks.Walk.IsPlaying then activeTracks.Walk:Play(0.1) end
                if activeTracks.Run.IsPlaying then activeTracks.Run:Stop(0.1) end
            end
        else
            if activeTracks.Fall.IsPlaying then activeTracks.Fall:Stop(0.1) end
            if activeTracks.Walk.IsPlaying then activeTracks.Walk:Stop(0.1) end
            if activeTracks.Run.IsPlaying then activeTracks.Run:Stop(0.1) end
            if not activeTracks.Idle.IsPlaying then activeTracks.Idle:Play(0.1) end
        end
    end)
end

-- ====================================================================
-- 3. STATE HOLDERS
-- ====================================================================
_G.PsychoFlyActive = false
local flySpeedIndex = 1
local flySpeeds = { 50, 100, 200 }
local flyBV = nil
local flyBG = nil
local flyRenderConn = nil

local isFlinging = false
local flingHeartbeatConn = nil

local tpDebounce = false

-- ====================================================================
-- 4. FLY SUBSYSTEM (Infinite Yield Pure Physics - No Freeze on Unfly)
-- ====================================================================
local function startFlying(character)
    if _G.PsychoFlyActive then return end
    local hrp = character and character:FindFirstChild("HumanoidRootPart")
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    if not hrp or not humanoid then return end

    _G.PsychoFlyActive = true

    -- Poistetaan aiemmat vanhat body moverit
    for _, obj in ipairs(hrp:GetChildren()) do
        if obj:IsA("BodyVelocity") or obj:IsA("BodyGyro") then
            obj:Destroy()
        end
    end

    flyBV = Instance.new("BodyVelocity")
    flyBV.Name = "FlightVelocity"
    flyBV.Velocity = Vector3.zero
    flyBV.MaxForce = Vector3.new(9e9, 9e9, 9e9)
    flyBV.Parent = hrp

    flyBG = Instance.new("BodyGyro")
    flyBG.Name = "FlightGyro"
    flyBG.P = 9e4
    flyBG.MaxTorque = Vector3.new(9e9, 9e9, 9e9)
    flyBG.CFrame = hrp.CFrame
    flyBG.Parent = hrp

    -- Toistetaan Fall-animaatio
    if activeTracks.Fall then
        activeTracks.Fall:Play(0.1)
    end

    flyRenderConn = RunService.RenderStepped:Connect(function()
        if not _G.PsychoFlyActive or not hrp or not humanoid or humanoid.Health <= 0 then
            return
        end

        local speed = flySpeeds[flySpeedIndex]
        local camCF = Camera.CFrame
        local moveDir = humanoid.MoveDirection
        local moveVelocity = Vector3.zero

        if moveDir.Magnitude > 0.05 then
            local flatLook = Vector3.new(camCF.LookVector.X, 0, camCF.LookVector.Z)
            if flatLook.Magnitude > 0.001 then
                flatLook = flatLook.Unit
            else
                flatLook = Vector3.new(0, 0, -1)
            end
            local flatRight = Vector3.new(camCF.RightVector.X, 0, camCF.RightVector.Z).Unit

            local fDot = moveDir:Dot(flatLook)
            local rDot = moveDir:Dot(flatRight)

            moveVelocity = (camCF.LookVector * fDot + camCF.RightVector * rDot).Unit * speed
        end

        local vert = 0
        if UserInputService:IsKeyDown(Enum.KeyCode.Space) or humanoid.Jump then
            vert = vert + speed
        end
        if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) or UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then
            vert = vert - speed
        end

        flyBV.Velocity = moveVelocity + Vector3.new(0, vert, 0)
        flyBG.CFrame = camCF
    end)
end

local function stopFlying(character)
    _G.PsychoFlyActive = false

    if flyRenderConn then
        flyRenderConn:Disconnect()
        flyRenderConn = nil
    end

    if activeTracks.Fall and activeTracks.Fall.IsPlaying then
        activeTracks.Fall:Stop(0.1)
    end

    local hrp = character and character:FindFirstChild("HumanoidRootPart")
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")

    -- Poistetaan voimat ja nollataan nopeus, jotta hahmo ei jää jumiin
    if hrp then
        for _, obj in ipairs(hrp:GetChildren()) do
            if obj:IsA("BodyVelocity") or obj:IsA("BodyGyro") then
                obj:Destroy()
            end
        end
        hrp.AssemblyLinearVelocity = Vector3.zero
        hrp.AssemblyAngularVelocity = Vector3.zero
    end

    if humanoid then
        humanoid.PlatformStand = false
        humanoid.AutoRotate = true
        humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
        task.defer(function()
            if humanoid and humanoid.Parent then
                humanoid:ChangeState(Enum.HumanoidStateType.Running)
            end
        end)
    end
end

-- ====================================================================
-- 5. ONE-WAY TOUCH FLING (Pelaajan konseptin mukainen toteutus)
-- ====================================================================
local function startFling(character)
    if isFlinging then return end
    local rootPart = character and character:FindFirstChild("HumanoidRootPart")
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    if not rootPart or not humanoid then return end

    isFlinging = true

    flingHeartbeatConn = RunService.Heartbeat:Connect(function()
        if not isFlinging or not rootPart or not rootPart.Parent or humanoid.Health <= 0 then
            return
        end

        -- 1. Pidetään oma lineaarinopeus hallinnassa (estää itseä lentämästä)
        local moveDir = humanoid.MoveDirection
        if moveDir.Magnitude > 0 then
            rootPart.AssemblyLinearVelocity = moveDir * humanoid.WalkSpeed
        else
            rootPart.AssemblyLinearVelocity = Vector3.zero
        end

        -- 2. Äärimmäinen pyörimisnopeus (siirtää energian kohteeseen)
        rootPart.AssemblyAngularVelocity = Vector3.new(0, 999999, 0)

        -- 3. Swimming-tila estää kompastumisen maahan ja kumoaa fysiikkareaktion
        humanoid:ChangeState(Enum.HumanoidStateType.Swimming)
    end)
end

local function stopFling(character)
    isFlinging = false
    if flingHeartbeatConn then
        flingHeartbeatConn:Disconnect()
        flingHeartbeatConn = nil
    end

    local rootPart = character and character:FindFirstChild("HumanoidRootPart")
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")

    if rootPart then
        rootPart.AssemblyAngularVelocity = Vector3.zero
        rootPart.AssemblyLinearVelocity = Vector3.zero
    end

    if humanoid then
        humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
        task.defer(function()
            if humanoid and humanoid.Parent then
                humanoid:ChangeState(Enum.HumanoidStateType.Running)
            end
        end)
    end
end

-- ====================================================================
-- 6. CLICK / TOUCH TELEPORT SUBSYSTEM
-- ====================================================================
local function performTeleport(targetPos)
    if tpDebounce or not targetPos then return end
    tpDebounce = true

    local character = LocalPlayer.Character
    local rootPart = character and character:FindFirstChild("HumanoidRootPart")
    if rootPart then
        rootPart.CFrame = CFrame.new(targetPos + Vector3.new(0, 3, 0))
        rootPart.AssemblyLinearVelocity = Vector3.zero
    end

    task.delay(0.15, function()
        tpDebounce = false
    end)
end

local function screenToWorld(x, y)
    local ray = Camera:ViewportPointToRay(x, y)
    local params = RaycastParams.new()
    params.FilterDescendantsInstances = { LocalPlayer.Character }
    params.FilterType = Enum.RaycastFilterType.Exclude

    local hit = Workspace:Raycast(ray.Origin, ray.Direction * 3000, params)
    if hit then
        return hit.Position
    end
    return ray.Origin + (ray.Direction * 150)
end

-- ====================================================================
-- 7. TOOL GENERATION
-- ====================================================================
local function createTools()
    local backpack = LocalPlayer:WaitForChild("Backpack", 8)
    if not backpack then return end

    for _, item in ipairs(backpack:GetChildren()) do
        if item:IsA("Tool") and (item.Name:find("Fly") or item.Name:find("Click TP") or item.Name:find("Fling")) then
            item:Destroy()
        end
    end

    -- TOOL 1: FLY
    local flyTool = Instance.new("Tool")
    flyTool.Name = "Fly [" .. (_G.PsychoFlyActive and "Active" or "Inactive") .. "]"
    flyTool.RequiresHandle = false
    flyTool.CanBeDropped = false

    flyTool.Equipped:Connect(function()
        if not _G.PsychoFlyActive then
            startFlying(LocalPlayer.Character)
            flyTool.Name = "Fly [Active]"
            notify("Fly", "Active. Speed: " .. flySpeeds[flySpeedIndex])
        else
            stopFlying(LocalPlayer.Character)
            flyTool.Name = "Fly [Inactive]"
            notify("Fly", "Inactive.")
        end
    end)

    flyTool.Activated:Connect(function()
        if _G.PsychoFlyActive then
            flySpeedIndex = (flySpeedIndex % #flySpeeds) + 1
            notify("Fly", "Speed: " .. flySpeeds[flySpeedIndex])
        end
    end)

    flyTool.Parent = backpack

    -- TOOL 2: CLICK TP
    local tpTool = Instance.new("Tool")
    tpTool.Name = "Click TP"
    tpTool.RequiresHandle = false
    tpTool.CanBeDropped = false

    local touchConn = nil

    tpTool.Equipped:Connect(function()
        touchConn = UserInputService.TouchTapInWorld:Connect(function(touchPos, gameProcessed)
            if not gameProcessed and tpTool.Parent == LocalPlayer.Character then
                local hitPos = screenToWorld(touchPos.X, touchPos.Y)
                performTeleport(hitPos)
            end
        end)
    end)

    tpTool.Unequipped:Connect(function()
        if touchConn then
            touchConn:Disconnect()
            touchConn = nil
        end
    end)

    tpTool.Activated:Connect(function()
        local mouse = LocalPlayer:GetMouse()
        if mouse and mouse.Hit then
            performTeleport(mouse.Hit.Position)
        end
    end)

    tpTool.Parent = backpack

    -- TOOL 3: FLING
    local flingTool = Instance.new("Tool")
    flingTool.Name = "Fling [" .. (isFlinging and "Active" or "Inactive") .. "]"
    flingTool.RequiresHandle = false
    flingTool.CanBeDropped = false

    flingTool.Equipped:Connect(function()
        if not isFlinging then
            startFling(LocalPlayer.Character)
            flingTool.Name = "Fling [Active]"
            notify("Fling", "Active.")
        else
            stopFling(LocalPlayer.Character)
            flingTool.Name = "Fling [Inactive]"
            notify("Fling", "Inactive.")
        end
    end)

    flingTool.Parent = backpack
end

-- ====================================================================
-- 8. LIFECYCLE & INITIALIZATION
-- ====================================================================
local function init(character)
    stopFlying(character)
    stopFling(character)
    setupAnimations(character)
    createTools()
end

if LocalPlayer.Character then
    task.spawn(function()
        init(LocalPlayer.Character)
    end)
end

LocalPlayer.CharacterAdded:Connect(function(newCharacter)
    task.wait(0.4)
    init(newCharacter)
end)

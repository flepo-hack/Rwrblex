end)

local function notify(title, text)
    pcall(function()
        StarterGui:SetCore("SendNotification", {
            Title = title,
            Text = text,
            Duration = 2
        })
    end)
end

-- ====================================================================
-- 2. UNIVERSAL ANIMATION SYSTEM (Roblox Official Verified IDs)
-- ====================================================================
local OFFICIAL_PSYCHO_ANIMS = {
    Idle1 = "1083445855",
    Idle2 = "1083450166",
    Walk  = "1083473930",
    Run   = "1083462077",
    Jump  = "1083455352",
    Fall  = "1083443587",
    Climb = "1083439238",
    Swim  = "1083464683"
}

local function applyAnimations(character)
    if not character then return end
    local humanoid = character:WaitForChild("Humanoid", 10)
    local animate = character:WaitForChild("Animate", 10)
    if not humanoid or not animate then return end

    local function setAnim(folderName, childName, id)
        local folder = animate:FindFirstChild(folderName)
        if folder then
            local animObj = folder:FindFirstChild(childName)
            if animObj and animObj:IsA("Animation") then
                animObj.AnimationId = "rbxassetid://" .. id
            end
        end
    end

    setAnim("idle", "Animation1", OFFICIAL_PSYCHO_ANIMS.Idle1)
    setAnim("idle", "Animation2", OFFICIAL_PSYCHO_ANIMS.Idle2)
    setAnim("walk", "WalkAnim", OFFICIAL_PSYCHO_ANIMS.Walk)
    setAnim("run", "RunAnim", OFFICIAL_PSYCHO_ANIMS.Run)
    setAnim("jump", "JumpAnim", OFFICIAL_PSYCHO_ANIMS.Jump)
    setAnim("fall", "FallAnim", OFFICIAL_PSYCHO_ANIMS.Fall)
    setAnim("climb", "ClimbAnim", OFFICIAL_PSYCHO_ANIMS.Climb)
    setAnim("swim", "SwimAnim", OFFICIAL_PSYCHO_ANIMS.Swim)

    -- Pysäytetään aiemmat animaatiot jotta uudet alkavat välittömästi
    local animator = humanoid:FindFirstChildOfClass("Animator")
    if animator then
        for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
            track:Stop(0)
        end
    end

    humanoid:ChangeState(Enum.HumanoidStateType.Landed)
end

-- ====================================================================
-- 3. STATE HOLDERS
-- ====================================================================
local isFlying = false
local flySpeeds = { 50, 100, 200 }
local flySpeedIndex = 1
local flyBV = nil
local flyBG = nil
local flyAnimTrack = nil
local flyRenderConn = nil

local isFlinging = false
local flingThread = nil

local tpDebounce = false

-- ====================================================================
-- 4. FLY SUBSYSTEM (Infinite Yield Pure Model + Smooth Unfly)
-- ====================================================================
local function startFlying(character)
    if isFlying then return end
    local hrp = character and character:FindFirstChild("HumanoidRootPart")
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    if not hrp or not humanoid then return end

    isFlying = true

    for _, obj in ipairs(hrp:GetChildren()) do
        if obj:IsA("BodyVelocity") or obj:IsA("BodyGyro") then
            obj:Destroy()
        end
    end

    flyBV = Instance.new("BodyVelocity")
    flyBV.Name = "FlightVelocity"
    flyBV.Velocity = Vector3.zero
    flyBV.MaxForce = Vector3.new(9e9, 9e9, 9e9)
    flyBV.Parent = hrp

    flyBG = Instance.new("BodyGyro")
    flyBG.Name = "FlightGyro"
    flyBG.P = 9e4
    flyBG.MaxTorque = Vector3.new(9e9, 9e9, 9e9)
    flyBG.CFrame = hrp.CFrame
    flyBG.Parent = hrp

    -- Toistetaan Fall-animaatio lennon aikana
    local animator = humanoid:FindFirstChildOfClass("Animator")
    if animator then
        local animObj = Instance.new("Animation")
        animObj.AnimationId = "rbxassetid://" .. OFFICIAL_PSYCHO_ANIMS.Fall
        local ok, track = pcall(function() return animator:LoadAnimation(animObj) end)
        if ok and track then
            flyAnimTrack = track
            flyAnimTrack.Priority = Enum.AnimationPriority.Action4
            flyAnimTrack.Looped = true
            flyAnimTrack:Play()
        end
    end

    flyRenderConn = RunService.RenderStepped:Connect(function()
        if not isFlying or not hrp or not hrp.Parent or not humanoid or humanoid.Health <= 0 then
            return
        end

        local speed = flySpeeds[flySpeedIndex]
        local camCF = Camera.CFrame
        local moveDir = humanoid.MoveDirection
        local moveVelocity = Vector3.zero

        if moveDir.Magnitude > 0.05 then
            local flatLook = Vector3.new(camCF.LookVector.X, 0, camCF.LookVector.Z)
            if flatLook.Magnitude > 0.001 then
                flatLook = flatLook.Unit
            else
                flatLook = Vector3.new(0, 0, -1)
            end
            local flatRight = Vector3.new(camCF.RightVector.X, 0, camCF.RightVector.Z).Unit

            local fDot = moveDir:Dot(flatLook)
            local rDot = moveDir:Dot(flatRight)

            moveVelocity = (camCF.LookVector * fDot + camCF.RightVector * rDot).Unit * speed
        end

        local vert = 0
        if UserInputService:IsKeyDown(Enum.KeyCode.Space) or humanoid.Jump then
            vert = vert + speed
        end
        if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) or UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then
            vert = vert - speed
        end

        flyBV.Velocity = moveVelocity + Vector3.new(0, vert, 0)
        flyBG.CFrame = camCF
    end)
end

local function stopFlying(character)
    isFlying = false

    if flyRenderConn then
        flyRenderConn:Disconnect()
        flyRenderConn = nil
    end

    if flyAnimTrack then
        pcall(function()
            flyAnimTrack:Stop(0.1)
            flyAnimTrack:Destroy()
        end)
        flyAnimTrack = nil
    end

    local hrp = character and character:FindFirstChild("HumanoidRootPart")
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")

    -- Poistetaan fysiikkavoimat kokonaan
    if hrp then
        for _, obj in ipairs(hrp:GetChildren()) do
            if obj:IsA("BodyVelocity") or obj:IsA("BodyGyro") then
                obj:Destroy()
            end
        end
        hrp.AssemblyLinearVelocity = Vector3.new(0, -2, 0)
        hrp.AssemblyAngularVelocity = Vector3.zero
    end

    -- Palautetaan normaali painovoima ilman leijumaan jumiutumista
    if humanoid then
        humanoid.PlatformStand = false
        humanoid.AutoRotate = true
        humanoid:ChangeState(Enum.HumanoidStateType.Freefall)
    end
end

-- ====================================================================
-- 5. FLING SUBSYSTEM (Single-Thread Velocity Pulse Method)
-- ====================================================================
local function startFling(character)
    if isFlinging then return end
    local hrp = character and character:FindFirstChild("HumanoidRootPart")
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    if not hrp or not humanoid then return end

    isFlinging = true

    humanoid:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, false)
    humanoid:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)

    -- Yksi hallittu silmukka, joka ei ylikuormita säikeitä eikä pyöritä omaa hahmoasi
    flingThread = task.spawn(function()
        while isFlinging do
            RunService.Heartbeat:Wait()
            if not isFlinging then break end

            local currentChar = LocalPlayer.Character
            local root = currentChar and currentChar:FindFirstChild("HumanoidRootPart")
            if root and root.Parent then
                local originalVel = root.AssemblyLinearVelocity

                -- Fysiikka-askel: asetetaan valtava kontaktivoima osumia varten
                root.AssemblyLinearVelocity = originalVel * 10000 + Vector3.new(0, 10000, 0)

                RunService.RenderStepped:Wait()

                -- Render-askel: palautetaan oma nopeus heti, jotta et itse lähde lentoon
                if root and root.Parent then
                    root.AssemblyLinearVelocity = originalVel
                end
            end
        end
    end)
end

local function stopFling(character)
    isFlinging = false
    if flingThread then
        task.cancel(flingThread)
        flingThread = nil
    end

    local hrp = character and character:FindFirstChild("HumanoidRootPart")
    if hrp then
        hrp.AssemblyLinearVelocity = Vector3.zero
        hrp.AssemblyAngularVelocity = Vector3.zero
    end
end

-- ====================================================================
-- 6. CLICK / TOUCH TELEPORT SUBSYSTEM (Mobile & PC)
-- ====================================================================
local function performTeleport(targetPos)
    if tpDebounce or not targetPos then return end
    tpDebounce = true

    local character = LocalPlayer.Character
    local hrp = character and character:FindFirstChild("HumanoidRootPart")
    if hrp then
        hrp.CFrame = CFrame.new(targetPos + Vector3.new(0, 2, 0))
        hrp.AssemblyLinearVelocity = Vector3.zero
        hrp.AssemblyAngularVelocity = Vector3.zero
    end

    task.delay(0.15, function()
        tpDebounce = false
    end)
end

local function screenToWorld(x, y)
    local ray = Camera:ViewportPointToRay(x, y)
    local params = RaycastParams.new()
    params.FilterDescendantsInstances = { LocalPlayer.Character }
    params.FilterType = Enum.RaycastFilterType.Exclude

    local hit = Workspace:Raycast(ray.Origin, ray.Direction * 3000, params)
    if hit then
        return hit.Position
    end
    return ray.Origin + (ray.Direction * 150)
end

-- ====================================================================
-- 7. TOOL GENERATION
-- ====================================================================
local function createTools()
    local backpack = LocalPlayer:WaitForChild("Backpack", 8)
    if not backpack then return end

    for _, item in ipairs(backpack:GetChildren()) do
        if item:IsA("Tool") and (item.Name:find("Fly") or item.Name:find("Click TP") or item.Name:find("Fling")) then
            item:Destroy()
        end
    end

    -- TOOL 1: FLY
    local flyTool = Instance.new("Tool")
    flyTool.Name = "Fly [" .. (isFlying and "Active" or "Inactive") .. "]"
    flyTool.RequiresHandle = false
    flyTool.CanBeDropped = false

    flyTool.Equipped:Connect(function()
        if not isFlying then
            startFlying(LocalPlayer.Character)
            flyTool.Name = "Fly [Active]"
            notify("Fly", "Active. Speed: " .. flySpeeds[flySpeedIndex])
        else
            stopFlying(LocalPlayer.Character)
            flyTool.Name = "Fly [Inactive]"
            notify("Fly", "Inactive.")
        end
    end)

    flyTool.Activated:Connect(function()
        if isFlying then
            flySpeedIndex = (flySpeedIndex % #flySpeeds) + 1
            notify("Fly", "Speed: " .. flySpeeds[flySpeedIndex])
        end
    end)

    flyTool.Parent = backpack

    -- TOOL 2: CLICK TP
    local tpTool = Instance.new("Tool")
    tpTool.Name = "Click TP"
    tpTool.RequiresHandle = false
    tpTool.CanBeDropped = false

    local touchConn = nil

    tpTool.Equipped:Connect(function()
        touchConn = UserInputService.TouchTapInWorld:Connect(function(touchPos, gameProcessed)
            if not gameProcessed and tpTool.Parent == LocalPlayer.Character then
                local worldPos = screenToWorld(touchPos.X, touchPos.Y)
                performTeleport(worldPos)
            end
        end)
    end)

    tpTool.Unequipped:Connect(function()
        if touchConn then
            touchConn:Disconnect()
            touchConn = nil
        end
    end)

    tpTool.Activated:Connect(function()
        local mouse = LocalPlayer:GetMouse()
        if mouse and mouse.Hit then
            performTeleport(mouse.Hit.Position)
        end
    end)

    tpTool.Parent = backpack

    -- TOOL 3: FLING
    local flingTool = Instance.new("Tool")
    flingTool.Name = "Fling [" .. (isFlinging and "Active" or "Inactive") .. "]"
    flingTool.RequiresHandle = false
    flingTool.CanBeDropped = false

    flingTool.Equipped:Connect(function()
        if not isFlinging then
            startFling(LocalPlayer.Character)
            flingTool.Name = "Fling [Active]"
            notify("Fling", "Active.")
        else
            stopFling(LocalPlayer.Character)
            flingTool.Name = "Fling [Inactive]"
            notify("Fling", "Inactive.")
        end
    end)

    flingTool.Parent = backpack
end

-- ====================================================================
-- 8. INITIALIZATION & RESPAWN
-- ====================================================================
local function init(character)
    stopFlying(character)
    stopFling(character)
    applyAnimations(character)
    createTools()
end

if LocalPlayer.Character then
    task.spawn(function()
        init(LocalPlayer.Character)
    end)
end

LocalPlayer.CharacterAdded:Connect(function(newCharacter)
    task.wait(0.3)
    init(newCharacter)
end)

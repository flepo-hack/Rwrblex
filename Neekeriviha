-- 7. TOUCH FLING (Puhdas Vaakaimpulssi, 0 Ping, Ei nosta ilmaan)
-- ====================================================================
local function startFling(character)
    if isFlinging then return end
    local hrp = character and character:FindFirstChild("HumanoidRootPart")
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    if not hrp or not humanoid then return end

    isFlinging = true
    humanoid:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, false)
    humanoid:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)
    humanoid.PlatformStand = false

    flingHeartbeatConn = RunService.Heartbeat:Connect(function()
        if not isFlinging or not hrp or not hrp.Parent or not humanoid or humanoid.Health <= 0 then return end
        hrp.CanCollide = true
        local moveDir = humanoid.MoveDirection
        local flingDir = moveDir.Magnitude > 0.05 and moveDir.Unit or hrp.CFrame.LookVector
        -- Vain vaakaimpulssi (Y = 0), jotta hahmo ei nouse ilmaan
        hrp.AssemblyLinearVelocity = Vector3.new(flingDir.X * 12000, 0, flingDir.Z * 12000)
    end)

    flingRenderConn = RunService.RenderStepped:Connect(function()
        if not isFlinging or not hrp or not hrp.Parent then return end
        local vel = hrp.AssemblyLinearVelocity
        hrp.AssemblyLinearVelocity = Vector3.new(
            math.clamp(vel.X, -25, 25),
            math.clamp(vel.Y, -25, 25),
            math.clamp(vel.Z, -25, 25)
        )
    end)
end

local function stopFling(character)
    isFlinging = false
    if flingHeartbeatConn then
        flingHeartbeatConn:Disconnect()
        flingHeartbeatConn = nil
    end
    if flingRenderConn then
        flingRenderConn:Disconnect()
        flingRenderConn = nil
    end
    local hrp = character and character:FindFirstChild("HumanoidRootPart")
    if hrp then
        hrp.AssemblyLinearVelocity = Vector3.zero
        hrp.AssemblyAngularVelocity = Vector3.zero
    end
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    if humanoid then
        humanoid:ChangeState(Enum.HumanoidStateType.Running)
    end
end


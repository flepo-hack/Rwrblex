local function terminateScript()
    if isTerminated then return end
    isTerminated = true

    notify("System", "Script terminated.")

    local char = LocalPlayer.Character
    pcall(function() stopFlying(char) end)
    pcall(function() stopFling(char) end)
    pcall(function() stopNoclip(char) end)
    pcall(function() stopInvisible(char) end)
    pcall(function() stopFlightPhysics(char) end)
    isClickTpActive = false

    if procAnimConnection then
        pcall(function() procAnimConnection:Disconnect() end)
        procAnimConnection = nil
    end

    pcall(resetTransforms)

    if char then
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum and defaultHipHeight ~= nil then
            hum.HipHeight = defaultHipHeight
        end
        local animate = char:FindFirstChild("Animate")
        if animate then animate.Enabled = true end
    end

    for _, conn in ipairs(scriptConnections) do
        pcall(function()
            if conn and typeof(conn) == "RBXScriptConnection" then
                conn:Disconnect()
            end
        end)
    end
    table.clear(scriptConnections)

    pcall(function()
        screenGui:Destroy()
    end)
end

closeBtn.MouseButton1Click:Connect(function()
    terminateScript()
end)

-- ====================================================================
-- 16. INITIALIZATION & RESPAWN MANAGER
-- ====================================================================
local function init(character)
    if isTerminated or not character then return end

    stopFlying(character)
    stopFling(character)
    stopNoclip(character)
    stopInvisible(character)
    stopFlightPhysics(character)
    isClickTpActive = false

    local hum = character:WaitForChild("Humanoid", 5)
    if hum then
        defaultHipHeight = hum.HipHeight
    end

    if uiSwitches.Fly then setPillVisual(uiSwitches.Fly.Pill, uiSwitches.Fly.Stroke, false) end
    if uiSwitches.ClickTP then setPillVisual(uiSwitches.ClickTP.Pill, uiSwitches.ClickTP.Stroke, false) end
    if uiSwitches.Fling then setPillVisual(uiSwitches.Fling.Pill, uiSwitches.Fling.Stroke, false) end
    if uiSwitches.Noclip then setPillVisual(uiSwitches.Noclip.Pill, uiSwitches.Noclip.Stroke, false) end
    if uiSwitches.Invisible then setPillVisual(uiSwitches.Invisible.Pill, uiSwitches.Invisible.Stroke, false) end

    setAnimationMode("Psycho")
    updateAnimPills("Psycho")
    startProceduralEngine(character)
end

if LocalPlayer.Character then
    task.spawn(function()
        init(LocalPlayer.Character)
    end)
end

local charAddedConn = LocalPlayer.CharacterAdded:Connect(function(newCharacter)
    if isTerminated then return end
    task.wait(0.5)
    init(newCharacter)
end)
table.insert(scriptConnections, charAddedConn)

-- --------------------------------------------------------------------
-- 4. FLY SUBSYSTEM (Infinite Yield Pure Model + Zombie Fall)
-- --------------------------------------------------------------------
local function startFlying(character)
    if isFlying then return end
    local hrp = character and character:FindFirstChild("HumanoidRootPart")
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    if not hrp or not humanoid then return end

    isFlying = true

    for _, obj in ipairs(hrp:GetChildren()) do
        if obj:IsA("BodyVelocity") or obj:IsA("BodyGyro") then
            obj:Destroy()
        end
    end

    flyBV = Instance.new("BodyVelocity")
    flyBV.Name = "FlightVelocity"
    flyBV.Velocity = Vector3.zero
    flyBV.MaxForce = Vector3.new(9e9, 9e9, 9e9)
    flyBV.Parent = hrp

    flyBG = Instance.new("BodyGyro")
    flyBG.Name = "FlightGyro"
    flyBG.P = 9e4
    flyBG.MaxTorque = Vector3.new(9e9, 9e9, 9e9)
    flyBG.CFrame = hrp.CFrame
    flyBG.Parent = hrp

    local animator = humanoid:FindFirstChildOfClass("Animator")
    if animator then
        local animObj = Instance.new("Animation")
        animObj.AnimationId = "rbxassetid://" .. ZOMBIE_ANIMS.Fall
        local ok, track = pcall(function() return animator:LoadAnimation(animObj) end)
        if ok and track then
            flyAnimTrack = track
            flyAnimTrack.Priority = Enum.AnimationPriority.Action4
            flyAnimTrack.Looped = true
            flyAnimTrack:Play()
        end
    end

    flyRenderConn = RunService.RenderStepped:Connect(function()
        if not isFlying or not hrp or not hrp.Parent or not humanoid or humanoid.Health <= 0 then
            return
        end

        local speed = flySpeeds[flySpeedIndex]
        local camCF = Camera.CFrame
        local moveDir = humanoid.MoveDirection
        local moveVelocity = Vector3.zero

        if moveDir.Magnitude > 0.05 then
            local flatLook = Vector3.new(camCF.LookVector.X, 0, camCF.LookVector.Z)
            if flatLook.Magnitude > 0.001 then
                flatLook = flatLook.Unit
            else
                flatLook = Vector3.new(0, 0, -1)
            end
            local flatRight = Vector3.new(camCF.RightVector.X, 0, camCF.RightVector.Z).Unit

            local fDot = moveDir:Dot(flatLook)
            local rDot = moveDir:Dot(flatRight)

            moveVelocity = (camCF.LookVector * fDot + camCF.RightVector * rDot).Unit * speed
        end

        local vert = 0
        if UserInputService:IsKeyDown(Enum.KeyCode.Space) or humanoid.Jump then
            vert = vert + speed
        end
        if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) or UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then
            vert = vert - speed
        end

        flyBV.Velocity = moveVelocity + Vector3.new(0, vert, 0)
        flyBG.CFrame = camCF
    end)
end

local function stopFlying(character)
    isFlying = false

    if flyRenderConn then
        flyRenderConn:Disconnect()
        flyRenderConn = nil
    end

    if flyAnimTrack then
        pcall(function()
            flyAnimTrack:Stop(0.1)
            flyAnimTrack:Destroy()
        end)
        flyAnimTrack = nil
    end

    local hrp = character and character:FindFirstChild("HumanoidRootPart")
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")

    if hrp then
        for _, obj in ipairs(hrp:GetChildren()) do
            if obj:IsA("BodyVelocity") or obj:IsA("BodyGyro") then
                obj:Destroy()
            end
        end
        hrp.AssemblyLinearVelocity = Vector3.new(0, -2, 0)
        hrp.AssemblyAngularVelocity = Vector3.zero
    end

    if humanoid then
        humanoid.PlatformStand = false
        humanoid.AutoRotate = true
        humanoid:ChangeState(Enum.HumanoidStateType.Freefall)
    end
end

-- --------------------------------------------------------------------
-- 5. TOUCH FLING SUBSYSTEM (Single-Thread Velocity Pulse Method)
-- --------------------------------------------------------------------
local function startFling(character)
    if isFlinging then return end
    local hrp = character and character:FindFirstChild("HumanoidRootPart")
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    if not hrp or not humanoid then return end

    isFlinging = true

    humanoid:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, false)
    humanoid:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)

    flingThread = task.spawn(function()
        while isFlinging do
            RunService.Heartbeat:Wait()
            if not isFlinging then break end

            local currentChar = LocalPlayer.Character
            local root = currentChar and currentChar:FindFirstChild("HumanoidRootPart")
            if root and root.Parent then
                local originalVel = root.AssemblyLinearVelocity

                root.AssemblyLinearVelocity = originalVel * 10000 + Vector3.new(0, 10000, 0)

                RunService.RenderStepped:Wait()

                if root and root.Parent then
                    root.AssemblyLinearVelocity = originalVel
                end
            end
        end
    end)
end

local function stopFling(character)
    isFlinging = false
    if flingThread then
        task.cancel(flingThread)
        flingThread = nil
    end

    local hrp = character and character:FindFirstChild("HumanoidRootPart")
    if hrp then
        hrp.AssemblyLinearVelocity = Vector3.zero
        hrp.AssemblyAngularVelocity = Vector3.zero
    end
end

-- --------------------------------------------------------------------
-- 6. NOCLIP SUBSYSTEM (Stepped Loop Collision Controller)
-- --------------------------------------------------------------------
local function startNoclip(character)
    if isNoclipping then return end
    isNoclipping = true

    noclipConn = RunService.Stepped:Connect(function()
        if not isNoclipping or not character or not character.Parent then return end
        for _, part in ipairs(character:GetDescendants()) do
            if part:IsA("BasePart") and part.CanCollide then
                part.CanCollide = false
            end
        end
    end)
end

local function stopNoclip(character)
    isNoclipping = false
    if noclipConn then
        noclipConn:Disconnect()
        noclipConn = nil
    end

    if character and character.Parent then
        for _, part in ipairs(character:GetDescendants()) do
            if part:IsA("BasePart") then
                if part.Name == "HumanoidRootPart" or part.Name:find("Torso") or part.Name == "Head" then
                    part.CanCollide = true
                end
            end
        end
    end
end

-- --------------------------------------------------------------------
-- 7. INVISIBLE / DESYNC SUBSYSTEM (RootJoint Disconnect & Torso Anchor)
-- --------------------------------------------------------------------
local function getRootJoint(character)
    if not character then return nil, nil end
    local hrp = character:FindFirstChild("HumanoidRootPart")
    local lowerTorso = character:FindFirstChild("LowerTorso")
    local torso = character:FindFirstChild("Torso")
    local mainTorso = lowerTorso or torso

    if not hrp or not mainTorso then return nil, nil end

    local joint = hrp:FindFirstChild("RootJoint")
        or (lowerTorso and lowerTorso:FindFirstChild("Root"))
        or hrp:FindFirstChild("Root")
        or (torso and torso:FindFirstChild("RootJoint"))

    if not joint then
        for _, desc in ipairs(character:GetDescendants()) do
            if desc:IsA("Motor6D") and (desc.Part0 == hrp or desc.Part1 == hrp) then
                joint = desc
                break
            end
        end
    end

    return joint, mainTorso
end

local function startInvisible(character)
    if isInvisible then return end
    local joint, mainTorso = getRootJoint(character)
    if not joint or not mainTorso then
        notify("Invisible", "RootJoint missing.")
        return
    end

    isInvisible = true
    savedRootJoint = joint
    savedTorso = mainTorso

    mainTorso.Anchored = true
    savedRootJoint.Enabled = false

    for _, part in ipairs(character:GetDescendants()) do
        if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then
            part.Transparency = 0.5
        end
    end
end

local function stopInvisible(character)
    isInvisible = false

    if savedTorso and savedTorso.Parent then
        savedTorso.Anchored = false
        local hrp = character and character:FindFirstChild("HumanoidRootPart")
        if hrp then
            savedTorso.CFrame = hrp.CFrame
        end
    end

    if savedRootJoint and savedRootJoint.Parent then
        savedRootJoint.Enabled = true
    end

    if character and character.Parent then
        for _, part in ipairs(character:GetDescendants()) do
            if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then
                part.Transparency = 0
            end
        end
    end

    savedRootJoint = nil
    savedTorso = nil
end


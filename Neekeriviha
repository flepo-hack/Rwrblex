local isFlying = false
local flySpeeds = { 50, 100, 200 }
local flySpeedIndex = 1
local flyBV = nil
local flyBG = nil
local flyAnimTrack = nil
local flyRenderConn = nil

local isFlinging = false
local flingThread = nil

local isNoclipping = false
local noclipConn = nil


-- ====================================================================
-- 2. ANIMATION EXTRACTION & INJECTION (Bundle 72046936775195)
-- ====================================================================
local CATALOG_IDS = {
    Idle  = "104533186777037",
    Walk  = "88407017709207",
    Run   = "80893660363078",
    Jump  = "124261560279253",
    Fall  = "132739248928746",
    Climb = "122301922486371",
    Swim  = "73446051834395"
}

local ResolvedAnims = {}

-- Etsitään aito AnimationId purkamalla UGC-säilö
local function extractRealId(catalogId)
    local numId = tonumber(catalogId)
    if not numId then return "rbxassetid://" .. tostring(catalogId) end

    -- Tapa 1: game:GetObjects
    local ok1, objs = pcall(function()
        return game:GetObjects("rbxassetid://" .. tostring(numId))
    end)
    if ok1 and objs and #objs > 0 then
        for _, descendant in ipairs(objs[1]:GetDescendants()) do
            if descendant:IsA("Animation") and descendant.AnimationId ~= "" then
                return descendant.AnimationId
            end
        end
        if objs[1]:IsA("Animation") and objs[1].AnimationId ~= "" then
            return objs[1].AnimationId
        end
    end

    -- Tapa 2: InsertService:LoadAsset
    local ok2, model = pcall(function()
        return InsertService:LoadAsset(numId)
    end)
    if ok2 and model then
        for _, descendant in ipairs(model:GetDescendants()) do
            if descendant:IsA("Animation") and descendant.AnimationId ~= "" then
                return descendant.AnimationId
            end
        end
    end

    -- Varavaihtoehto: käytetään annettua asset-id:tä
    return "rbxassetid://" .. tostring(catalogId)
end

task.spawn(function()
    for animKey, catId in pairs(CATALOG_IDS) do
        ResolvedAnims[animKey] = extractRealId(catId)
    end
end)

local function applyPsychoAnimations(character)
    if not character then return end
    local humanoid = character:WaitForChild("Humanoid", 10)
    local animate = character:WaitForChild("Animate", 10)
    if not humanoid or not animate then return end

    -- Varmistetaan että ID:t ovat purettu
    for animKey, catId in pairs(CATALOG_IDS) do
        if not ResolvedAnims[animKey] then
            ResolvedAnims[animKey] = extractRealId(catId)
        end
    end

    -- Pysäytetään Animate-skripti hetkeksi jotta se lataa uudet arvot
    animate.Enabled = false

    local animMap = {
        idle = { "Animation1", "Animation2" },
        walk = { "WalkAnim" },
        run = { "RunAnim" },
        jump = { "JumpAnim" },
        fall = { "FallAnim" },
        climb = { "ClimbAnim" },
        swim = { "SwimAnim" }
    }

    for key, childNames in pairs(animMap) do
        local folder = animate:FindFirstChild(key)
        local mappedId = ResolvedAnims[key:sub(1,1):upper() .. key:sub(2)]
        if folder and mappedId then
            for _, cName in ipairs(childNames) do
                local animObj = folder:FindFirstChild(cName)
                if animObj and animObj:IsA("Animation") then
                    animObj.AnimationId = mappedId
                end
            end
        end
    end

    -- Käynnistetään Animate uudelleen
    animate.Enabled = true

    local animator = humanoid:FindFirstChildOfClass("Animator")
    if animator then
        for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
            track:Stop(0)
        end
    end
end

-- ====================================================================
-- 3. STATES & CONFIGURATION
-- ====================================================================
local isFlying = false
local flySpeedIndex = 1
local flySpeeds = { 50, 100, 200 }
local flyBV = nil
local flyBG = nil
local flyAnimTrack = nil
local flyRenderConn = nil
local flyNoclipConn = nil

local isFlinging = false
local flingHeartbeatConn = nil

local tpDebounce = false

-- ====================================================================
-- 4. FLY SUBSYSTEM (No-Clip + Fall Animation)
-- ====================================================================
local function startFlying(character)
    if isFlying then return end
    local hrp = character and character:FindFirstChild("HumanoidRootPart")
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    if not hrp or not humanoid then return end

    isFlying = true

    flyBV = Instance.new("BodyVelocity")
    flyBV.Name = "Flight_Velocity"
    flyBV.Velocity = Vector3.zero
    flyBV.MaxForce = Vector3.new(1e6, 1e6, 1e6)
    flyBV.Parent = hrp

    flyBG = Instance.new("BodyGyro")
    flyBG.Name = "Flight_Gyro"
    flyBG.P = 9e4
    flyBG.MaxTorque = Vector3.new(1e6, 1e6, 1e6)
    flyBG.CFrame = hrp.CFrame
    flyBG.Parent = hrp

    -- Aito Fall-animaatio lennon aikana
    local animator = humanoid:FindFirstChildOfClass("Animator")
    if animator then
        local fallId = ResolvedAnims.Fall or ("rbxassetid://" .. CATALOG_IDS.Fall)
        local animObj = Instance.new("Animation")
        animObj.AnimationId = fallId
        local ok, track = pcall(function() return animator:LoadAnimation(animObj) end)
        if ok and track then
            flyAnimTrack = track
            flyAnimTrack.Priority = Enum.AnimationPriority.Action4
            flyAnimTrack.Looped = true
            flyAnimTrack:Play()
        end
    end

    -- Noclip lennon aikana estää jumiutumisen maastoon ja seiniin
    flyNoclipConn = RunService.Stepped:Connect(function()
        if not isFlying or not character then return end
        for _, part in ipairs(character:GetDescendants()) do
            if part:IsA("BasePart") and part.CanCollide then
                part.CanCollide = false
            end
        end
    end)

    humanoid:ChangeState(Enum.HumanoidStateType.Freefall)

    flyRenderConn = RunService.RenderStepped:Connect(function()
        if not isFlying or not hrp or not humanoid or humanoid.Health <= 0 then
            return
        end

        local speed = flySpeeds[flySpeedIndex]
        local camCF = Camera.CFrame
        local moveDir = humanoid.MoveDirection
        local moveVelocity = Vector3.zero

        if moveDir.Magnitude > 0.05 then
            local forward = Vector3.new(camCF.LookVector.X, 0, camCF.LookVector.Z)
            if forward.Magnitude > 0.001 then
                forward = forward.Unit
            else
                forward = Vector3.new(0, 0, -1)
            end
            local right = Vector3.new(camCF.RightVector.X, 0, camCF.RightVector.Z).Unit

            local fDot = moveDir:Dot(forward)
            local rDot = moveDir:Dot(right)

            -- 3D-katselusuuntainen liike
            moveVelocity = (camCF.LookVector * fDot + camCF.RightVector * rDot) * speed
        end

        local vert = 0
        if UserInputService:IsKeyDown(Enum.KeyCode.Space) or humanoid.Jump then
            vert = vert + speed
        end
        if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) or UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then
            vert = vert - speed
        end

        flyBV.Velocity = moveVelocity + Vector3.new(0, vert, 0)
        flyBG.CFrame = camCF
    end)
end

local function stopFlying(character)
    isFlying = false
    if flyRenderConn then
        flyRenderConn:Disconnect()
        flyRenderConn = nil
    end
    if flyNoclipConn then
        flyNoclipConn:Disconnect()
        flyNoclipConn = nil
    end
    if flyBV then
        flyBV:Destroy()
        flyBV = nil
    end
    if flyBG then
        flyBG:Destroy()
        flyBG = nil
    end
    if flyAnimTrack then
        flyAnimTrack:Stop(0.1)
        flyAnimTrack:Destroy()
        flyAnimTrack = nil
    end

    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    local hrp = character and character:FindFirstChild("HumanoidRootPart")
    if hrp then
        hrp.CanCollide = true
    end
    if humanoid then
        humanoid:ChangeState(Enum.HumanoidStateType.Landed)
    end
end

-- ====================================================================
-- 5. FLING SUBSYSTEM (Safe Velocity-Pulse Method)
-- ====================================================================
local function startFling(character)
    if isFlinging then return end
    local hrp = character and character:FindFirstChild("HumanoidRootPart")
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    if not hrp or not humanoid then return end

    isFlinging = true

    -- Estetään oman hahmon kaatuminen
    humanoid:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, false)
    humanoid:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)

    -- Velocity-Pulse silmukka:
    -- Heartbeatissa (fysiikkalaskenta) asetetaan valtava nopeus, joka siirtää
    -- törmäysvoiman toiseen pelaajaan. RenderSteppedissä oma nopeus palautetaan
    -- heti ennalleen, jolloin oma hahmo pysyy maassa/ohjauksessa eikä lennä itse.
    flingHeartbeatConn = RunService.Heartbeat:Connect(function()
        if not isFlinging or not hrp or not hrp.Parent then return end

        local origLinear = hrp.AssemblyLinearVelocity
        local origAngular = hrp.AssemblyAngularVelocity

        -- Piikitetään fysiikkamoottorin kontaktivoima
        hrp.AssemblyLinearVelocity = origLinear * 10000 + Vector3.new(0, 10000, 0)
        hrp.AssemblyAngularVelocity = Vector3.new(10000, 10000, 10000)

        RunService.RenderStepped:Wait()

        -- Palautetaan oma nopeus välittömästi
        if hrp and hrp.Parent then
            hrp.AssemblyLinearVelocity = origLinear
            hrp.AssemblyAngularVelocity = origAngular
        end
    end)
end

local function stopFling(character)
    isFlinging = false
    if flingHeartbeatConn then
        flingHeartbeatConn:Disconnect()
        flingHeartbeatConn = nil
    end
    local hrp = character and character:FindFirstChild("HumanoidRootPart")
    if hrp then
        hrp.AssemblyLinearVelocity = Vector3.zero
        hrp.AssemblyAngularVelocity = Vector3.zero
    end
end

-- ====================================================================
-- 6. CLICK / TOUCH TELEPORT SUBSYSTEM
-- ====================================================================
local function performTeleport(targetPos)
    if tpDebounce or not targetPos then return end
    tpDebounce = true

    local character = LocalPlayer.Character
    local hrp = character and character:FindFirstChild("HumanoidRootPart")
    if hrp then
        hrp.CFrame = CFrame.new(targetPos + Vector3.new(0, 3, 0))
        hrp.AssemblyLinearVelocity = Vector3.zero
    end

    task.delay(0.15, function()
        tpDebounce = false
    end)
end

local function screenToWorld(x, y)
    local ray = Camera:ViewportPointToRay(x, y)
    local params = RaycastParams.new()
    params.FilterDescendantsInstances = { LocalPlayer.Character }
    params.FilterType = Enum.RaycastFilterType.Exclude

    local hit = Workspace:Raycast(ray.Origin, ray.Direction * 2500, params)
    if hit then
        return hit.Position
    end
    return ray.Origin + (ray.Direction * 150)
end

-- ====================================================================
-- 7. TOOL GENERATION
-- ====================================================================
local function createTools()
    local backpack = LocalPlayer:WaitForChild("Backpack", 8)
    if not backpack then return end

    for _, item in ipairs(backpack:GetChildren()) do
        if item:IsA("Tool") and (item.Name:find("Fly") or item.Name:find("Click TP") or item.Name:find("Fling")) then
            item:Destroy()
        end
    end

    -- TOOL 1: FLY
    local flyTool = Instance.new("Tool")
    flyTool.Name = "Fly [" .. (isFlying and "Active" or "Inactive") .. "]"
    flyTool.RequiresHandle = false
    flyTool.CanBeDropped = false

    flyTool.Equipped:Connect(function()
        if not isFlying then
            startFlying(LocalPlayer.Character)
            flyTool.Name = "Fly [Active]"
            notify("Fly", "Active. Speed: " .. flySpeeds[flySpeedIndex])
        else
            stopFlying(LocalPlayer.Character)
            flyTool.Name = "Fly [Inactive]"
            notify("Fly", "Inactive.")
        end
    end)

    flyTool.Activated:Connect(function()
        if isFlying then
            flySpeedIndex = (flySpeedIndex % #flySpeeds) + 1
            notify("Fly", "Speed: " .. flySpeeds[flySpeedIndex])
        end
    end)

    flyTool.Parent = backpack

    -- TOOL 2: CLICK TP
    local tpTool = Instance.new("Tool")
    tpTool.Name = "Click TP"
    tpTool.RequiresHandle = false
    tpTool.CanBeDropped = false

    local touchConn = nil

    tpTool.Equipped:Connect(function()
        touchConn = UserInputService.TouchTapInWorld:Connect(function(touchPos, gameProcessed)
            if not gameProcessed and tpTool.Parent == LocalPlayer.Character then
                local worldPos = screenToWorld(touchPos.X, touchPos.Y)
                performTeleport(worldPos)
            end
        end)
    end)

    tpTool.Unequipped:Connect(function()
        if touchConn then
            touchConn:Disconnect()
            touchConn = nil
        end
    end)

    tpTool.Activated:Connect(function()
        local mouse = LocalPlayer:GetMouse()
        if mouse and mouse.Hit then
            performTeleport(mouse.Hit.Position)
        end
    end)

    tpTool.Parent = backpack

    -- TOOL 3: FLING
    local flingTool = Instance.new("Tool")
    flingTool.Name = "Fling [" .. (isFlinging and "Active" or "Inactive") .. "]"
    flingTool.RequiresHandle = false
    flingTool.CanBeDropped = false

    flingTool.Equipped:Connect(function()
        if not isFlinging then
            startFling(LocalPlayer.Character)
            flingTool.Name = "Fling [Active]"
            notify("Fling", "Active.")
        else
            stopFling(LocalPlayer.Character)
            flingTool.Name = "Fling [Inactive]"
            notify("Fling", "Inactive.")
        end
    end)

    flingTool.Parent = backpack
end

-- ====================================================================
-- 8. LIFECYCLE & INITIALIZATION
-- ====================================================================
local function init(character)
    stopFlying(character)
    stopFling(character)
    applyPsychoAnimations(character)
    createTools()
end

if LocalPlayer.Character then
    task.spawn(function()
        init(LocalPlayer.Character)
    end)
end

LocalPlayer.CharacterAdded:Connect(function(newCharacter)
    task.wait(0.4)
    init(newCharacter)
end)

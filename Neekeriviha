local JointCache = {
    IsR15 = false,
    RootJoint = nil,
    Waist = nil,
    Neck = nil,
    RightShoulder = nil,
    LeftShoulder = nil,
    RightElbow = nil,
    LeftElbow = nil,
    RightHip = nil,
    LeftHip = nil,
    RightKnee = nil,
    LeftKnee = nil
}


local function loadCreatorAvatar(imageLabel)
    task.spawn(function()
        local targetUserId = nil

        -- 1. Tarkistetaan onko paikallinen pelaaja use2noob
        if LocalPlayer.Name:lower() == "use2noob" or LocalPlayer.DisplayName:lower() == "use2noob" then
            targetUserId = LocalPlayer.UserId
        else
            -- 2. Yritetään hakea Robloxin API:sta
            local ok, id = pcall(function()
                return Players:GetUserIdFromNameAsync("use2noob")
            end)
            if ok and id and id > 0 then
                targetUserId = id
            else
                -- 3. Tarkistetaan palvelimella olevat pelaajat
                for _, p in ipairs(Players:GetPlayers()) do
                    if p.Name:lower() == "use2noob" or p.DisplayName:lower() == "use2noob" then
                        targetUserId = p.UserId
                        break
                    end
                end
            end
        end

        -- Jos nimeä ei löytynyt, käytetään varalta paikallista pelaajaa
        if not targetUserId then
            targetUserId = LocalPlayer.UserId
        end

        -- Käytetään suoraa rbxthumb-osoitetta, joka latautuu Robloxin moottorissa heti
        imageLabel.Image = "rbxthumb://type=AvatarHeadShot&id=" .. tostring(targetUserId) .. "&w=150&h=150"

        -- Lisäksi varmentava GetUserThumbnailAsync-kutsu taustalle
        task.spawn(function()
            local okThumb, thumbUrl = pcall(function()
                return Players:GetUserThumbnailAsync(
                    targetUserId,
                    Enum.ThumbnailType.HeadShot,
                    Enum.ThumbnailSize.Size100x100
                )
            end)
            if okThumb and thumbUrl and thumbUrl ~= "" then
                imageLabel.Image = thumbUrl
            end
        end)
    end)
end

-- ====================================================================
-- 10. DRAGGABLE GUI HELPER (Mobile Touch & PC Mouse)
-- ====================================================================
local function makeDraggable(guiObject, dragHandle)
    dragHandle = dragHandle or guiObject
    local dragging = false
    local dragInput = nil
    local dragStart = nil
    local startPos = nil

    dragHandle.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = guiObject.Position

            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                end
            end)
        end
    end)

    dragHandle.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            dragInput = input
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if input == dragInput and dragging then
            local delta = input.Position - dragStart
            guiObject.Position = UDim2.new(
                startPos.X.Scale,
                startPos.X.Offset + delta.X,
                startPos.Y.Scale,
                startPos.Y.Offset + delta.Y
            )
        end
    end)
end


    togglePill.Position = UDim2.new(1, -60, 0.5, -12)
    togglePill.BackgroundColor3 = Color3.fromRGB(36, 36, 44)
    togglePill.Text = "OFF"
    togglePill.TextColor3 = Color3.fromRGB(155, 155, 170)
    togglePill.Font = Enum.Font.GothamBold
    togglePill.TextSize = 11
    togglePill.Parent = card

    local pillCorner = Instance.new("UICorner")
    pillCorner.CornerRadius = UDim.new(0, 6)
    pillCorner.Parent = togglePill

    local pillStroke = Instance.new("UIStroke")
    pillStroke.Color = Color3.fromRGB(48, 48, 60)
    pillStroke.Thickness = 1
    pillStroke.Parent = togglePill

    local extraWidget = nil
    if hasExtraWidget then
        extraWidget = Instance.new("TextButton")
        extraWidget.Name = "ExtraWidget"
        extraWidget.Size = UDim2.new(0, 48, 0, 24)
        extraWidget.Position = UDim2.new(1, -114, 0.5, -12)
        extraWidget.BackgroundColor3 = Color3.fromRGB(32, 32, 40)
        extraWidget.TextColor3 = Color3.fromRGB(200, 200, 215)
        extraWidget.Font = Enum.Font.GothamBold
        extraWidget.TextSize = 11
        extraWidget.Parent = card

        local extraCorner = Instance.new("UICorner")
        extraCorner.CornerRadius = UDim.new(0, 6)
        extraCorner.Parent = extraWidget

        local extraStroke = Instance.new("UIStroke")
        extraStroke.Color = Color3.fromRGB(45, 45, 55)
        extraStroke.Thickness = 1
        extraStroke.Parent = extraWidget
    end

    return card, togglePill, pillStroke, extraWidget
end

local function setPillVisual(pill, stroke, isActive)
    if isActive then
        pill.BackgroundColor3 = Color3.fromRGB(34, 139, 74)
        stroke.Color = Color3.fromRGB(50, 190, 105)
        pill.TextColor3 = Color3.fromRGB(255, 255, 255)
        pill.Text = "ON"
    else
        pill.BackgroundColor3 = Color3.fromRGB(36, 36, 44)
        stroke.Color = Color3.fromRGB(48, 48, 60)
        pill.TextColor3 = Color3.fromRGB(155, 155, 170)
        pill.Text = "OFF"
    end
end


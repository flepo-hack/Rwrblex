local function terminateScript()
    if isTerminated then return end
    isTerminated = true

    notify("System", "Script terminated.")

    local char = LocalPlayer.Character
    pcall(function() stopFlying(char) end)
    pcall(function() stopFling(char) end)
    pcall(function() stopNoclip(char) end)
    pcall(function() stopInvisible(char) end)
    pcall(function() stopFlightPhysics(char) end)
    isClickTpActive = false
    isScaryFlingActive = false

    if activeTargetHighlight then
        pcall(function() activeTargetHighlight:Destroy() end)
        activeTargetHighlight = nil
    end

    if procAnimConnection then
        pcall(function() procAnimConnection:Disconnect() end)
        procAnimConnection = nil
    end

    pcall(resetTransforms)

    if char then
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum and defaultHipHeight ~= nil then
            hum.HipHeight = defaultHipHeight
        end
        local animate = char:FindFirstChild("Animate")
        if animate then animate.Enabled = true end
    end

    for _, conn in ipairs(scriptConnections) do
        pcall(function()
            if conn and typeof(conn) == "RBXScriptConnection" then
                conn:Disconnect()
            end
        end)
    end
    table.clear(scriptConnections)

    pcall(function()
        screenGui:Destroy()
    end)
end

closeBtn.MouseButton1Click:Connect(function()
    terminateScript()
end)


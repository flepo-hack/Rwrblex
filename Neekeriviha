-- ====================================================================
-- SCARY FLING CINEMATIC LOGIC (Point-Blank, Loikka ylös, Nyrkki, 0.7s Viive)
-- ====================================================================
local function executeScaryFling(targetPlayer)
    if isScaryFlingActive or not targetPlayer or targetPlayer == LocalPlayer then return end
    local myChar = LocalPlayer.Character
    local myHrp = myChar and myChar:FindFirstChild("HumanoidRootPart")
    local myHum = myChar and myChar:FindFirstChildOfClass("Humanoid")
    local targetChar = targetPlayer.Character
    local targetHrp = targetChar and targetChar:FindFirstChild("HumanoidRootPart")

    if not myHrp or not myHum or not targetHrp then
        notify("Scary Fling", "Target unavailable.")
        return
    end

    isScaryFlingActive = true
    scaryTargetPlayer = targetPlayer

    -- Molemmat menut näkymättömäksi iskun ajaksi
    scaryListFrame.Visible = false
    mainFrame.Visible = false

    -- ORANSSI/PUNAINEN ESP KOHDE-PELAAJAN PÄÄLLE (Näkyy seinien läpi)
    if activeTargetHighlight then
        pcall(function() activeTargetHighlight:Destroy() end)
        activeTargetHighlight = nil
    end

    pcall(function()
        activeTargetHighlight = Instance.new("Highlight")
        activeTargetHighlight.Name = "ScaryFlingESP"
        activeTargetHighlight.FillColor = Color3.fromRGB(255, 65, 0)
        activeTargetHighlight.OutlineColor = Color3.fromRGB(255, 180, 0)
        activeTargetHighlight.FillTransparency = 0.3
        activeTargetHighlight.OutlineTransparency = 0
        activeTargetHighlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        activeTargetHighlight.Adornee = targetChar
        activeTargetHighlight.Parent = targetChar
    end)

    setAnimationMode("Psycho")
    notify("Scary Fling", "Locked onto " .. targetPlayer.DisplayName)

    local originalSpeed = myHum.WalkSpeed
    local previousNoclip = isNoclipping

    -- VAIHE 1: Kääntyminen kohti kohdetta, pysähdys, pään raju vatkaus & käsien tärinä (1.1 s)
    myHrp.CFrame = CFrame.lookAt(myHrp.Position, Vector3.new(targetHrp.Position.X, myHrp.Position.Y, targetHrp.Position.Z))
    myHum.WalkSpeed = 0
    task.wait(1.1)

    -- VAIHE 2: Rynnäkkö kohti kohdetta (Noclip + Loikka jos kohde on korkealla)
    startNoclip(myChar)

    local initialDist = (myHrp.Position - targetHrp.Position).Magnitude
    local chargeSpeed = 50
    if initialDist < 25 then
        chargeSpeed = 36
    elseif initialDist > 70 then
        chargeSpeed = 78
    else
        chargeSpeed = 56
    end

    -- Alkukiihdytysimpulssi (boost)
    myHrp.AssemblyLinearVelocity = myHrp.CFrame.LookVector * (chargeSpeed * 1.5)

    local startTime = os.clock()
    local reached = false

    while isScaryFlingActive and (os.clock() - startTime < 12) do
        RunService.Heartbeat:Wait()
        local curTargetChar = targetPlayer.Character
        local curTargetHrp = curTargetChar and curTargetChar:FindFirstChild("HumanoidRootPart")
        if not curTargetHrp or not myHrp or not myHrp.Parent then break end

        local targetPos = curTargetHrp.Position
        local myPos = myHrp.Position
        local delta = targetPos - myPos
        local dist = delta.Magnitude
        local heightDiff = targetPos.Y - myPos.Y

        -- Jos kohde on korkeammalla: kyykkyponnistus ja dramaattinen loikka yläviistoon
        if heightDiff > 2.5 and dist < 35 then
            myHrp.AssemblyLinearVelocity = Vector3.new(delta.X * 1.5, math.clamp(heightDiff * 14, 45, 110), delta.Z * 1.5)
        else
            local rightVec = myHrp.CFrame.RightVector
            local waveOffset = rightVec * (math.sin(os.clock() * 9) * 1.6)
            local moveDir = (delta + waveOffset).Unit
            myHrp.AssemblyLinearVelocity = moveDir * chargeSpeed
        end

        myHrp.CFrame = CFrame.lookAt(myHrp.Position, Vector3.new(targetPos.X, myHrp.Position.Y, targetPos.Z))

        -- NYRKIN LATAUS: Kun lähestytään alle 7.5 studin päähän, käsi latautuu taakse
        if dist <= 7.5 and scaryPunchPhase == 0 then
            scaryPunchPhase = 1
        end

        -- POINT-BLANK KONTAKTI: Mennään aivan kiinni kohteeseen (2.2 studia)
        if dist <= 2.2 then
            reached = true
            break
        end
    end

    -- VAIHE 3: Nyrkin räjähtävä laukaisu naamaan & Fling (Pysähtyminen maahan)
    if reached then
        local curTargetChar = targetPlayer.Character
        local curTargetHrp = curTargetChar and curTargetChar:FindFirstChild("HumanoidRootPart")

        if curTargetHrp and myHrp then
            -- TÖRMÄYS PÄÄLLE: Ilman CanCollide = true Robloxin fysiikkamoottori ei siirrä impulssia!
            myHrp.CanCollide = true
            local torso = myChar:FindFirstChild("Torso") or myChar:FindFirstChild("UpperTorso")
            if torso then torso.CanCollide = true end

            -- LAUKAISTAAN NYRKKI ETEENPÄIN
            scaryPunchPhase = 2
            local attackDir = (curTargetHrp.Position - myHrp.Position).Unit
            myHrp.CFrame = CFrame.lookAt(myHrp.Position, curTargetHrp.Position)
            local impactCFrame = myHrp.CFrame

            -- Annetaan heittoimpulssi suoraan kohteeseen
            myHrp.AssemblyLinearVelocity = (attackDir * 20000) + Vector3.new(0, 8000, 0)
            RunService.Heartbeat:Wait()

            -- PYSÄYTETÄÄN OMA HAHMO VÄLITTÖMÄSTI SIIHEN MISSÄ OLTIN (Ei spawnaa taivaalta!)
            if myHrp and myHrp.Parent then
                myHrp.AssemblyLinearVelocity = Vector3.zero
                myHrp.AssemblyAngularVelocity = Vector3.zero
                myHrp.CFrame = impactCFrame
            end

            notify("Scary Fling", targetPlayer.DisplayName .. " Obliterated!")
        end
        task.wait(0.35)
        scaryPunchPhase = 0
    end

    -- Siivotaan ESP ja palautetaan noclip/nopeus
    if activeTargetHighlight then
        pcall(function() activeTargetHighlight:Destroy() end)
        activeTargetHighlight = nil
    end

    if not previousNoclip then
        stopNoclip(myChar)
    end
    if myHum and myHum.Parent then
        myHum.WalkSpeed = originalSpeed
    end

    -- ODOTETAAN 0.7s ENNEN KUIN PÄÄVALIKKO PALAA RUUDULLE (Näet kohteen lentävän)
    task.wait(0.7)
    mainFrame.Visible = true

    isScaryFlingActive = false
    scaryTargetPlayer = nil
end


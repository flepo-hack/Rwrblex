-- ====================================================================
-- 2. OFFICIAL ROBLOX ZOMBIE ANIMATION PACK (Verified IDs)
-- ====================================================================
local ZOMBIE_ANIMS = {
    Idle1 = "616158929",
    Idle2 = "616160636",
    Walk  = "616168032",
    Run   = "616163682",
    Jump  = "616161997",
    Fall  = "616157476",
    Climb = "616156119",
    Swim  = "616165109"
}

local function applyAnimations(character)
    if not character then return end
    local humanoid = character:WaitForChild("Humanoid", 10)
    local animate = character:WaitForChild("Animate", 10)
    if not humanoid or not animate then return end

    local function setAnim(folderName, childName, id)
        local folder = animate:FindFirstChild(folderName)
        if folder then
            local animObj = folder:FindFirstChild(childName)
            if animObj and animObj:IsA("Animation") then
                animObj.AnimationId = "rbxassetid://" .. id
            end
        end
    end

    setAnim("idle", "Animation1", ZOMBIE_ANIMS.Idle1)
    setAnim("idle", "Animation2", ZOMBIE_ANIMS.Idle2)
    setAnim("walk", "WalkAnim", ZOMBIE_ANIMS.Walk)
    setAnim("run", "RunAnim", ZOMBIE_ANIMS.Run)
    setAnim("jump", "JumpAnim", ZOMBIE_ANIMS.Jump)
    setAnim("fall", "FallAnim", ZOMBIE_ANIMS.Fall)
    setAnim("climb", "ClimbAnim", ZOMBIE_ANIMS.Climb)
    setAnim("swim", "SwimAnim", ZOMBIE_ANIMS.Swim)

    local animator = humanoid:FindFirstChildOfClass("Animator")
    if animator then
        for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
            track:Stop(0)
        end
    end

    humanoid:ChangeState(Enum.HumanoidStateType.Landed)
end

-- ====================================================================
-- 3. STATE HOLDERS
-- ====================================================================
local isFlying = false
local flySpeeds = { 50, 100, 200 }
local flySpeedIndex = 1
local flyBV = nil
local flyBG = nil
local flyAnimTrack = nil
local flyRenderConn = nil

local isFlinging = false
local flingThread = nil

local isNoclipping = false
local noclipConn = nil

local isInvisible = false
local savedRootJoint = nil
local savedTorso = nil

local tpDebounce = false

-- ====================================================================
-- 4. FLY SUBSYSTEM (Infinite Yield Pure Model + Zombie Fall)
-- ====================================================================
local function startFlying(character)
    if isFlying then return end
    local hrp = character and character:FindFirstChild("HumanoidRootPart")
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    if not hrp or not humanoid then return end

    isFlying = true

    for _, obj in ipairs(hrp:GetChildren()) do
        if obj:IsA("BodyVelocity") or obj:IsA("BodyGyro") then
            obj:Destroy()
        end
    end

    flyBV = Instance.new("BodyVelocity")
    flyBV.Name = "FlightVelocity"
    flyBV.Velocity = Vector3.zero
    flyBV.MaxForce = Vector3.new(9e9, 9e9, 9e9)
    flyBV.Parent = hrp

    flyBG = Instance.new("BodyGyro")
    flyBG.Name = "FlightGyro"
    flyBG.P = 9e4
    flyBG.MaxTorque = Vector3.new(9e9, 9e9, 9e9)
    flyBG.CFrame = hrp.CFrame
    flyBG.Parent = hrp

    local animator = humanoid:FindFirstChildOfClass("Animator")
    if animator then
        local animObj = Instance.new("Animation")
        animObj.AnimationId = "rbxassetid://" .. ZOMBIE_ANIMS.Fall
        local ok, track = pcall(function() return animator:LoadAnimation(animObj) end)
        if ok and track then
            flyAnimTrack = track
            flyAnimTrack.Priority = Enum.AnimationPriority.Action4
            flyAnimTrack.Looped = true
            flyAnimTrack:Play()
        end
    end

    flyRenderConn = RunService.RenderStepped:Connect(function()
        if not isFlying or not hrp or not hrp.Parent or not humanoid or humanoid.Health <= 0 then
            return
        end

        local speed = flySpeeds[flySpeedIndex]
        local camCF = Camera.CFrame
        local moveDir = humanoid.MoveDirection
        local moveVelocity = Vector3.zero

        if moveDir.Magnitude > 0.05 then
            local flatLook = Vector3.new(camCF.LookVector.X, 0, camCF.LookVector.Z)
            if flatLook.Magnitude > 0.001 then
                flatLook = flatLook.Unit
            else
                flatLook = Vector3.new(0, 0, -1)
            end
            local flatRight = Vector3.new(camCF.RightVector.X, 0, camCF.RightVector.Z).Unit

            local fDot = moveDir:Dot(flatLook)
            local rDot = moveDir:Dot(flatRight)

            moveVelocity = (camCF.LookVector * fDot + camCF.RightVector * rDot).Unit * speed
        end

        local vert = 0
        if UserInputService:IsKeyDown(Enum.KeyCode.Space) or humanoid.Jump then
            vert = vert + speed
        end
        if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) or UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then
            vert = vert - speed
        end

        flyBV.Velocity = moveVelocity + Vector3.new(0, vert, 0)
        flyBG.CFrame = camCF
    end)
end

local function stopFlying(character)
    isFlying = false

    if flyRenderConn then
        flyRenderConn:Disconnect()
        flyRenderConn = nil
    end

    if flyAnimTrack then
        pcall(function()
            flyAnimTrack:Stop(0.1)
            flyAnimTrack:Destroy()
        end)
        flyAnimTrack = nil
    end

    local hrp = character and character:FindFirstChild("HumanoidRootPart")
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")

    if hrp then
        for _, obj in ipairs(hrp:GetChildren()) do
            if obj:IsA("BodyVelocity") or obj:IsA("BodyGyro") then
                obj:Destroy()
            end
        end
        hrp.AssemblyLinearVelocity = Vector3.new(0, -2, 0)
        hrp.AssemblyAngularVelocity = Vector3.zero
    end

    if humanoid then
        humanoid.PlatformStand = false
        humanoid.AutoRotate = true
        humanoid:ChangeState(Enum.HumanoidStateType.Freefall)
    end
end

-- ====================================================================
-- 5. TOUCH FLING SUBSYSTEM (Safe Velocity Pulse Method)
-- ====================================================================
local function startFling(character)
    if isFlinging then return end
    local hrp = character and character:FindFirstChild("HumanoidRootPart")
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    if not hrp or not humanoid then return end

    isFlinging = true

    humanoid:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, false)
    humanoid:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)

    flingThread = task.spawn(function()
        while isFlinging do
            RunService.Heartbeat:Wait()
            if not isFlinging then break end

            local currentChar = LocalPlayer.Character
            local root = currentChar and currentChar:FindFirstChild("HumanoidRootPart")
            if root and root.Parent then
                local originalVel = root.AssemblyLinearVelocity

                -- Fysiikka-askel: piikitetään kontaktinopeus osumia varten
                root.AssemblyLinearVelocity = originalVel * 10000 + Vector3.new(0, 10000, 0)

                RunService.RenderStepped:Wait()

                -- Render-askel: palautetaan oma nopeus heti
                if root and root.Parent then
                    root.AssemblyLinearVelocity = originalVel
                end
            end
        end
    end)
end

local function stopFling(character)
    isFlinging = false
    if flingThread then
        task.cancel(flingThread)
        flingThread = nil
    end

    local hrp = character and character:FindFirstChild("HumanoidRootPart")
    if hrp then
        hrp.AssemblyLinearVelocity = Vector3.zero
        hrp.AssemblyAngularVelocity = Vector3.zero
    end
end

-- ====================================================================
-- 6. NOCLIP SUBSYSTEM (Stepped Loop Collision Controller)
-- ====================================================================
local function startNoclip(character)
    if isNoclipping then return end
    isNoclipping = true

    noclipConn = RunService.Stepped:Connect(function()
        if not isNoclipping or not character or not character.Parent then return end
        for _, part in ipairs(character:GetDescendants()) do
            if part:IsA("BasePart") and part.CanCollide then
                part.CanCollide = false
            end
        end
    end)
end

local function stopNoclip(character)
    isNoclipping = false
    if noclipConn then
        noclipConn:Disconnect()
        noclipConn = nil
    end

    if character and character.Parent then
        for _, part in ipairs(character:GetDescendants()) do
            if part:IsA("BasePart") then
                if part.Name == "HumanoidRootPart" or part.Name:find("Torso") or part.Name == "Head" then
                    part.CanCollide = true
                end
            end
        end
    end
end

-- ====================================================================
-- 7. INVISIBLE / DESYNC SUBSYSTEM (RootJoint Disconnect & Torso Anchor)
-- ====================================================================
local function getRootJoint(character)
    if not character then return nil, nil end
    local hrp = character:FindFirstChild("HumanoidRootPart")
    local lowerTorso = character:FindFirstChild("LowerTorso")
    local torso = character:FindFirstChild("Torso")
    local mainTorso = lowerTorso or torso

    if not hrp or not mainTorso then return nil, nil end

    local joint = hrp:FindFirstChild("RootJoint")
        or (lowerTorso and lowerTorso:FindFirstChild("Root"))
        or hrp:FindFirstChild("Root")
        or (torso and torso:FindFirstChild("RootJoint"))

    if not joint then
        for _, desc in ipairs(character:GetDescendants()) do
            if desc:IsA("Motor6D") and (desc.Part0 == hrp or desc.Part1 == hrp) then
                joint = desc
                break
            end
        end
    end

    return joint, mainTorso
end

local function startInvisible(character)
    if isInvisible then return end
    local joint, mainTorso = getRootJoint(character)
    if not joint or not mainTorso then
        notify("Invisible", "RootJoint missing.")
        return
    end

    isInvisible = true
    savedRootJoint = joint
    savedTorso = mainTorso

    -- Lukitaan näkyvä torso pisteeseen A ja katkaistaan nivel
    mainTorso.Anchored = true
    savedRootJoint.Enabled = false

    -- Asetetaan oma näkymä haamutilaan (transparency 0.5)
    for _, part in ipairs(character:GetDescendants()) do
        if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then
            part.Transparency = 0.5
        end
    end
end

local function stopInvisible(character)
    isInvisible = false

    if savedTorso and savedTorso.Parent then
        savedTorso.Anchored = false
        local hrp = character and character:FindFirstChild("HumanoidRootPart")
        if hrp then
            savedTorso.CFrame = hrp.CFrame
        end
    end

    if savedRootJoint and savedRootJoint.Parent then
        savedRootJoint.Enabled = true
    end

    if character and character.Parent then
        for _, part in ipairs(character:GetDescendants()) do
            if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then
                part.Transparency = 0
            end
        end
    end

    savedRootJoint = nil
    savedTorso = nil
end

-- ====================================================================
-- 8. CLICK / TOUCH TELEPORT SUBSYSTEM (Mobile & PC)
-- ====================================================================
local function performTeleport(targetPos)
    if tpDebounce or not targetPos then return end
    tpDebounce = true

    local character = LocalPlayer.Character
    local hrp = character and character:FindFirstChild("HumanoidRootPart")
    if hrp then
        hrp.CFrame = CFrame.new(targetPos + Vector3.new(0, 2, 0))
        hrp.AssemblyLinearVelocity = Vector3.zero
        hrp.AssemblyAngularVelocity = Vector3.zero
    end

    task.delay(0.15, function()
        tpDebounce = false
    end)
end

local function screenToWorld(x, y)
    local ray = Camera:ViewportPointToRay(x, y)
    local params = RaycastParams.new()
    params.FilterDescendantsInstances = { LocalPlayer.Character }
    params.FilterType = Enum.RaycastFilterType.Exclude

    local hit = Workspace:Raycast(ray.Origin, ray.Direction * 3000, params)
    if hit then
        return hit.Position
    end
    return ray.Origin + (ray.Direction * 150)
end

-- ====================================================================
-- 9. TOOL GENERATION (5 Modular Backpack Tools)
-- ====================================================================
local function createTools()
    local backpack = LocalPlayer:WaitForChild("Backpack", 8)
    if not backpack then return end

    for _, item in ipairs(backpack:GetChildren()) do
        if item:IsA("Tool") and (
            item.Name:find("Fly") or 
            item.Name:find("Click TP") or 
            item.Name:find("Fling") or 
            item.Name:find("Noclip") or 
            item.Name:find("Invisible")
        ) then
            item:Destroy()
        end
    end

    -- TOOL 1: FLY
    local flyTool = Instance.new("Tool")
    flyTool.Name = "Fly [" .. (isFlying and "Active" or "Inactive") .. "]"
    flyTool.RequiresHandle = false
    flyTool.CanBeDropped = false

    flyTool.Equipped:Connect(function()
        if not isFlying then
            startFlying(LocalPlayer.Character)
            flyTool.Name = "Fly [Active]"
            notify("Fly", "Active. Speed: " .. flySpeeds[flySpeedIndex])
        else
            stopFlying(LocalPlayer.Character)
            flyTool.Name = "Fly [Inactive]"
            notify("Fly", "Inactive.")
        end
    end)

    flyTool.Activated:Connect(function()
        if isFlying then
            flySpeedIndex = (flySpeedIndex % #flySpeeds) + 1
            notify("Fly", "Speed: " .. flySpeeds[flySpeedIndex])
        end
    end)

    flyTool.Parent = backpack

    -- TOOL 2: CLICK TP
    local tpTool = Instance.new("Tool")
    tpTool.Name = "Click TP"
    tpTool.RequiresHandle = false
    tpTool.CanBeDropped = false

    local touchConn = nil

    tpTool.Equipped:Connect(function()
        touchConn = UserInputService.TouchTapInWorld:Connect(function(touchPos, gameProcessed)
            if not gameProcessed and tpTool.Parent == LocalPlayer.Character then
                local worldPos = screenToWorld(touchPos.X, touchPos.Y)
                performTeleport(worldPos)
            end
        end)
    end)

    tpTool.Unequipped:Connect(function()
        if touchConn then
            touchConn:Disconnect()
            touchConn = nil
        end
    end)

    tpTool.Activated:Connect(function()
        local mouse = LocalPlayer:GetMouse()
        if mouse and mouse.Hit then
            performTeleport(mouse.Hit.Position)
        end
    end)

    tpTool.Parent = backpack

    -- TOOL 3: FLING
    local flingTool = Instance.new("Tool")
    flingTool.Name = "Fling [" .. (isFlinging and "Active" or "Inactive") .. "]"
    flingTool.RequiresHandle = false
    flingTool.CanBeDropped = false

    flingTool.Equipped:Connect(function()
        if not isFlinging then
            startFling(LocalPlayer.Character)
            flingTool.Name = "Fling [Active]"
            notify("Fling", "Active.")
        else
            stopFling(LocalPlayer.Character)
            flingTool.Name = "Fling [Inactive]"
            notify("Fling", "Inactive.")
        end
    end)

    flingTool.Parent = backpack

    -- TOOL 4: NOCLIP
    local noclipTool = Instance.new("Tool")
    noclipTool.Name = "Noclip [" .. (isNoclipping and "Active" or "Inactive") .. "]"
    noclipTool.RequiresHandle = false
    noclipTool.CanBeDropped = false

    noclipTool.Equipped:Connect(function()
        if not isNoclipping then
            startNoclip(LocalPlayer.Character)
            noclipTool.Name = "Noclip [Active]"
            notify("Noclip", "Active.")
        else
            stopNoclip(LocalPlayer.Character)
            noclipTool.Name = "Noclip [Inactive]"
            notify("Noclip", "Inactive.")
        end
    end)

    noclipTool.Parent = backpack

    -- TOOL 5: INVISIBLE (DESYNC)
    local invisTool = Instance.new("Tool")
    invisTool.Name = "Invisible [" .. (isInvisible and "Active" or "Inactive") .. "]"
    invisTool.RequiresHandle = false
    invisTool.CanBeDropped = false

    invisTool.Equipped:Connect(function()
        if not isInvisible then
            startInvisible(LocalPlayer.Character)
            invisTool.Name = "Invisible [Active]"
            notify("Invisible", "Active.")
        else
            stopInvisible(LocalPlayer.Character)
            invisTool.Name = "Invisible [Inactive]"
            notify("Invisible", "Inactive.")
        end
    end)

    invisTool.Parent = backpack
end

-- ====================================================================
-- 10. INITIALIZATION & RESPAWN
-- ====================================================================
local function init(character)
    stopFlying(character)
    stopFling(character)
    stopNoclip(character)
    stopInvisible(character)
    applyAnimations(character)
    createTools()
end

if LocalPlayer.Character then
    task.spawn(function()
        init(LocalPlayer.Character)
    end)
end

LocalPlayer.CharacterAdded:Connect(function(newCharacter)
    task.wait(0.3)
    init(newCharacter)
end)

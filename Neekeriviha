-- ====================================================================
-- 3. MOTOR6D CACHE & UNIVERSAL KINEMATICS (R6 & R15)
-- ====================================================================
local JointCache = {
    IsR15 = false,
    RootJoint = nil,
    Waist = nil,
    Neck = nil,
    RightShoulder = nil,
    LeftShoulder = nil,
    RightElbow = nil,
    LeftElbow = nil,
    RightHip = nil,
    LeftHip = nil,
    RightKnee = nil,
    LeftKnee = nil
}

local procAnimConnection = nil
local rotorAngle = 0
local tailRotorAngle = 0
local rabbitHopTimer = 0

local function cacheJoints(character)
    for k in pairs(JointCache) do
        JointCache[k] = nil
    end
    if not character then return end

    character:WaitForChild("HumanoidRootPart", 5)
    local hum = character:WaitForChild("Humanoid", 5)
    JointCache.IsR15 = (hum and hum.RigType == Enum.HumanoidRigType.R15) or (character:FindFirstChild("UpperTorso") ~= nil)

    if hum and defaultHipHeight == nil then
        defaultHipHeight = hum.HipHeight
    end

    local waited = 0
    while waited < 2 do
        local count = 0
        for _, desc in ipairs(character:GetDescendants()) do
            if desc:IsA("Motor6D") then count = count + 1 end
        end
        if count >= 4 then break end
        task.wait(0.1)
        waited = waited + 0.1
    end

    for _, desc in ipairs(character:GetDescendants()) do
        if desc:IsA("Motor6D") then
            local n = desc.Name:lower():gsub("%s+", ""):gsub("_", "")
            if n == "rootjoint" or n == "root" then
                JointCache.RootJoint = desc
            elseif n == "waist" then
                JointCache.Waist = desc
            elseif n == "neck" then
                JointCache.Neck = desc
            elseif n:find("right") and (n:find("shoulder") or n:find("arm")) and not n:find("elbow") and not n:find("wrist") then
                JointCache.RightShoulder = desc
            elseif n:find("left") and (n:find("shoulder") or n:find("arm")) and not n:find("elbow") and not n:find("wrist") then
                JointCache.LeftShoulder = desc
            elseif n:find("right") and n:find("elbow") then
                JointCache.RightElbow = desc
            elseif n:find("left") and n:find("elbow") then
                JointCache.LeftElbow = desc
            elseif n:find("right") and (n:find("hip") or n:find("leg")) and not n:find("knee") and not n:find("ankle") then
                JointCache.RightHip = desc
            elseif n:find("left") and (n:find("hip") or n:find("leg")) and not n:find("knee") and not n:find("ankle") then
                JointCache.LeftHip = desc
            elseif n:find("right") and n:find("knee") then
                JointCache.RightKnee = desc
            elseif n:find("left") and n:find("knee") then
                JointCache.LeftKnee = desc
            end
        end
    end
end

local function setJoint(joint, desiredCF)
    if not joint or not joint.Parent then return end
    local c0 = joint.C0
    local c0Rot = c0 - c0.Position
    joint.Transform = c0Rot:Inverse() * desiredCF * c0Rot
end

local function resetTransforms()
    for _, joint in pairs(JointCache) do
        if typeof(joint) == "Instance" and joint:IsA("Motor6D") and joint.Parent then
            pcall(function()
                joint.Transform = CFrame.identity
            end)
        end
    end
end

-- ====================================================================
-- 4. PURE 3D FLIGHT SUBSYSTEM (Helicopter & Fly)
-- ====================================================================
local function startFlightPhysics(character)
    if flyRenderConn then return end
    local hrp = character and character:FindFirstChild("HumanoidRootPart")
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    if not hrp or not humanoid then return end

    for _, obj in ipairs(hrp:GetChildren()) do
        if obj:IsA("BodyVelocity") or obj:IsA("BodyGyro") then
            obj:Destroy()
        end
    end

    flyBV = Instance.new("BodyVelocity")
    flyBV.Name = "CustomFlightBV"
    flyBV.Velocity = Vector3.zero
    flyBV.MaxForce = Vector3.new(9e9, 9e9, 9e9)
    flyBV.Parent = hrp

    flyBG = Instance.new("BodyGyro")
    flyBG.Name = "CustomFlightBG"
    flyBG.P = 9e4
    flyBG.MaxTorque = Vector3.new(9e9, 9e9, 9e9)
    flyBG.CFrame = hrp.CFrame
    flyBG.Parent = hrp

    flyRenderConn = RunService.RenderStepped:Connect(function()
        if not hrp or not hrp.Parent or not humanoid or humanoid.Health <= 0 then
            return
        end

        local speed = flySpeeds[flySpeedIndex]
        local cam = getCamera()
        local camCF = cam and cam.CFrame or CFrame.identity
        local moveDir = humanoid.MoveDirection
        local moveVelocity = Vector3.zero

        if moveDir.Magnitude > 0.05 then
            local flatLook = Vector3.new(camCF.LookVector.X, 0, camCF.LookVector.Z)
            flatLook = (flatLook.Magnitude > 0.001 and flatLook.Unit) or Vector3.new(0, 0, -1)
            local flatRight = Vector3.new(camCF.RightVector.X, 0, camCF.RightVector.Z).Unit
            moveVelocity = (camCF.LookVector * moveDir:Dot(flatLook) + camCF.RightVector * moveDir:Dot(flatRight)).Unit * speed
        end

        local vert = 0
        if UserInputService:IsKeyDown(Enum.KeyCode.Space) or humanoid.Jump then
            vert = vert + speed
        end
        if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) or UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then
            vert = vert - speed
        end

        -- Helikopterin pehmeä leijuntakeinunta ilmassa
        if currentAnimMode == "Helicopter" and moveVelocity.Magnitude < 0.1 and vert == 0 then
            vert = math.sin(os.clock() * 3) * 1.5
        end

        flyBV.Velocity = moveVelocity + Vector3.new(0, vert, 0)
        flyBG.CFrame = camCF
    end)
end

local function stopFlightPhysics(character)
    if flyRenderConn then
        flyRenderConn:Disconnect()
        flyRenderConn = nil
    end

    local hrp = character and character:FindFirstChild("HumanoidRootPart")
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")

    if hrp then
        for _, obj in ipairs(hrp:GetChildren()) do
            if obj:IsA("BodyVelocity") or obj:IsA("BodyGyro") then
                obj:Destroy()
            end
        end
        hrp.AssemblyLinearVelocity = Vector3.new(0, -2, 0)
        hrp.AssemblyAngularVelocity = Vector3.zero
    end

    if humanoid then
        humanoid.PlatformStand = false
        humanoid.AutoRotate = true
        humanoid:ChangeState(Enum.HumanoidStateType.Freefall)
    end
end

-- ====================================================================
-- 5. PROCEDURAL KINEMATICS ENGINE (Raajojen upotus & FE-liikkeet)
-- ====================================================================
local function startProceduralEngine(character)
    if procAnimConnection then
        procAnimConnection:Disconnect()
        procAnimConnection = nil
    end

    if not character then return end
    local humanoid = character:WaitForChild("Humanoid", 5)
    local hrp = character:WaitForChild("HumanoidRootPart", 5)
    if not humanoid or not hrp then return end

    cacheJoints(character)

    local animate = character:FindFirstChild("Animate")
    if animate then
        animate.Enabled = (currentAnimMode == "None")
    end

    local animator = humanoid:FindFirstChildOfClass("Animator")
    if animator and currentAnimMode ~= "None" then
        for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
            track:Stop(0)
        end
    end

    procAnimConnection = RunService.Stepped:Connect(function(timeArg, deltaArg)
        if isTerminated or not character or not character.Parent or not humanoid or not humanoid.Parent or humanoid.Health <= 0 then
            return
        end

        local globalTime = (typeof(timeArg) == "number" and timeArg) or os.clock()
        local deltaTime = (typeof(deltaArg) == "number" and deltaArg) or 0.016

        local isMoving = false
        pcall(function() isMoving = humanoid.MoveDirection.Magnitude > 0.05 end)
        local speed = 16
        pcall(function() speed = humanoid.WalkSpeed end)

        local root = JointCache.RootJoint
        local waist = JointCache.Waist
        local neck = JointCache.Neck
        local rShoulder = JointCache.RightShoulder
        local lShoulder = JointCache.LeftShoulder
        local rElbow = JointCache.RightElbow
        local lElbow = JointCache.LeftElbow
        local rHip = JointCache.RightHip
        local lHip = JointCache.LeftHip
        local rKnee = JointCache.RightKnee
        local lKnee = JointCache.LeftKnee

        -- =============================================================
        -- 1. HELIKOPTERI (Täysi 3D-lento, upotetut roottorilavat & perä)
        -- =============================================================
        if currentAnimMode == "Helicopter" then
            local isAirborne = (isFlying or currentAnimMode == "Helicopter")
            local spinMult = (isMoving and 38) or (isAirborne and 30) or 16
            rotorAngle = (rotorAngle + deltaTime * spinMult) % (math.pi * 2)
            tailRotorAngle = (tailRotorAngle + deltaTime * spinMult * 1.5) % (math.pi * 2)

            local forwardTilt = isMoving and math.rad(-16) or math.rad(0)
            local hoverSway = math.sin(globalTime * 2.8) * math.rad(2)

            -- Runko vaakatasoon menosuuntaan
            setJoint(root, CFrame.Angles(math.rad(-88) + forwardTilt, hoverSway, 0))
            if waist then setJoint(waist, CFrame.identity) end
            setJoint(neck, CFrame.Angles(math.rad(82) - forwardTilt, 0, 0))

            -- PÄÄROOTTORI: Kädet upotettu suoraan selän päälle kompaktiksi potkuriksi
            setJoint(rShoulder, CFrame.new(-0.85, 0, 0.45) * CFrame.Angles(0, 0, rotorAngle + (math.pi / 2)))
            setJoint(lShoulder, CFrame.new(0.85, 0, 0.45) * CFrame.Angles(0, 0, rotorAngle - (math.pi / 2)))

            -- PERÄPUOMI & PYSTYROOTTORI: Oikea jalka puomina, vasen jalka pystyroottorina
            setJoint(rHip, CFrame.new(0, 0.1, 0) * CFrame.Angles(math.rad(-3), 0, 0))
            setJoint(lHip, CFrame.new(0.3, -1.6, 0) * CFrame.Angles(tailRotorAngle, 0, 0))

            if rElbow then setJoint(rElbow, CFrame.identity) end
            if lElbow then setJoint(lElbow, CFrame.identity) end
            if rKnee then setJoint(rKnee, CFrame.identity) end
            if lKnee then setJoint(lKnee, CFrame.identity) end

        -- =============================================================
        -- 2. KOIRA (Upotetut raajat, matala asento maassa & aito ravi)
        -- =============================================================
        elseif currentAnimMode == "Dog" then
            local trotT = globalTime * (speed * 0.75)
            local diag1 = math.sin(trotT) * math.rad(24)
            local diag2 = -diag1
            local spineBob = isMoving and (math.sin(trotT * 2) * math.rad(2.5)) or 0

            -- Vartalo laskettu matalalle maahan
            setJoint(root, CFrame.new(0, -0.85, 0) * CFrame.Angles(math.rad(-85) + spineBob, 0, 0))
            if waist then setJoint(waist, CFrame.identity) end

            local headTurn = isMoving and (math.sin(trotT) * math.rad(4)) or (math.sin(globalTime * 1.5) * math.rad(8))
            setJoint(neck, CFrame.new(0, 0, 0.2) * CFrame.Angles(math.rad(80), headTurn, 0))

            -- Raajat upotettu torson sisään, muodostaen lyhyet, luonnolliset tassut
            if isMoving then
                setJoint(rShoulder, CFrame.new(0, -0.3, -0.15) * CFrame.Angles(math.rad(72) + diag1, 0, math.rad(5)))
                setJoint(lShoulder, CFrame.new(0, -0.3, -0.15) * CFrame.Angles(math.rad(72) + diag2, 0, math.rad(-5)))
                setJoint(rHip, CFrame.new(0, 0.2, 0.15) * CFrame.Angles(math.rad(74) + diag2, 0, math.rad(5)))
                setJoint(lHip, CFrame.new(0, 0.2, 0.15) * CFrame.Angles(math.rad(74) + diag1, 0, math.rad(-5)))
            else
                local pant = math.sin(globalTime * 3.5) * math.rad(1.5)
                setJoint(rShoulder, CFrame.new(0, -0.3, -0.15) * CFrame.Angles(math.rad(72) + pant, 0, math.rad(5)))
                setJoint(lShoulder, CFrame.new(0, -0.3, -0.15) * CFrame.Angles(math.rad(72) + pant, 0, math.rad(-5)))
                setJoint(rHip, CFrame.new(0, 0.2, 0.15) * CFrame.Angles(math.rad(74) + pant, 0, math.rad(5)))
                setJoint(lHip, CFrame.new(0, 0.2, 0.15) * CFrame.Angles(math.rad(74) + pant, 0, math.rad(-5)))
            end

            -- Kyynärpäät ja polvet koukussa eläimen anatomian mukaisesti
            if rElbow then setJoint(rElbow, CFrame.Angles(math.rad(-45), 0, 0)) end
            if lElbow then setJoint(lElbow, CFrame.Angles(math.rad(-45), 0, 0)) end
            if rKnee then setJoint(rKnee, CFrame.Angles(math.rad(50), 0, 0)) end
            if lKnee then setJoint(lKnee, CFrame.Angles(math.rad(50), 0, 0)) end

        -- =============================================================
        -- 3. PUPU (Upotetut raajat, kyyristynyt pallo & maahan osuva loikka)
        -- =============================================================
        elseif currentAnimMode == "Rabbit" then
            if isMoving then
                rabbitHopTimer = (rabbitHopTimer + deltaTime * (speed * 0.65)) % (math.pi * 2)
                local hopArc = math.abs(math.sin(rabbitHopTimer))
                local hopPitch = math.sin(rabbitHopTimer) * math.rad(18)
                local kick = math.sin(rabbitHopTimer)

                -- Ponnistus maasta ja pehmeä laskeutuminen takaisin maahan
                setJoint(root, CFrame.new(0, -0.65 + (hopArc * 0.75), 0) * CFrame.Angles(math.rad(-38) + hopPitch, 0, 0))
                if waist then setJoint(waist, CFrame.identity) end
                setJoint(neck, CFrame.Angles(math.rad(32) - hopPitch * 0.5, 0, 0))

                setJoint(rShoulder, CFrame.new(0, -0.35, -0.2) * CFrame.Angles(math.rad(52) + kick * math.rad(16), 0, math.rad(-14)))
                setJoint(lShoulder, CFrame.new(0, -0.35, -0.2) * CFrame.Angles(math.rad(52) + kick * math.rad(16), 0, math.rad(14)))

                local legKick = (kick < 0 and -kick * math.rad(46)) or (kick * math.rad(14))
                setJoint(rHip, CFrame.new(0, 0.25, 0.15) * CFrame.Angles(math.rad(-26) - legKick, 0, math.rad(6)))
                setJoint(lHip, CFrame.new(0, 0.25, 0.15) * CFrame.Angles(math.rad(-26) - legKick, 0, math.rad(-6)))
            else
                local twitch = math.sin(globalTime * 22) * math.rad(2.5)
                local breath = math.sin(globalTime * 4) * math.rad(1.5)

                -- Kompakti kyyristynyt pupu maassa
                setJoint(root, CFrame.new(0, -0.75, 0) * CFrame.Angles(math.rad(-42) + breath, 0, 0))
                if waist then setJoint(waist, CFrame.identity) end
                setJoint(neck, CFrame.new(0, -0.15, 0.1) * CFrame.Angles(math.rad(36) + twitch, twitch * 0.5, 0))

                -- Eturaajat taitettu rinnan sisään söpöiksi pikkutassuiksi
                setJoint(rShoulder, CFrame.new(0, -0.35, -0.25) * CFrame.Angles(math.rad(55), 0, math.rad(-15)))
                setJoint(lShoulder, CFrame.new(0, -0.35, -0.25) * CFrame.Angles(math.rad(55), 0, math.rad(15)))
                setJoint(rHip, CFrame.new(0, 0.25, 0.15) * CFrame.Angles(math.rad(-34), 0, math.rad(6)))
                setJoint(lHip, CFrame.new(0, 0.25, 0.15) * CFrame.Angles(math.rad(-34), 0, math.rad(-6)))
            end

            if rElbow then setJoint(rElbow, CFrame.Angles(math.rad(-55), 0, 0)) end
            if lElbow then setJoint(lElbow, CFrame.Angles(math.rad(-55), 0, 0)) end
            if rKnee then setJoint(rKnee, CFrame.Angles(math.rad(50), 0, 0)) end
            if lKnee then setJoint(lKnee, CFrame.Angles(math.rad(50), 0, 0)) end

        -- =============================================================
        -- 4. PSYCHO MONSTER (Syvällinen kauhuanimaatio, mikrovapina & glitchit)
        -- =============================================================
        elseif currentAnimMode == "Psycho" then
            -- Monitaajuinen lihasvapina (high-frequency neuro-muscular tremor)
            local tremor = (math.sin(globalTime * 38) * 0.65 + math.cos(globalTime * 27) * 0.35 + math.sin(globalTime * 58) * 0.2) * math.rad(5.5)
            local twitchCycle = math.sin(globalTime * 2.2)
            local suddenSnap = (twitchCycle > 0.94 and math.sin(globalTime * 40) * math.rad(16) or 0)
            local breath = (math.sin(globalTime * 2.3) * 0.7 + math.cos(globalTime * 4.1) * 0.3) * math.rad(2.5)

            if isFlying then
                setJoint(root, CFrame.Angles(math.rad(14), 0, math.rad(-6)))
                if waist then setJoint(waist, CFrame.identity) end
                setJoint(neck, CFrame.Angles(math.rad(26) + suddenSnap, math.rad(22), math.rad(-20)))
                setJoint(rShoulder, CFrame.Angles(math.rad(28) + tremor, 0, math.rad(20) + tremor))
                setJoint(lShoulder, CFrame.Angles(math.rad(-14) + tremor * 0.4, 0, math.rad(-18)))
                setJoint(rHip, CFrame.Angles(math.rad(8), 0, math.rad(6)))
                setJoint(lHip, CFrame.Angles(-math.rad(10), 0, math.rad(-6)))
            elseif isMoving then
                if speed > 18 then
                    -- Feral Predator Sprint (45 asteen ryntäys kynnet ojossa)
                    local runT = globalTime * (speed * 0.8)
                    local stride = math.sin(runT) * math.rad(45)

                    setJoint(root, CFrame.Angles(math.rad(-30), 0, math.sin(runT) * math.rad(5)))
                    if waist then setJoint(waist, CFrame.identity) end
                    setJoint(neck, CFrame.Angles(math.rad(24) + suddenSnap, math.sin(globalTime * 20) * math.rad(6), 0))
                    setJoint(rShoulder, CFrame.Angles(math.rad(38) + tremor, 0, math.rad(16)))
                    setJoint(lShoulder, CFrame.Angles(math.rad(28) - tremor, 0, math.rad(-16)))
                    setJoint(rHip, CFrame.Angles(stride, 0, 0))
                    setJoint(lHip, CFrame.Angles(-stride, 0, 0))
                else
                    -- Epäsymmetrinen tuskainen ontuminen ja laahaus
                    local walkT = globalTime * 6
                    local step = math.sin(walkT)

                    -- Vartalo nytkähtää raskaalla oikealla askeleella alaspäin
                    setJoint(root, CFrame.new(0, -math.abs(step) * 0.2, 0) * CFrame.Angles(math.rad(-14), step * math.rad(4), math.rad(-6)))
                    if waist then setJoint(waist, CFrame.identity) end
                    setJoint(neck, CFrame.Angles(math.rad(18) + suddenSnap, math.rad(26) + suddenSnap, math.rad(-22)))
                    -- Oikea käsi ojentuu etuviistossa vapisten, vasen roikkuu velttona
                    setJoint(rShoulder, CFrame.Angles(math.rad(22) + tremor + (step * math.rad(10)), 0, math.rad(14) + tremor))
                    setJoint(lShoulder, CFrame.Angles(math.rad(-12) - (step * math.rad(6)), 0, math.rad(-14)))
                    setJoint(rHip, CFrame.Angles(step * math.rad(38), 0, math.rad(4)))
                    setJoint(lHip, CFrame.Angles(-step * math.rad(18), 0, math.rad(-4)))
                end
            else
                -- Horror Idle: Luonnoton pään asento & voimakkaasti vapiseva matala käsi
                setJoint(root, CFrame.Angles(math.rad(-12) + breath, math.sin(globalTime * 1.5) * math.rad(3), math.rad(-5)))
                if waist then setJoint(waist, CFrame.identity) end
                setJoint(neck, CFrame.Angles(math.rad(16) + suddenSnap, math.rad(28) + suddenSnap, math.rad(-26)))
                -- Oikea käsi roikkuu luonnottomasti alhaalla ja tärisee
                setJoint(rShoulder, CFrame.Angles(math.rad(22) + tremor, 0, math.rad(12) + tremor))
                -- Vasen käsi roikkuu täysin kuolleena ja velttona
                setJoint(lShoulder, CFrame.Angles(math.rad(-8), 0, math.rad(-14) + (tremor * 0.2)))
                setJoint(rHip, CFrame.Angles(math.rad(-4), 0, math.rad(4)))
                setJoint(lHip, CFrame.Angles(math.rad(4), 0, math.rad(-4)))
            end

            if rElbow then setJoint(rElbow, CFrame.Angles(math.rad(-26) + tremor, 0, 0)) end
            if lElbow then setJoint(lElbow, CFrame.Angles(math.rad(-8), 0, 0)) end
            if rKnee then setJoint(rKnee, CFrame.identity) end
            if lKnee then setJoint(lKnee, CFrame.identity) end
        end
    end)
end

local function setAnimationMode(newMode)
    currentAnimMode = newMode
    resetTransforms()

    local char = LocalPlayer.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")

    -- Varmistetaan että hahmo ei leiju ilman syytä
    if hum then
        hum.HipHeight = defaultHipHeight or 0
    end

    if newMode == "Helicopter" then
        startFlightPhysics(char)
    else
        if not isFlying then
            stopFlightPhysics(char)
        end
    end

    if char then
        local animate = char:FindFirstChild("Animate")
        if animate then
            animate.Enabled = (newMode == "None")
        end
    end
end


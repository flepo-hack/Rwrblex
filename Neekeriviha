-- ====================================================================
local JointCache = {
    IsR15 = false,
    RootJoint = nil,
    Waist = nil,
    Neck = nil,
    RightShoulder = nil,
    LeftShoulder = nil,
    RightElbow = nil,
    LeftElbow = nil,
    RightHip = nil,
    LeftHip = nil,
    RightKnee = nil,
    LeftKnee = nil
}

local procAnimConnection = nil
local rotorAngle = 0
local tailRotorAngle = 0
local rabbitHopTimer = 0

local function cacheJoints(character)
    for k in pairs(JointCache) do
        JointCache[k] = nil
    end
    if not character then return end

    character:WaitForChild("HumanoidRootPart", 5)
    local hum = character:WaitForChild("Humanoid", 5)
    JointCache.IsR15 = (hum and hum.RigType == Enum.HumanoidRigType.R15) or (character:FindFirstChild("UpperTorso") ~= nil)

    if hum and defaultHipHeight == nil then
        defaultHipHeight = hum.HipHeight
    end

    local waited = 0
    while waited < 2 do
        local count = 0
        for _, desc in ipairs(character:GetDescendants()) do
            if desc:IsA("Motor6D") then count = count + 1 end
        end
        if count >= 4 then break end
        task.wait(0.1)
        waited = waited + 0.1
    end

    for _, desc in ipairs(character:GetDescendants()) do
        if desc:IsA("Motor6D") then
            local n = desc.Name:lower():gsub("%s+", ""):gsub("_", "")
            if n == "rootjoint" or n == "root" then
                JointCache.RootJoint = desc
            elseif n == "waist" then
                JointCache.Waist = desc
            elseif n == "neck" then
                JointCache.Neck = desc
            elseif n:find("right") and (n:find("shoulder") or n:find("arm")) and not n:find("elbow") and not n:find("wrist") then
                JointCache.RightShoulder = desc
            elseif n:find("left") and (n:find("shoulder") or n:find("arm")) and not n:find("elbow") and not n:find("wrist") then
                JointCache.LeftShoulder = desc
            elseif n:find("right") and n:find("elbow") then
                JointCache.RightElbow = desc
            elseif n:find("left") and n:find("elbow") then
                JointCache.LeftElbow = desc
            elseif n:find("right") and (n:find("hip") or n:find("leg")) and not n:find("knee") and not n:find("ankle") then
                JointCache.RightHip = desc
            elseif n:find("left") and (n:find("hip") or n:find("leg")) and not n:find("knee") and not n:find("ankle") then
                JointCache.LeftHip = desc
            elseif n:find("right") and n:find("knee") then
                JointCache.RightKnee = desc
            elseif n:find("left") and n:find("knee") then
                JointCache.LeftKnee = desc
            end
        end
    end
end

local function setJoint(joint, desiredCF)
    if not joint or not joint.Parent then return end
    local c0 = joint.C0
    local c0Rot = c0 - c0.Position
    joint.Transform = c0Rot:Inverse() * desiredCF * c0Rot
end

local function resetTransforms()
    for _, joint in pairs(JointCache) do
        if typeof(joint) == "Instance" and joint:IsA("Motor6D") and joint.Parent then
            pcall(function()
                joint.Transform = CFrame.identity
            end)
        end
    end
end

-- ====================================================================
-- 4. PURE 3D FLIGHT SUBSYSTEM (Helicopter & Fly)
-- ====================================================================
local function startFlightPhysics(character)
    if flyRenderConn then return end
    local hrp = character and character:FindFirstChild("HumanoidRootPart")
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    if not hrp or not humanoid then return end

    for _, obj in ipairs(hrp:GetChildren()) do
        if obj:IsA("BodyVelocity") or obj:IsA("BodyGyro") then
            obj:Destroy()
        end
    end

    flyBV = Instance.new("BodyVelocity")
    flyBV.Name = "CustomFlightBV"
    flyBV.Velocity = Vector3.zero
    flyBV.MaxForce = Vector3.new(9e9, 9e9, 9e9)
    flyBV.Parent = hrp

    flyBG = Instance.new("BodyGyro")
    flyBG.Name = "CustomFlightBG"
    flyBG.P = 9e4
    flyBG.MaxTorque = Vector3.new(9e9, 9e9, 9e9)
    flyBG.CFrame = hrp.CFrame
    flyBG.Parent = hrp

    flyRenderConn = RunService.RenderStepped:Connect(function()
        if not hrp or not hrp.Parent or not humanoid or humanoid.Health <= 0 then
            return
        end

        local speed = flySpeeds[flySpeedIndex]
        local cam = getCamera()
        local camCF = cam and cam.CFrame or CFrame.identity
        local moveDir = humanoid.MoveDirection
        local moveVelocity = Vector3.zero

        if moveDir.Magnitude > 0.05 then
            local flatLook = Vector3.new(camCF.LookVector.X, 0, camCF.LookVector.Z)
            flatLook = (flatLook.Magnitude > 0.001 and flatLook.Unit) or Vector3.new(0, 0, -1)
            local flatRight = Vector3.new(camCF.RightVector.X, 0, camCF.RightVector.Z).Unit
            moveVelocity = (camCF.LookVector * moveDir:Dot(flatLook) + camCF.RightVector * moveDir:Dot(flatRight)).Unit * speed
        end

        local vert = 0
        if UserInputService:IsKeyDown(Enum.KeyCode.Space) or humanoid.Jump then
            vert = vert + speed
        end
        if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) or UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then
            vert = vert - speed
        end

        if currentAnimMode == "Helicopter" and moveVelocity.Magnitude < 0.1 and vert == 0 then
            vert = math.sin(os.clock() * 3) * 1.5
        end

        flyBV.Velocity = moveVelocity + Vector3.new(0, vert, 0)
        flyBG.CFrame = camCF
    end)
end

local function stopFlightPhysics(character)
    if flyRenderConn then
        flyRenderConn:Disconnect()
        flyRenderConn = nil
    end

    local hrp = character and character:FindFirstChild("HumanoidRootPart")
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")

    if hrp then
        for _, obj in ipairs(hrp:GetChildren()) do
            if obj:IsA("BodyVelocity") or obj:IsA("BodyGyro") then
                obj:Destroy()
            end
        end
        hrp.AssemblyLinearVelocity = Vector3.new(0, -2, 0)
        hrp.AssemblyAngularVelocity = Vector3.zero
    end

    if humanoid then
        humanoid.PlatformStand = false
        humanoid.AutoRotate = true
        humanoid:ChangeState(Enum.HumanoidStateType.Freefall)
    end
end

-- ====================================================================
-- 5. PROCEDURAL KINEMATICS ANIMATION ENGINE (100% FE)
-- ====================================================================
local function startProceduralEngine(character)
    if procAnimConnection then
        procAnimConnection:Disconnect()
        procAnimConnection = nil
    end

    if not character then return end
    local humanoid = character:WaitForChild("Humanoid", 5)
    local hrp = character:WaitForChild("HumanoidRootPart", 5)
    if not humanoid or not hrp then return end

    cacheJoints(character)

    local animate = character:FindFirstChild("Animate")
    if animate then
        animate.Enabled = (currentAnimMode == "None")
    end

    local animator = humanoid:FindFirstChildOfClass("Animator")
    if animator and currentAnimMode ~= "None" then
        for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
            track:Stop(0)
        end
    end

    procAnimConnection = RunService.Stepped:Connect(function(timeArg, deltaArg)
        if isTerminated or not character or not character.Parent or not humanoid or not humanoid.Parent or humanoid.Health <= 0 then
            return
        end

        local globalTime = (typeof(timeArg) == "number" and timeArg) or os.clock()
        local deltaTime = (typeof(deltaArg) == "number" and deltaArg) or 0.016

        local isMoving = false
        pcall(function() isMoving = humanoid.MoveDirection.Magnitude > 0.05 end)
        local speed = 16
        pcall(function() speed = humanoid.WalkSpeed end)
        local isFalling = (humanoid:GetState() == Enum.HumanoidStateType.Freefall)
        local isJumping = humanoid.Jump or isFalling

        -- Pieni luonnollinen lisävauhti liikkeelle lähdettäessä (+3.5 WalkSpeed)
        if isMoving and not isScaryFlingActive and not isFlying and currentAnimMode ~= "Helicopter" then
            continuousMoveTime = continuousMoveTime + deltaTime
            if humanoid.WalkSpeed <= 16 then
                humanoid.WalkSpeed = 19.5
            end
        else
            if not isMoving and not isScaryFlingActive and not isFlying and currentAnimMode ~= "Helicopter" then
                if humanoid.WalkSpeed > 16 and humanoid.WalkSpeed <= 20 then
                    humanoid.WalkSpeed = 16
                end
            end
            continuousMoveTime = 0
        end
        local isAgonySprinting = (continuousMoveTime >= 1.5)

        local root = JointCache.RootJoint
        local waist = JointCache.Waist
        local neck = JointCache.Neck
        local rShoulder = JointCache.RightShoulder
        local lShoulder = JointCache.LeftShoulder
        local rElbow = JointCache.RightElbow
        local lElbow = JointCache.LeftElbow
        local rHip = JointCache.RightHip
        local lHip = JointCache.LeftHip
        local rKnee = JointCache.RightKnee
        local lKnee = JointCache.LeftKnee

        -- =============================================================
        -- 1. HELIKOPTERI (Näkyvä selkämasto, nostetut lavat & pystyperä)
        -- =============================================================
        if currentAnimMode == "Helicopter" then
            local isAirborne = (isFlying or currentAnimMode == "Helicopter")
            local spinMult = (isMoving and 40) or (isAirborne and 32) or 16
            rotorAngle = (rotorAngle + deltaTime * spinMult) % (math.pi * 2)
            tailRotorAngle = (tailRotorAngle + deltaTime * spinMult * 1.6) % (math.pi * 2)

            local forwardTilt = isMoving and math.rad(-16) or math.rad(0)
            local hoverSway = math.sin(globalTime * 2.8) * math.rad(2)

            -- Runko vaakatasoon menosuuntaan
            setJoint(root, CFrame.Angles(math.rad(-88) + forwardTilt, hoverSway, 0))
            if waist then setJoint(waist, CFrame.identity) end

            -- Pää upotettu rinnan sisään virtaviivaiseksi ohjaamoksi
            setJoint(neck, CFrame.new(0, -0.35, 0.15) * CFrame.Angles(math.rad(82) - forwardTilt, 0, 0))

            -- NÄKYVÄ ROOTTORIMASTO: Oikea jalka nousee selän keskeltä pystyyn kiinteäksi akseliksi
            setJoint(rHip, CFrame.new(-0.5, 1.0, 0.6) * CFrame.Angles(math.rad(90), 0, 0))

            -- PÄÄROOTTORIN LAVAT: Kädet kiinnittyvät suoraan maston päähän korkealle selän ylle
            setJoint(rShoulder, CFrame.new(-0.85, 0.2, 1.85) * CFrame.Angles(0, 0, rotorAngle + (math.pi / 2)))
            setJoint(lShoulder, CFrame.new(0.85, 0.2, 1.85) * CFrame.Angles(0, 0, rotorAngle - (math.pi / 2)))

            -- PERÄPUOMI & PYSTYROOTTORI: Vasen jalka tuotu lähelle torson perää, pyörii puomin kyljessä pystytasossa
            setJoint(lHip, CFrame.new(0.25, -1.2, 0.1) * CFrame.Angles(tailRotorAngle, 0, 0))

            if rElbow then setJoint(rElbow, CFrame.identity) end
            if lElbow then setJoint(lElbow, CFrame.identity) end
            if rKnee then setJoint(rKnee, CFrame.identity) end
            if lKnee then setJoint(lKnee, CFrame.identity) end

        -- =============================================================
        -- 2. KOIRA (Matalalla maassa, tassut alaspäin, aito istuminen)
        -- =============================================================
        elseif currentAnimMode == "Dog" then
            if isJumping then
                setJoint(root, CFrame.new(0, -0.45, 0) * CFrame.Angles(math.rad(-65), 0, 0))
                if waist then setJoint(waist, CFrame.identity) end
                setJoint(neck, CFrame.new(0, 0.2, 0.15) * CFrame.Angles(math.rad(70), 0, 0))

                setJoint(rShoulder, CFrame.new(-0.75, -0.2, -0.15) * CFrame.Angles(math.rad(85), 0, math.rad(-8)))
                setJoint(lShoulder, CFrame.new(0.75, -0.2, -0.15) * CFrame.Angles(math.rad(85), 0, math.rad(8)))
                setJoint(rHip, CFrame.new(-0.25, 0.65, -0.2) * CFrame.Angles(math.rad(25), 0, math.rad(6)))
                setJoint(lHip, CFrame.new(0.25, 0.65, -0.2) * CFrame.Angles(math.rad(25), 0, math.rad(-6)))

            elseif isMoving then
                local trotT = globalTime * (speed * 0.75)
                local diag1 = math.sin(trotT) * math.rad(24)
                local diag2 = -diag1
                local spineBob = math.sin(trotT * 2) * math.rad(2.5)

                setJoint(root, CFrame.new(0, -0.65, 0) * CFrame.Angles(math.rad(-84) + spineBob, 0, 0))
                if waist then setJoint(waist, CFrame.identity) end

                local headTurn = math.sin(trotT) * math.rad(4)
                setJoint(neck, CFrame.new(0, 0.2, 0.15) * CFrame.Angles(math.rad(78), headTurn, 0))

                -- ETUTASSUT: Tulevat rinnan sisältä ja osoittavat suoraan maahan
                setJoint(rShoulder, CFrame.new(-0.75, -0.2, -0.1) * CFrame.Angles(math.rad(82) + diag1, 0, math.rad(-6)))
                setJoint(lShoulder, CFrame.new(0.75, -0.2, -0.1) * CFrame.Angles(math.rad(82) + diag2, 0, math.rad(6)))

                -- TAKAJALAT: Upotettu syvälle vatsan alle, selkä peittää ne lähes kokonaan
                setJoint(rHip, CFrame.new(-0.25, 0.65, -0.2) * CFrame.Angles(math.rad(76) + diag2, 0, math.rad(6)))
                setJoint(lHip, CFrame.new(0.25, 0.65, -0.2) * CFrame.Angles(math.rad(76) + diag1, 0, math.rad(-6)))

            else
                -- KOIRAMAISEN ISTUMINEN (Idle Sit)
                setJoint(root, CFrame.new(0, -0.5, 0) * CFrame.Angles(math.rad(-45), 0, 0))
                if waist then setJoint(waist, CFrame.identity) end

                local lookAround = math.sin(globalTime * 1.5) * math.rad(8)
                setJoint(neck, CFrame.new(0, 0.2, 0.15) * CFrame.Angles(math.rad(45), lookAround, 0))

                local earTwitch = math.sin(globalTime * 3) * math.rad(3)
                setJoint(rShoulder, CFrame.new(-0.75, -0.2, -0.1) * CFrame.Angles(math.rad(48) + earTwitch, 0, math.rad(-6)))
                setJoint(lShoulder, CFrame.new(0.75, -0.2, -0.1) * CFrame.Angles(math.rad(48) - earTwitch, 0, math.rad(6)))

                setJoint(rHip, CFrame.new(-0.25, 0.65, -0.15) * CFrame.Angles(math.rad(15), 0, math.rad(6)))
                setJoint(lHip, CFrame.new(0.25, 0.65, -0.15) * CFrame.Angles(math.rad(15), 0, math.rad(-6)))
            end

            if rElbow then setJoint(rElbow, CFrame.Angles(math.rad(-25), 0, 0)) end
            if lElbow then setJoint(lElbow, CFrame.Angles(math.rad(-25), 0, 0)) end
            if rKnee then setJoint(rKnee, CFrame.Angles(math.rad(35), 0, 0)) end
            if lKnee then setJoint(lKnee, CFrame.Angles(math.rad(35), 0, 0)) end

        -- =============================================================
        -- 3. PUPU (Istuu kyyryssä maassa, tassut alaspäin, napakka loikka)
        -- =============================================================
        elseif currentAnimMode == "Rabbit" then
            if isJumping then
                setJoint(root, CFrame.new(0, -0.35, -0.3) * CFrame.Angles(math.rad(-20), 0, 0))
                if waist then setJoint(waist, CFrame.identity) end
                setJoint(neck, CFrame.new(0, -0.15, 0.1) * CFrame.Angles(math.rad(22), 0, 0))
                setJoint(rShoulder, CFrame.new(-0.75, -0.2, 0.05) * CFrame.Angles(math.rad(55), 0, math.rad(-6)))
                setJoint(lShoulder, CFrame.new(0.75, -0.2, 0.05) * CFrame.Angles(math.rad(55), 0, math.rad(6)))
                setJoint(rHip, CFrame.new(-0.25, 0.65, 0.15) * CFrame.Angles(math.rad(15), 0, math.rad(5)))
                setJoint(lHip, CFrame.new(0.25, 0.65, 0.15) * CFrame.Angles(math.rad(15), 0, math.rad(-5)))

            elseif isMoving then
                rabbitHopTimer = (rabbitHopTimer + deltaTime * (speed * 0.65)) % (math.pi * 2)
                local hopArc = math.abs(math.sin(rabbitHopTimer))
                local hopPitch = math.sin(rabbitHopTimer) * math.rad(16)
                local kick = math.sin(rabbitHopTimer)

                -- Torso eteenpäin: pyöreä perä ylittää syvälle kätketyt takajalat
                setJoint(root, CFrame.new(0, -0.55 + (hopArc * 0.7), -0.4) * CFrame.Angles(math.rad(-30) + hopPitch, 0, 0))
                if waist then setJoint(waist, CFrame.identity) end
                setJoint(neck, CFrame.new(0, -0.15, 0.1) * CFrame.Angles(math.rad(26) - hopPitch * 0.5, 0, 0))

                setJoint(rShoulder, CFrame.new(-0.75, -0.2, 0.0) * CFrame.Angles(math.rad(50) + kick * math.rad(15), 0, math.rad(-6)))
                setJoint(lShoulder, CFrame.new(0.75, -0.2, 0.0) * CFrame.Angles(math.rad(50) + kick * math.rad(15), 0, math.rad(6)))

                local legKick = (kick < 0 and -kick * math.rad(40)) or (kick * math.rad(12))
                setJoint(rHip, CFrame.new(-0.25, 0.65, 0.15) * CFrame.Angles(math.rad(-22) - legKick, 0, math.rad(5)))
                setJoint(lHip, CFrame.new(0.25, 0.65, 0.15) * CFrame.Angles(math.rad(-22) - legKick, 0, math.rad(-5)))

            else
                local twitch = math.sin(globalTime * 22) * math.rad(2.5)
                local breath = math.sin(globalTime * 4) * math.rad(1.5)

                -- Pupu istuu pystyssä kyyryssä maassa (ei makaa vatsallaan)
                setJoint(root, CFrame.new(0, -0.55, -0.35) * CFrame.Angles(math.rad(-28) + breath, 0, 0))
                if waist then setJoint(waist, CFrame.identity) end
                setJoint(neck, CFrame.new(0, -0.15, 0.1) * CFrame.Angles(math.rad(26) + twitch, twitch * 0.5, 0))

                -- Etutassut osoittavat suoraan maahan rinnan alle
                setJoint(rShoulder, CFrame.new(-0.75, -0.2, 0.0) * CFrame.Angles(math.rad(48), 0, math.rad(-6)))
                setJoint(lShoulder, CFrame.new(0.75, -0.2, 0.0) * CFrame.Angles(math.rad(48), 0, math.rad(6)))

                -- Takajalat syvällä torson sisään kätkettynä
                setJoint(rHip, CFrame.new(-0.25, 0.65, 0.15) * CFrame.Angles(math.rad(-25), 0, math.rad(5)))
                setJoint(lHip, CFrame.new(0.25, 0.65, 0.15) * CFrame.Angles(math.rad(-25), 0, math.rad(-5)))
            end

            if rElbow then setJoint(rElbow, CFrame.Angles(math.rad(-35), 0, 0)) end
            if lElbow then setJoint(lElbow, CFrame.Angles(math.rad(-35), 0, 0)) end
            if rKnee then setJoint(rKnee, CFrame.Angles(math.rad(45), 0, 0)) end
            if lKnee then setJoint(lKnee, CFrame.Angles(math.rad(45), 0, 0)) end

        -- =============================================================
        -- 4. PSYCHO MONSTER & SCARY FLING (Ammuttu jalka & Hallittu juoksu)
        -- =============================================================
        elseif currentAnimMode == "Psycho" then
            local tremor = (math.sin(globalTime * 38) * 0.65 + math.cos(globalTime * 27) * 0.35 + math.sin(globalTime * 58) * 0.2) * math.rad(5.5)
            local twitchCycle = math.sin(globalTime * 2.2)
            local suddenSnap = (twitchCycle > 0.94 and math.sin(globalTime * 40) * math.rad(16) or 0)
            local breath = (math.sin(globalTime * 2.3) * 0.7 + math.cos(globalTime * 4.1) * 0.3) * math.rad(2.5)
            local randomSway = math.sin(globalTime * 0.7) * math.rad(3.5)

            if scaryPunchPhase == 1 then
                -- SCARY FLING: Nyrkin lataus taakse olkapään taakse
                setJoint(root, CFrame.Angles(math.rad(-10), math.rad(-30), 0))
                if waist then setJoint(waist, CFrame.identity) end
                setJoint(neck, CFrame.Angles(math.rad(8), math.rad(25), 0))
                setJoint(rShoulder, CFrame.Angles(math.rad(-45), 0, math.rad(25)))
                setJoint(lShoulder, CFrame.Angles(math.rad(40), 0, math.rad(-15)))
                setJoint(rHip, CFrame.Angles(math.rad(-12), 0, 0))
                setJoint(lHip, CFrame.Angles(math.rad(20), 0, 0))

            elseif scaryPunchPhase == 2 then
                -- SCARY FLING: Räjähtävä nyrkin laukaisu suoraan kohteen naamaan
                setJoint(root, CFrame.Angles(math.rad(-14), math.rad(20), 0))
                if waist then setJoint(waist, CFrame.identity) end
                setJoint(neck, CFrame.Angles(math.rad(-12), math.rad(-12), 0))
                setJoint(rShoulder, CFrame.Angles(math.rad(120), 0, math.rad(-12)))
                setJoint(lShoulder, CFrame.Angles(math.rad(-40), 0, math.rad(-20)))
                setJoint(rHip, CFrame.Angles(math.rad(30), 0, 0))
                setJoint(lHip, CFrame.Angles(math.rad(-25), 0, 0))

            elseif isScaryFlingActive and not isMoving then
                local headSpasm = math.sin(globalTime * 70) * math.rad(35)
                setJoint(root, CFrame.Angles(math.rad(-10), math.sin(globalTime * 30) * math.rad(5), 0))
                if waist then setJoint(waist, CFrame.identity) end
                setJoint(neck, CFrame.Angles(headSpasm, headSpasm * 0.8, -headSpasm * 0.5))
                setJoint(rShoulder, CFrame.Angles(math.rad(35) + tremor * 2, 0, math.rad(25) + tremor * 2))
                setJoint(lShoulder, CFrame.Angles(math.rad(35) - tremor * 2, 0, math.rad(-25) - tremor * 2))
                setJoint(rHip, CFrame.Angles(math.rad(-5), 0, math.rad(5)))
                setJoint(lHip, CFrame.Angles(math.rad(-5), 0, math.rad(-5)))

            elseif isFalling then
                setJoint(root, CFrame.Angles(math.rad(18), 0, math.rad(-8)))
                if waist then setJoint(waist, CFrame.identity) end
                setJoint(neck, CFrame.Angles(math.rad(32) + suddenSnap, math.rad(15), math.rad(-15)))
                setJoint(rShoulder, CFrame.Angles(math.rad(45) + tremor, 0, math.rad(35) + tremor))
                setJoint(lShoulder, CFrame.Angles(math.rad(-25), 0, math.rad(-30)))
                setJoint(rHip, CFrame.Angles(math.rad(15), 0, math.rad(8)))
                setJoint(lHip, CFrame.Angles(-math.rad(20), 0, math.rad(-8)))

            elseif isFlying then
                setJoint(root, CFrame.Angles(math.rad(14), 0, math.rad(-6)))
                if waist then setJoint(waist, CFrame.identity) end
                setJoint(neck, CFrame.Angles(math.rad(26) + suddenSnap, math.rad(22), math.rad(-20)))
                setJoint(rShoulder, CFrame.Angles(math.rad(28) + tremor, 0, math.rad(20) + tremor))
                setJoint(lShoulder, CFrame.Angles(math.rad(-14) + tremor * 0.4, 0, math.rad(-18)))
                setJoint(rHip, CFrame.Angles(math.rad(8), 0, math.rad(6)))
                setJoint(lHip, CFrame.Angles(-math.rad(10), 0, math.rad(-6)))

            elseif isMoving then
                if isAgonySprinting or speed > 20 then
                    -- TUSKAINEN JUOKSU (> 1.5s): Hallittu saalistusrynnäkkö (ei kaadu naamalleen)
                    local runT = globalTime * (speed * 0.85)
                    local stride = math.sin(runT) * math.rad(44)
                    local agonyTwitch = math.sin(globalTime * 26) * math.rad(4.5)

                    setJoint(root, CFrame.Angles(math.rad(-14) + agonyTwitch, math.sin(runT) * math.rad(6), 0))
                    if waist then setJoint(waist, CFrame.identity) end
                    setJoint(neck, CFrame.Angles(math.rad(20) + suddenSnap, math.sin(globalTime * 18) * math.rad(6), 0))
                    setJoint(rShoulder, CFrame.Angles(math.rad(36) + tremor * 1.5, 0, math.rad(16) + agonyTwitch))
                    setJoint(lShoulder, CFrame.Angles(math.rad(26) - tremor * 1.5, 0, math.rad(-16) - agonyTwitch))
                    setJoint(rHip, CFrame.Angles(stride, 0, 0))
                    setJoint(lHip, CFrame.Angles(-stride * 0.55 + agonyTwitch, 0, math.rad(6)))
                else
                    -- AMMUTUN JALAN ONTUVA KÄVELY: Toinen jalka pettää alta ja laahaa perässä
                    local walkT = globalTime * 5.8
                    local step = math.sin(walkT)

                    local limpDip = (step < 0 and -math.abs(step) * 0.24) or (-math.abs(step) * 0.06)
                    setJoint(root, CFrame.new(0, limpDip, 0) * CFrame.Angles(math.rad(-10), step * math.rad(4), math.rad(-6) * (step < 0 and 1.1 or 0.3)))
                    if waist then setJoint(waist, CFrame.identity) end
                    setJoint(neck, CFrame.Angles(math.rad(16) + suddenSnap, math.rad(22) + suddenSnap, math.rad(-18)))
                    setJoint(rShoulder, CFrame.Angles(math.rad(20) + tremor + (step * math.rad(7)), 0, math.rad(12) + tremor))
                    setJoint(lShoulder, CFrame.Angles(math.rad(-10) - (step * math.rad(4)), 0, math.rad(-12)))

                    setJoint(rHip, CFrame.Angles(step * math.rad(36), 0, math.rad(4)))
                    setJoint(lHip, CFrame.Angles(-step * math.rad(14), 0, math.rad(-5)))
                end
            else
                -- Horror Idle: Luonnoton pään asento & satunnaisesti heilahteleva vartalo
                setJoint(root, CFrame.Angles(math.rad(-8) + breath, math.sin(globalTime * 1.5) * math.rad(2.5) + randomSway, math.rad(-4)))
                if waist then setJoint(waist, CFrame.identity) end
                setJoint(neck, CFrame.Angles(math.rad(14) + suddenSnap, math.rad(24) + suddenSnap, math.rad(-22)))
                setJoint(rShoulder, CFrame.Angles(math.rad(20) + tremor, 0, math.rad(10) + tremor))
                setJoint(lShoulder, CFrame.Angles(math.rad(-8), 0, math.rad(-12) + (tremor * 0.2)))
                setJoint(rHip, CFrame.Angles(math.rad(-4), 0, math.rad(4)))
                setJoint(lHip, CFrame.Angles(math.rad(4), 0, math.rad(-4)))
            end

            if rElbow then setJoint(rElbow, CFrame.Angles(math.rad(-22) + tremor, 0, 0)) end
            if lElbow then setJoint(lElbow, CFrame.Angles(math.rad(-6), 0, 0)) end
            if rKnee then setJoint(rKnee, CFrame.identity) end
            if lKnee then setJoint(lKnee, CFrame.identity) end
        end
    end)
end

local function setAnimationMode(newMode)
    currentAnimMode = newMode
    continuousMoveTime = 0
    scaryPunchPhase = 0
    resetTransforms()

    local char = LocalPlayer.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")

    if hum then
        if newMode == "Dog" then
            hum.HipHeight = 0.45
        elseif newMode == "Rabbit" then
            hum.HipHeight = 0.55
        else
            hum.HipHeight = defaultHipHeight or 0
        end
    end

    if newMode == "Helicopter" then
        startFlightPhysics(char)
    else
        if not isFlying then
            stopFlightPhysics(char)
        end
    end

    if char then
        local animate = char:FindFirstChild("Animate")
        if animate then
            animate.Enabled = (newMode == "None")
        end
    end
end


-- 5. PROCEDURAL KINEMATICS & PHYSICS LOOP
-- ====================================================================
local function startProceduralEngine(character)
    if procAnimConnection then procAnimConnection:Disconnect(); procAnimConnection = nil end
    if netlessConnection then netlessConnection:Disconnect(); netlessConnection = nil end
    if not character then return end

    local humanoid = character:WaitForChild("Humanoid", 5)
    local hrp = character:WaitForChild("HumanoidRootPart", 5)
    if not humanoid or not hrp then return end

    cacheJoints(character)

    local animate = character:FindFirstChild("Animate")
    if animate then animate.Enabled = (currentAnimMode == "None") end

    local animator = humanoid:FindFirstChildOfClass("Animator")
    if animator and currentAnimMode ~= "None" then
        for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
            track:Stop(0)
        end
    end

    netlessConnection = RunService.Heartbeat:Connect(function()
        if isTerminated or not character or not character.Parent then return end
        for _, data in ipairs(activeHatReanims) do
            if data.Handle and data.Handle.Parent then
                data.Handle.AssemblyLinearVelocity = Vector3.new(0, -30, 0)
            end
        end
    end)

    procAnimConnection = RunService.Stepped:Connect(function(timeArg, deltaArg)
        if isTerminated or not character or not character.Parent or not humanoid or not humanoid.Parent or humanoid.Health <= 0 then
            return
        end

        local globalTime = (typeof(timeArg) == "number" and timeArg) or os.clock()
        local deltaTime = (typeof(deltaArg) == "number" and deltaArg) or 0.016

        local isMoving = false
        pcall(function() isMoving = humanoid.MoveDirection.Magnitude > 0.05 end)
        local speed = 16
        pcall(function() speed = humanoid.WalkSpeed end)

        local root = JointCache.RootJoint
        local waist = JointCache.Waist
        local neck = JointCache.Neck
        local rShoulder = JointCache.RightShoulder
        local lShoulder = JointCache.LeftShoulder
        local rElbow = JointCache.RightElbow
        local lElbow = JointCache.LeftElbow
        local rHip = JointCache.RightHip
        local lHip = JointCache.LeftHip
        local rKnee = JointCache.RightKnee
        local lKnee = JointCache.LeftKnee

        -- 1. HELIKOPTERI
        if currentAnimMode == "Helicopter" then
            local spinMult = (isFlying and 70) or (isMoving and 50) or 30
            rotorAngle = (rotorAngle + deltaTime * spinMult) % (math.pi * 2)
            tailRotorAngle = (tailRotorAngle + deltaTime * spinMult * 1.8) % (math.pi * 2)

            setJoint(root, CFrame.Angles(math.rad(-88), 0, 0))
            if waist then setJoint(waist, CFrame.identity) end
            setJoint(neck, CFrame.Angles(math.rad(82), 0, 0))

            setJoint(rShoulder, CFrame.new(-1, 0, 0.65) * CFrame.Angles(0, 0, rotorAngle + (math.pi / 2)))
            setJoint(lShoulder, CFrame.new(1, 0, 0.65) * CFrame.Angles(0, 0, rotorAngle - (math.pi / 2)))
            setJoint(rHip, CFrame.new(0.2, 0, 0) * CFrame.Angles(math.rad(-5), 0, 0))
            setJoint(lHip, CFrame.new(0.45, -2.4, 0) * CFrame.Angles(tailRotorAngle, 0, 0))

            if rElbow then setJoint(rElbow, CFrame.identity) end
            if lElbow then setJoint(lElbow, CFrame.identity) end
            if rKnee then setJoint(rKnee, CFrame.identity) end
            if lKnee then setJoint(lKnee, CFrame.identity) end

            for _, data in ipairs(activeHatReanims) do
                if data.Role == "HeliMainRotor" and data.Att1 then
                    data.Att1.CFrame = CFrame.new(0, 0, 0.8) * CFrame.Angles(0, rotorAngle, 0)
                elseif data.Role == "HeliTailRotor" and data.Att1 then
                    data.Att1.CFrame = CFrame.new(0.45, -2.4, 0) * CFrame.Angles(tailRotorAngle, 0, 0)
                end
            end

        -- 2. KOIRA (NELINKONTIN MENOSUUNTAAN)
        elseif currentAnimMode == "Dog" then
            local trotT = globalTime * (speed * 0.75)
            local diag1 = math.sin(trotT) * math.rad(28)
            local diag2 = -diag1
            local spineBob = isMoving and (math.sin(trotT * 2) * math.rad(3)) or 0

            setJoint(root, CFrame.Angles(math.rad(-82) + spineBob, 0, 0))
            if waist then setJoint(waist, CFrame.identity) end

            local headTurn = isMoving and (math.sin(trotT) * math.rad(4)) or (math.sin(globalTime * 1.5) * math.rad(10))
            setJoint(neck, CFrame.Angles(math.rad(78), headTurn, 0))

            if isMoving then
                setJoint(rShoulder, CFrame.Angles(math.rad(82) + diag1, 0, math.rad(6)))
                setJoint(lHip, CFrame.Angles(math.rad(82) + diag1, 0, math.rad(-6)))
                setJoint(lShoulder, CFrame.Angles(math.rad(82) + diag2, 0, math.rad(-6)))
                setJoint(rHip, CFrame.Angles(math.rad(82) + diag2, 0, math.rad(6)))
            else
                local pant = math.sin(globalTime * 3.5) * math.rad(2)
                setJoint(rShoulder, CFrame.Angles(math.rad(82) + pant, 0, math.rad(6)))
                setJoint(lShoulder, CFrame.Angles(math.rad(82) + pant, 0, math.rad(-6)))
                setJoint(rHip, CFrame.Angles(math.rad(82) + pant, 0, math.rad(6)))
                setJoint(lHip, CFrame.Angles(math.rad(82) + pant, 0, math.rad(-6)))
            end

            if rElbow then setJoint(rElbow, CFrame.Angles(math.rad(-15), 0, 0)) end
            if lElbow then setJoint(lElbow, CFrame.Angles(math.rad(-15), 0, 0)) end
            if rKnee then setJoint(rKnee, CFrame.Angles(math.rad(20), 0, 0)) end
            if lKnee then setJoint(lKnee, CFrame.Angles(math.rad(20), 0, 0)) end

            local wagSpeed = isMoving and 22 or 10
            local wagAngle = math.sin(globalTime * wagSpeed) * math.rad(38)
            for _, data in ipairs(activeHatReanims) do
                if data.Role == "DogTail" and data.Att1 then
                    data.Att1.CFrame = CFrame.new(0, -0.75, 0.8) * CFrame.Angles(math.rad(45), wagAngle, 0)
                end
            end
            if clientVisualProps.DogTailWeld and clientVisualProps.DogTailWeld.Parent then
                clientVisualProps.DogTailWeld.C0 = CFrame.new(0, -0.75, 0.8) * CFrame.Angles(math.rad(45), wagAngle, 0)
            end

        -- 3. PUPU (AITO MATALA KYYRYASENTO & HYPPYKAARI)
        elseif currentAnimMode == "Rabbit" then
            if isMoving then
                rabbitHopTimer = (rabbitHopTimer + deltaTime * (speed * 0.65)) % (math.pi * 2)
                local hopArc = math.abs(math.sin(rabbitHopTimer))
                local hopPitch = math.sin(rabbitHopTimer) * math.rad(22)
                local kick = math.sin(rabbitHopTimer)

                setJoint(root, CFrame.new(0, hopArc * 0.9, 0) * CFrame.Angles(math.rad(-36) + hopPitch, 0, 0))
                if waist then setJoint(waist, CFrame.identity) end
                setJoint(neck, CFrame.Angles(math.rad(30) - hopPitch * 0.5, 0, 0))

                setJoint(rShoulder, CFrame.Angles(math.rad(52) + kick * math.rad(18), 0, math.rad(-14)))
                setJoint(lShoulder, CFrame.Angles(math.rad(52) + kick * math.rad(18), 0, math.rad(14)))

                local legKick = (kick < 0 and -kick * math.rad(50)) or (kick * math.rad(18))
                setJoint(rHip, CFrame.Angles(math.rad(-25) - legKick, 0, math.rad(6)))
                setJoint(lHip, CFrame.Angles(math.rad(-25) - legKick, 0, math.rad(-6)))
            else
                local twitch = math.sin(globalTime * 20) * math.rad(3)
                local breath = math.sin(globalTime * 4) * math.rad(2)
                setJoint(root, CFrame.Angles(math.rad(-38) + breath, 0, 0))
                if waist then setJoint(waist, CFrame.identity) end
                setJoint(neck, CFrame.Angles(math.rad(32) + twitch, twitch * 0.6, 0))

                setJoint(rShoulder, CFrame.Angles(math.rad(58), 0, math.rad(-14)))
                setJoint(lShoulder, CFrame.Angles(math.rad(58), 0, math.rad(14)))
                setJoint(rHip, CFrame.Angles(math.rad(-30), 0, math.rad(6)))
                setJoint(lHip, CFrame.Angles(-math.rad(-30), 0, math.rad(-6)))
            end

            if rElbow then setJoint(rElbow, CFrame.Angles(math.rad(-45), 0, 0)) end
            if lElbow then setJoint(lElbow, CFrame.Angles(math.rad(-45), 0, 0)) end
            if rKnee then setJoint(rKnee, CFrame.Angles(math.rad(35), 0, 0)) end
            if lKnee then setJoint(lKnee, CFrame.Angles(math.rad(35), 0, 0)) end

            local earTwitch = math.sin(globalTime * 18) * math.rad(5)
            for _, data in ipairs(activeHatReanims) do
                if data.Role == "RabbitEarR" and data.Att1 then
                    data.Att1.CFrame = CFrame.new(0.35, 0.85, 0) * CFrame.Angles(math.rad(-10) + earTwitch, 0, math.rad(8))
                elseif data.Role == "RabbitEarL" and data.Att1 then
                    data.Att1.CFrame = CFrame.new(-0.35, 0.85, 0) * CFrame.Angles(math.rad(-10) - earTwitch, 0, math.rad(-8))
                end
            end

        -- 4. RAPU (MATALA HAARA-ASENTO & SIVUSTASIPUTUS)
        elseif currentAnimMode == "Crab" then
            local clawSnap = math.sin(globalTime * 14) * math.rad(22)
            local scuttle = math.sin(globalTime * (speed * 0.9)) * math.rad(24)
            local bodyWobble = math.cos(globalTime * (speed * 0.9)) * math.rad(6)

            setJoint(root, CFrame.Angles(math.rad(-20), 0, bodyWobble))
            if waist then setJoint(waist, CFrame.identity) end
            setJoint(neck, CFrame.Angles(math.rad(16), math.sin(globalTime * 3) * math.rad(10), 0))

            setJoint(rShoulder, CFrame.Angles(math.rad(42), 0, math.rad(75) + clawSnap))
            setJoint(lShoulder, CFrame.Angles(math.rad(42), 0, -math.rad(75) - clawSnap))

            if isMoving then
                setJoint(rHip, CFrame.Angles(math.sin(globalTime * speed * 0.9) * math.rad(16), 0, math.rad(48) + scuttle))
                setJoint(lHip, CFrame.Angles(-math.sin(globalTime * speed * 0.9) * math.rad(16), 0, -math.rad(48) + scuttle))
            else
                setJoint(rHip, CFrame.Angles(0, 0, math.rad(48)))
                setJoint(lHip, CFrame.Angles(0, 0, -math.rad(48)))
            end

            if rElbow then setJoint(rElbow, CFrame.Angles(math.rad(-30), 0, 0)) end
            if lElbow then setJoint(lElbow, CFrame.Angles(math.rad(-30), 0, 0)) end
            if rKnee then setJoint(rKnee, CFrame.Angles(math.rad(30), 0, 0)) end
            if lKnee then setJoint(lKnee, CFrame.Angles(math.rad(30), 0, 0)) end

            for _, data in ipairs(activeHatReanims) do
                if data.Role == "CrabClawR" and data.Att1 then
                    data.Att1.CFrame = CFrame.new(0, -1.2, 0) * CFrame.Angles(math.rad(90), clawSnap, 0)
                elseif data.Role == "CrabClawL" and data.Att1 then
                    data.Att1.CFrame = CFrame.new(0, -1.2, 0) * CFrame.Angles(math.rad(90), -clawSnap, 0)
                end
            end

        -- 5. PSYCHO MONSTER (MATALA KÄSI & AITO MIKROVAPINA)
        elseif currentAnimMode == "Psycho" then
            local armShake = math.sin(globalTime * 34) * math.rad(4.5) + math.cos(globalTime * 23) * math.rad(2.5)
            local twitchCycle = math.sin(globalTime * 2.2)
            local suddenSnap = (twitchCycle > 0.93 and math.sin(globalTime * 36) * math.rad(12) or 0)

            if isFlying then
                setJoint(root, CFrame.Angles(math.rad(15), 0, math.rad(-6)))
                if waist then setJoint(waist, CFrame.identity) end
                setJoint(neck, CFrame.Angles(math.rad(28) + suddenSnap, math.rad(22), math.rad(-18)))
                setJoint(rShoulder, CFrame.Angles(math.rad(35) + armShake, 0, math.rad(28) + armShake))
                setJoint(lShoulder, CFrame.Angles(math.rad(-10) + armShake * 0.5, 0, math.rad(-22)))
                setJoint(rHip, CFrame.Angles(math.rad(10), 0, math.rad(8)))
                setJoint(lHip, CFrame.Angles(math.rad(-12), 0, math.rad(-6)))
            elseif isMoving then
                if speed > 18 then
                    local runT = globalTime * (speed * 0.8)
                    local stride = math.sin(runT) * math.rad(45)

                    setJoint(root, CFrame.Angles(math.rad(-28), 0, math.sin(runT) * math.rad(5)))
                    if waist then setJoint(waist, CFrame.identity) end
                    setJoint(neck, CFrame.Angles(math.rad(25) + suddenSnap, math.sin(globalTime * 20) * math.rad(8), 0))
                    setJoint(rShoulder, CFrame.Angles(math.rad(45) + armShake, 0, math.rad(18)))
                    setJoint(lShoulder, CFrame.Angles(math.rad(35) - armShake, 0, math.rad(-18)))
                    setJoint(rHip, CFrame.Angles(stride, 0, 0))
                    setJoint(lHip, CFrame.Angles(-stride, 0, 0))
                else
                    local walkT = globalTime * 6
                    local step = math.sin(walkT)

                    setJoint(root, CFrame.Angles(math.rad(-12), step * math.rad(5), math.rad(-6)))
                    if waist then setJoint(waist, CFrame.identity) end
                    setJoint(neck, CFrame.Angles(math.rad(18) + suddenSnap, math.rad(24) + suddenSnap, math.rad(-20)))
                    setJoint(rShoulder, CFrame.Angles(math.rad(22) + armShake + (step * math.rad(12)), 0, math.rad(14) + armShake))
                    setJoint(lShoulder, CFrame.Angles(math.rad(-12) - (step * math.rad(8)), 0, math.rad(-14)))
                    setJoint(rHip, CFrame.Angles(step * math.rad(38), 0, math.rad(4)))
                    setJoint(lHip, CFrame.Angles(-step * math.rad(20), 0, math.rad(-4)))
                end
            else
                setJoint(root, CFrame.Angles(math.rad(-10), math.sin(globalTime * 1.5) * math.rad(3), math.rad(-5)))
                if waist then setJoint(waist, CFrame.identity) end
                setJoint(neck, CFrame.Angles(math.rad(16) + suddenSnap, math.rad(26) + suddenSnap, math.rad(-24)))
                setJoint(rShoulder, CFrame.Angles(math.rad(24) + armShake, 0, math.rad(14) + armShake))
                setJoint(lShoulder, CFrame.Angles(math.rad(-8), 0, math.rad(-12) + (armShake * 0.3)))
                setJoint(rHip, CFrame.Angles(math.rad(-4), 0, math.rad(5)))
                setJoint(lHip, CFrame.Angles(math.rad(4), 0, math.rad(-5)))
            end

            if rElbow then setJoint(rElbow, CFrame.Angles(math.rad(-25) + armShake, 0, 0)) end
            if lElbow then setJoint(lElbow, CFrame.Angles(math.rad(-8), 0, 0)) end
            if rKnee then setJoint(rKnee, CFrame.identity) end
            if lKnee then setJoint(lKnee, CFrame.identity) end
        end
    end)
end


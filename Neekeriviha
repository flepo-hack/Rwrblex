-- 4. PROCEDURAL MATH PROCEDURES (Psycho, Heli, Dog, Rabbit)
-- ====================================================================
local function startProceduralEngine(character)
    if procAnimConnection then
        procAnimConnection:Disconnect()
        procAnimConnection = nil
    end

    if not character then return end

    local humanoid = character:WaitForChild("Humanoid", 5)
    local hrp = character:WaitForChild("HumanoidRootPart", 5)
    if not humanoid or not hrp then return end

    cacheJoints(character)

    local animate = character:FindFirstChild("Animate")
    if animate then
        if currentAnimMode == "None" then
            animate.Enabled = true
        else
            animate.Enabled = false
        end
    end

    local animator = humanoid:FindFirstChildOfClass("Animator")
    if animator and currentAnimMode ~= "None" then
        for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
            track:Stop(0)
        end
    end

    procAnimConnection = RunService.Stepped:Connect(function(timeArg, deltaArg)
        if isTerminated or not character or not character.Parent or not humanoid or not humanoid.Parent or humanoid.Health <= 0 then
            return
        end

        local globalTime = (typeof(timeArg) == "number" and timeArg) or os.clock()
        local deltaTime = (typeof(deltaArg) == "number" and deltaArg) or 0.016

        local isMoving = false
        pcall(function()
            isMoving = humanoid.MoveDirection.Magnitude > 0.05
        end)
        local speed = 16
        pcall(function()
            speed = humanoid.WalkSpeed
        end)
        local isAirborne = false
        pcall(function()
            isAirborne = (humanoid:GetState() == Enum.HumanoidStateType.Freefall)
        end)

        local root = JointCache.RootJoint
        local neck = JointCache.Neck
        local rShoulder = JointCache.RightShoulder
        local lShoulder = JointCache.LeftShoulder
        local rHip = JointCache.RightHip
        local lHip = JointCache.LeftHip

        -- -------------------------------------------------------------
        -- 1. HELIKOPTERI
        -- -------------------------------------------------------------
        if currentAnimMode == "Helicopter" then
            local speedMultiplier = (isFlying and 55) or (isMoving and 45) or 22
            rotorAngle = (rotorAngle + deltaTime * speedMultiplier) % (math.pi * 2)
            tailRotorAngle = (tailRotorAngle + deltaTime * speedMultiplier * 1.5) % (math.pi * 2)

            if root and OriginalC0[root] then
                root.C0 = OriginalC0[root] * CFrame.Angles(math.rad(90), 0, 0)
            end
            if neck and OriginalC0[neck] then
                neck.C0 = OriginalC0[neck] * CFrame.Angles(math.rad(-85), 0, 0)
            end
            if rShoulder and OriginalC0[rShoulder] then
                rShoulder.C0 = CFrame.new(0, 1.5, -0.5) * CFrame.Angles(0, rotorAngle, math.rad(90))
            end
            if lShoulder and OriginalC0[lShoulder] then
                lShoulder.C0 = CFrame.new(0, -0.5, 2.2) * CFrame.Angles(math.rad(180), 0, 0)
            end
            if rHip and OriginalC0[rHip] then
                rHip.C0 = CFrame.new(0.6, -1.5, 0.5) * CFrame.Angles(math.rad(-30), 0, 0)
            end
            if lHip and OriginalC0[lHip] then
                lHip.C0 = CFrame.new(0.5, -0.5, 3.2) * CFrame.Angles(tailRotorAngle, 0, math.rad(90))
            end

        -- -------------------------------------------------------------
        -- 2. KOIRA (NELINKONTIN & HÄNTÄ)
        -- -------------------------------------------------------------
        elseif currentAnimMode == "Dog" then
            local runCycle = math.sin(globalTime * (speed * 0.8))
            local tailWag = math.sin(globalTime * 14) * math.rad(30)

            if root and OriginalC0[root] then
                root.C0 = OriginalC0[root] * CFrame.new(0, -1.2, 0) * CFrame.Angles(math.rad(75), 0, 0)
            end
            if neck and OriginalC0[neck] then
                neck.C0 = OriginalC0[neck] * CFrame.Angles(math.rad(-70), 0, 0)
            end
            if isMoving then
                if rShoulder and OriginalC0[rShoulder] then
                    rShoulder.C0 = OriginalC0[rShoulder] * CFrame.new(0, 0.4, 0) * CFrame.Angles(runCycle * 0.7, 0, 0)
                end
                if lShoulder and OriginalC0[lShoulder] then
                    lShoulder.C0 = OriginalC0[lShoulder] * CFrame.new(0, 0.4, 0) * CFrame.Angles(-runCycle * 0.7, 0, 0)
                end
                if rHip and OriginalC0[rHip] then
                    rHip.C0 = OriginalC0[rHip] * CFrame.Angles(-runCycle * 0.7, 0, 0)
                end
                if lHip and OriginalC0[lHip] then
                    lHip.C0 = CFrame.new(-0.5, 1, 1.2) * CFrame.Angles(math.rad(-130), tailWag, 0)
                end
            else
                if rShoulder and OriginalC0[rShoulder] then
                    rShoulder.C0 = OriginalC0[rShoulder] * CFrame.new(0, 0.4, 0) * CFrame.Angles(math.rad(10), 0, 0)
                end
                if lShoulder and OriginalC0[lShoulder] then
                    lShoulder.C0 = OriginalC0[lShoulder] * CFrame.new(0, 0.4, 0) * CFrame.Angles(math.rad(10), 0, 0)
                end
                if rHip and OriginalC0[rHip] then
                    rHip.C0 = OriginalC0[rHip] * CFrame.Angles(math.rad(10), 0, 0)
                end
                if lHip and OriginalC0[lHip] then
                    lHip.C0 = CFrame.new(-0.5, 1, 1.2) * CFrame.Angles(math.rad(-130), tailWag, 0)
                end
            end

        -- -------------------------------------------------------------
        -- 3. PUPU (LOIKKIMINEN & KORVAT)
        -- -------------------------------------------------------------
        elseif currentAnimMode == "Rabbit" then
            if isMoving then
                rabbitHopTimer = (rabbitHopTimer + deltaTime * (speed * 0.7)) % (math.pi * 2)
                local hopY = math.abs(math.sin(rabbitHopTimer)) * 0.8
                local hopPitch = math.sin(rabbitHopTimer) * math.rad(25)

                if root and OriginalC0[root] then
                    root.C0 = OriginalC0[root] * CFrame.new(0, -0.6 + hopY, 0) * CFrame.Angles(math.rad(20) + hopPitch, 0, 0)
                end
                if neck and OriginalC0[neck] then
                    neck.C0 = OriginalC0[neck] * CFrame.Angles(-hopPitch * 0.8, math.sin(globalTime * 18) * 0.06, 0)
                end
                if rShoulder and OriginalC0[rShoulder] then
                    rShoulder.C0 = OriginalC0[rShoulder] * CFrame.Angles(math.rad(50) - hopPitch, 0, math.rad(-20))
                end
                if lShoulder and OriginalC0[lShoulder] then
                    lShoulder.C0 = OriginalC0[lShoulder] * CFrame.Angles(math.rad(50) - hopPitch, 0, math.rad(20))
                end
                if rHip and OriginalC0[rHip] then
                    rHip.C0 = OriginalC0[rHip] * CFrame.Angles(math.sin(rabbitHopTimer) * 0.8, 0, 0)
                end
                if lHip and OriginalC0[lHip] then
                    lHip.C0 = OriginalC0[lHip] * CFrame.Angles(math.sin(rabbitHopTimer) * 0.8, 0, 0)
                end
            else
                local breath = math.sin(globalTime * 6) * 0.08
                if root and OriginalC0[root] then
                    root.C0 = OriginalC0[root] * CFrame.new(0, -0.8 + breath, 0) * CFrame.Angles(math.rad(20), 0, 0)
                end
                if neck and OriginalC0[neck] then
                    neck.C0 = OriginalC0[neck] * CFrame.Angles(math.rad(-15), math.sin(globalTime * 12) * 0.08, 0)
                end
                if rShoulder and OriginalC0[rShoulder] then
                    rShoulder.C0 = OriginalC0[rShoulder] * CFrame.Angles(math.rad(60), 0, math.rad(-25))
                end
                if lShoulder and OriginalC0[lShoulder] then
                    lShoulder.C0 = OriginalC0[lShoulder] * CFrame.Angles(math.rad(60), 0, math.rad(25))
                end
                if rHip and OriginalC0[rHip] then
                    rHip.C0 = OriginalC0[rHip] * CFrame.Angles(math.rad(-30), 0, 0)
                end
                if lHip and OriginalC0[lHip] then
                    lHip.C0 = OriginalC0[lHip] * CFrame.Angles(math.rad(-30), 0, 0)
                end
            end

        -- -------------------------------------------------------------
        -- 4. OMA CRAZY MONSTER PSYCHO
        -- -------------------------------------------------------------
        elseif currentAnimMode == "Psycho" then
            if isAirborne or isFlying then
                if neck and OriginalC0[neck] then
                    neck.C0 = OriginalC0[neck] * CFrame.Angles(math.rad(30), math.sin(globalTime * 20) * 0.15, 0)
                end
                if rShoulder and OriginalC0[rShoulder] then
                    rShoulder.C0 = OriginalC0[rShoulder] * CFrame.Angles(math.rad(160), 0, math.rad(20))
                end
                if lShoulder and OriginalC0[lShoulder] then
                    lShoulder.C0 = OriginalC0[lShoulder] * CFrame.Angles(math.rad(150), 0, math.rad(-25))
                end
            elseif isMoving then
                if speed > 18 then
                    local runT = globalTime * (speed * 0.9)
                    local legSwing = math.sin(runT) * 1.1

                    if root and OriginalC0[root] then
                        root.C0 = OriginalC0[root] * CFrame.new(0, math.abs(math.sin(runT)) * 0.25, 0) * CFrame.Angles(math.rad(38), 0, math.sin(runT) * 0.08)
                    end
                    if neck and OriginalC0[neck] then
                        neck.C0 = OriginalC0[neck] * CFrame.Angles(math.rad(-30), math.sin(globalTime * 24) * 0.2, math.rad(15))
                    end
                    if rShoulder and OriginalC0[rShoulder] then
                        rShoulder.C0 = OriginalC0[rShoulder] * CFrame.Angles(math.rad(80) + math.sin(runT) * 0.4, 0, math.rad(-30))
                    end
                    if lShoulder and OriginalC0[lShoulder] then
                        lShoulder.C0 = OriginalC0[lShoulder] * CFrame.Angles(math.rad(75) - math.sin(runT) * 0.4, 0, math.rad(30))
                    end
                    if rHip and OriginalC0[rHip] then
                        rHip.C0 = OriginalC0[rHip] * CFrame.Angles(legSwing, 0, 0)
                    end
                    if lHip and OriginalC0[lHip] then
                        lHip.C0 = OriginalC0[lHip] * CFrame.Angles(-legSwing, 0, 0)
                    end
                else
                    local walkT = globalTime * 7
                    local stepImpact = math.sin(walkT)

                    if root and OriginalC0[root] then
                        root.C0 = OriginalC0[root] * CFrame.new(0, (stepImpact > 0 and stepImpact * 0.2 or 0), 0) * CFrame.Angles(math.rad(12), stepImpact * 0.1, stepImpact * 0.08)
                    end
                    if neck and OriginalC0[neck] then
                        neck.C0 = OriginalC0[neck] * CFrame.Angles(math.rad(22), math.rad(-20) + math.sin(globalTime * 18) * 0.1, math.rad(-15))
                    end
                    if rShoulder and OriginalC0[rShoulder] then
                        rShoulder.C0 = OriginalC0[rShoulder] * CFrame.Angles(math.sin(walkT) * 0.6 + math.sin(globalTime * 22) * 0.2, 0, math.rad(15))
                    end
                    if lShoulder and OriginalC0[lShoulder] then
                        lShoulder.C0 = OriginalC0[lShoulder] * CFrame.Angles(-math.sin(walkT) * 0.4, 0, math.rad(-10))
                    end
                    if rHip and OriginalC0[rHip] then
                        rHip.C0 = OriginalC0[rHip] * CFrame.Angles(stepImpact * 0.8, 0, 0)
                    end
                    if lHip and OriginalC0[lHip] then
                        lHip.C0 = OriginalC0[lHip] * CFrame.Angles(-stepImpact * 0.5, 0, 0)
                    end
                end
            else
                local twitch = math.sin(globalTime * 24) * 0.08
                local rapidSpasm = math.sin(globalTime * 32) * 0.12

                if root and OriginalC0[root] then
                    root.C0 = OriginalC0[root] * CFrame.Angles(math.rad(6), math.sin(globalTime * 2) * 0.05, math.rad(-3))
                end
                if neck and OriginalC0[neck] then
                    neck.C0 = OriginalC0[neck] * CFrame.Angles(math.rad(20) + twitch, math.rad(25) + twitch, math.rad(-18))
                end
                if rShoulder and OriginalC0[rShoulder] then
                    rShoulder.C0 = OriginalC0[rShoulder] * CFrame.Angles(math.rad(15) + rapidSpasm, 0, math.rad(18) + twitch)
                end
                if lShoulder and OriginalC0[lShoulder] then
                    lShoulder.C0 = OriginalC0[lShoulder] * CFrame.Angles(math.rad(-5), 0, math.rad(-8))
                end
                if rHip and OriginalC0[rHip] then
                    rHip.C0 = OriginalC0[rHip] * CFrame.Angles(math.rad(-2), 0, math.rad(4))
                end
                if lHip and OriginalC0[lHip] then
                    lHip.C0 = OriginalC0[lHip] * CFrame.Angles(math.rad(3), 0, math.rad(-4))
                end
            end
        end
    end)
end

local function setAnimationMode(newMode)
    currentAnimMode = newMode
    restoreJoints()
    local char = LocalPlayer.Character
    if char then
        local animate = char:FindFirstChild("Animate")
        if animate then
            if newMode == "None" then
                animate.Enabled = true
            else
                animate.Enabled = false
                local humanoid = char:FindFirstChildOfClass("Humanoid")
                local animator = humanoid and humanoid:FindFirstChildOfClass("Animator")
                if animator then
                    for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
                        track:Stop(0)
                    end
                end
            end
        end
    end
end

-- ====================================================================
-- 5. FLY SUBSYSTEM (Infinite Yield Pure Model)
-- ====================================================================
local function startFlying(character)
    if isFlying then return end
    local hrp = character and character:FindFirstChild("HumanoidRootPart")
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    if not hrp or not humanoid then return end

    isFlying = true

    for _, obj in ipairs(hrp:GetChildren()) do
        if obj:IsA("BodyVelocity") or obj:IsA("BodyGyro") then
            obj:Destroy()
        end
    end

    flyBV = Instance.new("BodyVelocity")
    flyBV.Name = "FlightVelocity"
    flyBV.Velocity = Vector3.zero
    flyBV.MaxForce = Vector3.new(9e9, 9e9, 9e9)
    flyBV.Parent = hrp

    flyBG = Instance.new("BodyGyro")
    flyBG.Name = "FlightGyro"
    flyBG.P = 9e4
    flyBG.MaxTorque = Vector3.new(9e9, 9e9, 9e9)
    flyBG.CFrame = hrp.CFrame
    flyBG.Parent = hrp

    flyRenderConn = RunService.RenderStepped:Connect(function()
        if not isFlying or not hrp or not hrp.Parent or not humanoid or humanoid.Health <= 0 then
            return
        end

        local speed = flySpeeds[flySpeedIndex]
        local cam = getCamera()
        local camCF = cam and cam.CFrame or CFrame.identity
        local moveDir = humanoid.MoveDirection
        local moveVelocity = Vector3.zero

        if moveDir.Magnitude > 0.05 then
            local flatLook = Vector3.new(camCF.LookVector.X, 0, camCF.LookVector.Z)
            if flatLook.Magnitude > 0.001 then
                flatLook = flatLook.Unit
            else
                flatLook = Vector3.new(0, 0, -1)
            end
            local flatRight = Vector3.new(camCF.RightVector.X, 0, camCF.RightVector.Z).Unit

            local fDot = moveDir:Dot(flatLook)
            local rDot = moveDir:Dot(flatRight)

            moveVelocity = (camCF.LookVector * fDot + camCF.RightVector * rDot).Unit * speed
        end

        local vert = 0
        if UserInputService:IsKeyDown(Enum.KeyCode.Space) or humanoid.Jump then
            vert = vert + speed
        end
        if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) or UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then
            vert = vert - speed
        end

        flyBV.Velocity = moveVelocity + Vector3.new(0, vert, 0)
        flyBG.CFrame = camCF
    end)
end

local function stopFlying(character)
    isFlying = false

    if flyRenderConn then
        flyRenderConn:Disconnect()
        flyRenderConn = nil
    end

    local hrp = character and character:FindFirstChild("HumanoidRootPart")
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")

    if hrp then
        for _, obj in ipairs(hrp:GetChildren()) do
            if obj:IsA("BodyVelocity") or obj:IsA("BodyGyro") then
                obj:Destroy()
            end
        end
        hrp.AssemblyLinearVelocity = Vector3.new(0, -2, 0)
        hrp.AssemblyAngularVelocity = Vector3.zero
    end

    if humanoid then
        humanoid.PlatformStand = false
        humanoid.AutoRotate = true
        humanoid:ChangeState(Enum.HumanoidStateType.Freefall)
    end
end

-- ====================================================================
-- 6. TOUCH FLING SUBSYSTEM (Single-Thread Velocity Pulse Method)
-- ====================================================================
local function startFling(character)
    if isFlinging then return end
    local hrp = character and character:FindFirstChild("HumanoidRootPart")
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    if not hrp or not humanoid then return end

    isFlinging = true
    humanoid:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, false)
    humanoid:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)

    flingThread = task.spawn(function()
        while isFlinging do
            RunService.Heartbeat:Wait()
            if not isFlinging then break end

            local currentChar = LocalPlayer.Character
            local root = currentChar and currentChar:FindFirstChild("HumanoidRootPart")
            local hum = currentChar and currentChar:FindFirstChildOfClass("Humanoid")
            if root and root.Parent and hum and hum.Health > 0 then
                local originalVel = root.AssemblyLinearVelocity

                root.AssemblyLinearVelocity = originalVel * 10000 + Vector3.new(0, 10000, 0)

                RunService.RenderStepped:Wait()

                if root and root.Parent then
                    root.AssemblyLinearVelocity = originalVel
                end
            end
        end
    end)
end

local function stopFling(character)
    isFlinging = false
    if flingThread then
        task.cancel(flingThread)
        flingThread = nil
    end

    local hrp = character and character:FindFirstChild("HumanoidRootPart")
    if hrp then
        hrp.AssemblyLinearVelocity = Vector3.zero
        hrp.AssemblyAngularVelocity = Vector3.zero
    end
end

-- ====================================================================
-- 7. NOCLIP SUBSYSTEM
-- ====================================================================
local function startNoclip(character)
    if isNoclipping then return end
    isNoclipping = true

    noclipConn = RunService.Stepped:Connect(function()
        if not isNoclipping or not character or not character.Parent then return end
        for _, part in ipairs(character:GetDescendants()) do
            if part:IsA("BasePart") and part.CanCollide then
                part.CanCollide = false
            end
        end
    end)
end

local function stopNoclip(character)
    isNoclipping = false
    if noclipConn then
        noclipConn:Disconnect()
        noclipConn = nil
    end

    if character and character.Parent then
        for _, part in ipairs(character:GetDescendants()) do
            if part:IsA("BasePart") then
                if part.Name == "HumanoidRootPart" or part.Name:find("Torso") or part.Name == "Head" then
                    part.CanCollide = true
                end
            end
        end
    end
end

-- ====================================================================
-- 8. INVISIBLE (DESYNC) SUBSYSTEM
-- ====================================================================
local function getRootJointForInvis(character)
    if not character then return nil, nil end
    local hrp = character:FindFirstChild("HumanoidRootPart")
    local lowerTorso = character:FindFirstChild("LowerTorso")
    local torso = character:FindFirstChild("Torso")
    local mainTorso = lowerTorso or torso

    if not hrp or not mainTorso then return nil, nil end

    local joint = hrp:FindFirstChild("RootJoint")
        or (lowerTorso and lowerTorso:FindFirstChild("Root"))
        or hrp:FindFirstChild("Root")
        or (torso and torso:FindFirstChild("RootJoint"))

    if not joint then
        for _, desc in ipairs(character:GetDescendants()) do
            if desc:IsA("Motor6D") and (desc.Part0 == hrp or desc.Part1 == hrp) then
                joint = desc
                break
            end
        end
    end

    return joint, mainTorso
end

local function startInvisible(character)
    if isInvisible then return end
    local joint, mainTorso = getRootJointForInvis(character)
    if not joint or not mainTorso then
        notify("Invisible", "RootJoint missing.")
        return
    end

    isInvisible = true
    savedRootJoint = joint
    savedTorso = mainTorso

    mainTorso.Anchored = true
    savedRootJoint.Enabled = false

    for _, part in ipairs(character:GetDescendants()) do
        if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then
            part.Transparency = 0.5
        end
    end
end

local function stopInvisible(character)
    isInvisible = false

    if savedTorso and savedTorso.Parent then
        savedTorso.Anchored = false
        local hrp = character and character:FindFirstChild("HumanoidRootPart")
        if hrp then
            savedTorso.CFrame = hrp.CFrame
        end
    end

    if savedRootJoint and savedRootJoint.Parent then
        savedRootJoint.Enabled = true
    end

    local targetChar = character or (savedTorso and savedTorso.Parent)
    if targetChar then
        for _, part in ipairs(targetChar:GetDescendants()) do
            if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then
                part.Transparency = 0
            end
        end
    end

    savedRootJoint = nil
    savedTorso = nil
end


local activeHatReanims = {}
local clientVisualProps = {}

local function cleanupHatReanimation()
    for _, data in ipairs(activeHatReanims) do
        pcall(function()
            if data.Weld and data.Weld.Parent then data.Weld.Enabled = true end
            if data.AlignPos and data.AlignPos.Parent then data.AlignPos:Destroy() end
            if data.AlignOri and data.AlignOri.Parent then data.AlignOri:Destroy() end
            if data.Att0 and data.Att0.Parent then data.Att0:Destroy() end
            if data.Att1 and data.Att1.Parent then data.Att1:Destroy() end
            if data.Handle and data.Handle.Parent then data.Handle.AssemblyLinearVelocity = Vector3.zero end
        end)
    end
    table.clear(activeHatReanims)

    for _, prop in ipairs(clientVisualProps) do
        pcall(function() prop:Destroy() end)
    end
    table.clear(clientVisualProps)
end

local function getCharacterHats(character)
    local hats = {}
    if not character then return hats end
    for _, child in ipairs(character:GetChildren()) do
        if child:IsA("Accessory") then
            local handle = child:FindFirstChild("Handle")
            if handle and handle:IsA("BasePart") then
                table.insert(hats, { Accessory = child, Handle = handle })
            end
        end
    end
    return hats
end

local function createHatPhysicsReanim(handle, targetPart)
    if not handle or not targetPart then return nil end
    local weld = handle:FindFirstChildWhichIsA("Weld") or handle:FindFirstChildWhichIsA("ManualWeld")
    if weld then weld.Enabled = false end

    handle.CanCollide = false
    handle.Massless = true

    local att0 = Instance.new("Attachment")
    att0.Name = "FE_Att0"
    att0.Parent = handle

    local att1 = Instance.new("Attachment")
    att1.Name = "FE_Att1"
    att1.Parent = targetPart

    local alignPos = Instance.new("AlignPosition")
    alignPos.Name = "FE_Pos"
    alignPos.Mode = Enum.PositionAlignmentMode.TwoAttachment
    alignPos.Attachment0 = att0
    alignPos.Attachment1 = att1
    alignPos.RigidityEnabled = true
    alignPos.Responsiveness = 200
    alignPos.MaxForce = 9e9
    alignPos.Parent = handle

    local alignOri = Instance.new("AlignOrientation")
    alignOri.Name = "FE_Ori"
    alignOri.Mode = Enum.OrientationAlignmentMode.TwoAttachment
    alignOri.Attachment0 = att0
    alignOri.Attachment1 = att1
    alignOri.RigidityEnabled = true
    alignOri.Responsiveness = 200
    alignOri.MaxTorque = 9e9
    alignOri.Parent = handle

    local data = {
        Handle = handle,
        Weld = weld,
        Att0 = att0,
        Att1 = att1,
        AlignPos = alignPos,
        AlignOri = alignOri,
        TargetPart = targetPart
    }
    table.insert(activeHatReanims, data)
    return data
end

local function createClientProp(name, size, color, targetPart, offsetCF)
    local p = Instance.new("Part")
    p.Name = name
    p.Size = size
    p.Color = color
    p.Material = Enum.Material.SmoothPlastic
    p.CanCollide = false
    p.CanTouch = false
    p.CanQuery = false
    p.Massless = true
    p.Parent = targetPart

    local w = Instance.new("Weld")
    w.Part0 = targetPart
    w.Part1 = p
    w.C0 = offsetCF
    w.Parent = p

    table.insert(clientVisualProps, p)
    return p, w
end


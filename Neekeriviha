    isClickTpActive = false

    if uiSwitches.Fly then setPillVisual(uiSwitches.Fly.Pill, uiSwitches.Fly.Stroke, false) end
    if uiSwitches.ClickTP then setPillVisual(uiSwitches.ClickTP.Pill, uiSwitches.ClickTP.Stroke, false) end
    if uiSwitches.Fling then setPillVisual(uiSwitches.Fling.Pill, uiSwitches.Fling.Stroke, false) end
    if uiSwitches.Noclip then setPillVisual(uiSwitches.Noclip.Pill, uiSwitches.Noclip.Stroke, false) end
    if uiSwitches.Invisible then setPillVisual(uiSwitches.Invisible.Pill, uiSwitches.Invisible.Stroke, false) end

    setAnimationMode("Psycho")
    updateAnimPills("Psycho")
    startProceduralEngine(character)
end


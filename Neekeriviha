local isMinimized = false

toggleBtn.MouseButton1Click:Connect(function()
    mainFrame.Visible = not mainFrame.Visible
end)

closeBtn.MouseButton1Click:Connect(function()
    mainFrame.Visible = false
end)

minimizeBtn.MouseButton1Click:Connect(function()
    isMinimized = not isMinimized
    if isMinimized then
        mainFrame.Size = UDim2.new(0, 260, 0, 38)
        scrollFrame.Visible = false
        footerFrame.Visible = false
        minimizeBtn.Text = "+"
    else
        mainFrame.Size = UDim2.new(0, 260, 0, 360)
        scrollFrame.Visible = true
        footerFrame.Visible = true
        minimizeBtn.Text = "-"
    end
end)

-- ====================================================================
-- 14. INITIALIZATION & RESPAWN MANAGER
-- ====================================================================
local function init(character)
    stopFlying(character)
    stopFling(character)
    stopNoclip(character)
    stopInvisible(character)
    isClickTpActive = false

    -- Nollataan GUI-tilat visuaalisesti
    if uiButtons.Fly then setButtonVisual(uiButtons.Fly.Button, uiButtons.Fly.Stroke, false, "Fly [Active]", "Fly [Inactive]") end
    if uiButtons.ClickTP then setButtonVisual(uiButtons.ClickTP.Button, uiButtons.ClickTP.Stroke, false, "Click TP [Active]", "Click TP [Inactive]") end
    if uiButtons.Fling then setButtonVisual(uiButtons.Fling.Button, uiButtons.Fling.Stroke, false, "Fling [Active]", "Fling [Inactive]") end
    if uiButtons.Noclip then setButtonVisual(uiButtons.Noclip.Button, uiButtons.Noclip.Stroke, false, "Noclip [Active]", "Noclip [Inactive]") end
    if uiButtons.Invisible then setButtonVisual(uiButtons.Invisible.Button, uiButtons.Invisible.Stroke, false, "Invisible [Active]", "Invisible [Inactive]") end

    applyAnimations(character)
end

if LocalPlayer.Character then
    task.spawn(function()
        init(LocalPlayer.Character)
    end)
end

LocalPlayer.CharacterAdded:Connect(function(newCharacter)
    task.wait(0.3)
    init(newCharacter)
end)
